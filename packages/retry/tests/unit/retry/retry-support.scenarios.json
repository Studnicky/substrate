{
  "cases": [
    {
      "name": "retry-backoff-config-exponential",
      "description": "backoffStrategy config computes delayMs via BackoffStrategy.exponential across attempts",
      "shape": "backoff-config-exponential",
      "input": {
        "retry": {
          "backoffStrategy": {
            "baseDelayMs": 100,
            "strategy": "exponential"
          },
          "maxRetries": 2
        },
        "batch": { "failureCountBeforeSuccess": 2 },
        "errorMessage": "transient failure",
        "result": "recovered"
      },
      "expected": { "recordedDelays": [100, 200] }
    },
    {
      "name": "retry-backoff-config-default-delay",
      "description": "no backoffStrategy config leaves delayMs at 0",
      "shape": "backoff-config-default",
      "input": {
        "retry": {
          "maxRetries": 2
        },
        "batch": { "failureCountBeforeSuccess": 1 },
        "errorMessage": "transient failure",
        "result": "recovered"
      },
      "expected": { "recordedDelays": [0] }
    },
    {
      "name": "retry-backoff-config-override",
      "description": "subclass overriding onRetryScheduled without super bypasses backoffStrategy config entirely",
      "shape": "backoff-config-override",
      "input": {
        "retry": {
          "backoffStrategy": {
            "baseDelayMs": 100,
            "strategy": "exponential"
          },
          "maxRetries": 2
        },
        "batch": { "failureCountBeforeSuccess": 2 },
        "errorMessage": "transient failure",
        "result": "recovered"
      },
      "expected": { "overrideDelays": [0, 0] }
    },
    {
      "name": "retry-config-guard-bad-type",
      "description": "rejects an invalid config (bad maxRetries type) without constructing a classifier",
      "shape": "config-guard-bad-type",
      "input": { "retry": { "maxRetries": "not-a-number" } },
      "expected": { "result": false, "classifierCalls": 0 }
    },
    {
      "name": "retry-config-guard-unknown-key",
      "description": "rejects an invalid config (unknown key) without constructing a classifier",
      "shape": "config-guard-unknown-key",
      "input": { "retry": { "notARealKey": true } },
      "expected": { "result": false, "classifierCalls": 0 }
    },
    {
      "name": "retry-config-guard-valid",
      "description": "accepts a valid config without constructing a classifier",
      "shape": "config-guard-valid",
      "input": { "retry": { "maxRetries": 3 } },
      "expected": { "result": true, "classifierCalls": 0 }
    },
    {
      "name": "retry-backoff-strategy-non-object",
      "description": "rejects a non-object backoffStrategy config",
      "shape": "backoff-strategy-non-object",
      "input": { "retry": { "backoffStrategy": "bad", "maxRetries": 1 } },
      "expected": { "result": false }
    },
    {
      "name": "retry-backoff-strategy-missing-fn",
      "description": "rejects a backoffStrategy config without strategy",
      "shape": "backoff-strategy-missing-fn",
      "input": { "retry": { "backoffStrategy": { "baseDelayMs": 1 }, "maxRetries": 1 } },
      "expected": { "result": false }
    },
    {
      "name": "retry-backoff-strategy-bad-delay",
      "description": "rejects a backoffStrategy config with non-number baseDelayMs",
      "shape": "backoff-strategy-bad-delay",
      "input": { "retry": { "backoffStrategy": { "baseDelayMs": "bad", "strategy": "noop" }, "maxRetries": 1 } },
      "expected": { "result": false }
    },
    {
      "name": "retry-backoff-decorrelated-attempt-0-100",
      "description": "decorrelatedJitter attempt 0 baseDelay 100 returns 100",
      "shape": "decorrelated-jitter-0",
      "input": {
        "attempt": 0,
        "baseDelay": 100
      },
      "expected": { "delay": 100 }
    },
    {
      "name": "retry-backoff-decorrelated-attempt-0-50",
      "description": "decorrelatedJitter attempt 0 baseDelay 50 returns 50",
      "shape": "decorrelated-jitter-0",
      "input": {
        "attempt": 0,
        "baseDelay": 50
      },
      "expected": { "delay": 50 }
    },
    {
      "name": "retry-backoff-decorrelated-attempt-0-500",
      "description": "decorrelatedJitter attempt 0 baseDelay 500 returns 500",
      "shape": "decorrelated-jitter-0",
      "input": {
        "attempt": 0,
        "baseDelay": 500
      },
      "expected": { "delay": 500 }
    },
    {
      "name": "retry-backoff-decorrelated-lower-bound",
      "description": "decorrelatedJitter returns a value >= baseDelayMs for attempt > 0",
      "shape": "decorrelated-jitter-lower-bound",
      "input": {
        "baseDelay": 100,
        "batch": { "sampleCount": 200 }
      },
      "expected": { "minDelay": 100 }
    },
    {
      "name": "retry-backoff-decorrelated-upper-bound",
      "description": "decorrelatedJitter returns a value <= 32 * baseDelayMs (max cap)",
      "shape": "decorrelated-jitter-upper-bound",
      "input": {
        "baseDelay": 100,
        "batch": { "sampleCount": 420 }
      },
      "expected": { "maxDelay": 3200 }
    },
    {
      "name": "retry-backoff-decorrelated-varying",
      "description": "decorrelatedJitter produces varying results for the same attempt (randomized)",
      "shape": "decorrelated-jitter-varying",
      "input": {
        "attempt": 2,
        "baseDelay": 100,
        "batch": { "sampleCount": 30 }
      },
      "expected": { "distinctResultsGreaterThan": 1 }
    },
    {
      "name": "retry-entity-backoff-config",
      "description": "validates backoff configuration data",
      "shape": "entity-backoff-config",
      "input": { "value": { "baseDelayMs": 25 } },
      "expected": { "valid": true, "invalid": false }
    },
    {
      "name": "retry-entity-retry-context",
      "description": "validates retry context data",
      "shape": "entity-retry-context",
      "input": { "value": { "abort": false, "attemptNumber": 1, "delayMs": 25, "elapsedMs": 100 } },
      "expected": { "valid": true, "invalid": false }
    }
  ]
}
