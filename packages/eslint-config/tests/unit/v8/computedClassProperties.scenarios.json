      "name": "computed class field (PropertyDefinition) - flagged (regression: original selector matched object-literal Property nodes, never PropertyDefinition)"
    },
    {
      "code": "const Foo = class { [computedKey()] = 1; };",
      "errors": [
        {
          "messageId": "forbidden"
        }
      ],
      "name": "computed class field in a ClassExpression - flagged"
    },
    {
      "code": "class Foo { [computedMethodName()]() { return 1; } }",
      "errors": [
        {
          "messageId": "forbidden"
        }
      ],
      "name": "computed method name (MethodDefinition) - flagged"
