{
  "valid": [
    {
      "code": "class Foo { bar = 1; }",
      "name": "plain class field - not flagged"
    },
    {
      "code": "class Foo { bar() { return 1; } }",
      "name": "plain method - not flagged"
    },
    {
      "code": "class Foo { method() { return { [computedKey()]: 1 }; } }",
