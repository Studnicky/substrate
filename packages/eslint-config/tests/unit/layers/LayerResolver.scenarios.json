{
  "cases": [
    {
      "name": "resolves a path under sourceRoot/domain/... to \"domain\"",
      "operation": "layerForPath",
      "input": {
        "path": "/repo/src/domain/user/User.ts"
      },
      "expected": {
        "output": "domain"
      }
    },
    {
      "name": "resolves a path under an unconfigured segment to undefined",
      "operation": "layerForPath",
      "input": {
        "path": "/repo/src/utils/format.ts"
      },
      "expected": {
        "output": null
      }
    },
    {
      "name": "resolves a path not under sourceRoot at all to undefined",
      "operation": "layerForPath",
      "input": {
        "path": "/repo/scripts/build.ts"
      },
      "expected": {
        "output": null
      }
    },
    {
      "name": "resolves an alias-prefixed specifier via the alias map directly",
      "operation": "layerForImport",
      "input": {
        "specifier": "@domain/user",
        "importingFile": "/repo/src/application/service.ts"
      },
      "expected": {
        "output": "domain"
      }
    },
    {
      "name": "resolves a relative specifier via path resolution against the importing file directory",
      "operation": "layerForImport",
      "input": {
        "specifier": "../domain/foo",
        "importingFile": "/repo/src/application/service.ts"
      },
      "expected": {
        "output": "domain"
      }
    },
    {
      "name": "resolves a bare npm-style specifier to undefined",
      "operation": "layerForImport",
      "input": {
        "specifier": "lodash",
        "importingFile": "/repo/src/application/service.ts"
      },
      "expected": {
        "output": null
      }
    },
    {
      "name": "resolves a relative specifier that resolves outside sourceRoot to undefined",
      "operation": "layerForImport",
      "input": {
        "specifier": "../../scripts/build",
        "importingFile": "/repo/src/application/service.ts"
      },
      "expected": {
        "output": null
      }
    },
    {
      "name": "always allows same-layer imports",
      "operation": "canImport",
      "input": {
        "from": "application",
        "to": "application"
      },
      "expected": {
        "output": true
      }
    },
    {
      "name": "disallows domain -> application per the default matrix",
      "operation": "canImport",
      "input": {
        "from": "domain",
        "to": "application"
      },
      "expected": {
        "output": false
      }
    },
    {
      "name": "allows application -> domain per the default matrix",
      "operation": "canImport",
      "input": {
        "from": "application",
        "to": "domain"
      },
      "expected": {
        "output": true
      }
    },
    {
      "name": "allows infrastructure -> anything configured",
      "operation": "canImport",
      "input": {
        "from": "infrastructure",
        "to": "domain"
      },
      "expected": {
        "output": true
      }
    },
    {
      "name": "allows infrastructure -> anything configured",
      "operation": "canImport",
      "input": {
        "from": "infrastructure",
        "to": "adapters"
      },
      "expected": {
        "output": true
      }
    },
    {
      "name": "respects an allowedImports override that changes the default-matrix result",
      "operation": "canImport",
      "input": {
        "from": "domain",
        "to": "application",
        "options": {
          "allowedImports": {
            "domain": [
              "domain",
              "application"
            ]
          },
          "bindings": [
            { "kind": "module", "pattern": "@domain/", "layer": "domain" },
            { "kind": "module", "pattern": "@ports/", "layer": "ports" }
          ],
          "layers": [
            "domain",
            "ports",
            "application",
            "adapters",
            "infrastructure"
          ],
          "sourceRoot": "src"
        }
      },
      "expected": {
        "output": true
      }
    },
    {
      "name": "returns false for an unrecognized layer name",
      "operation": "canImport",
      "input": {
        "from": "domain",
        "to": "nonexistent"
      },
      "expected": {
        "output": false
      }
    },
    {
      "name": "D7: continues scanning past a non-layer occurrence of sourceRoot instead of giving up (vendored nested src)",
      "operation": "layerForPath",
      "input": {
        "path": "/repo/src/vendor/x/src/domain/Foo.ts"
      },
      "expected": {
        "output": "domain"
      }
    },
    {
      "name": "D7: still resolves to undefined when no occurrence of sourceRoot is followed by a configured layer",
      "operation": "layerForPath",
      "input": {
        "path": "/repo/src/vendor/x/src/utils/format.ts"
      },
      "expected": {
        "output": null
      }
    },
    {
      "name": "D7: default allow-matrix resolves by position, not literal name, so a renamed application-role layer can still import the renamed domain-role layer",
      "operation": "canImport",
      "input": {
        "from": "organisms",
        "to": "atoms",
        "options": {
          "layers": ["atoms", "molecules", "organisms", "templates", "pages"],
          "sourceRoot": "src"
        }
      },
      "expected": {
        "output": true
      }
    },
    {
      "name": "D7: default allow-matrix still denies a renamed application-role layer importing the renamed adapters-role layer",
      "operation": "canImport",
      "input": {
        "from": "organisms",
        "to": "templates",
        "options": {
          "layers": ["atoms", "molecules", "organisms", "templates", "pages"],
          "sourceRoot": "src"
        }
      },
      "expected": {
        "output": false
      }
    },
    {
      "name": "D7: the renamed infrastructure-role layer (last position) still imports every configured layer",
      "operation": "canImport",
      "input": {
        "from": "pages",
        "to": "atoms",
        "options": {
          "layers": ["atoms", "molecules", "organisms", "templates", "pages"],
          "sourceRoot": "src"
        }
      },
      "expected": {
        "output": true
      }
    },
    {
      "name": "D7: a renamed adapters-role layer can import the renamed ports-role layer per the positional matrix",
      "operation": "canImport",
      "input": {
        "from": "templates",
        "to": "molecules",
        "options": {
          "layers": ["atoms", "molecules", "organisms", "templates", "pages"],
          "sourceRoot": "src"
        }
      },
      "expected": {
        "output": true
      }
    },
    {
      "name": "'package' kind: segment after sourceRoot resolves through a package binding rather than being required to equal a layer name (substrate flat-monorepo shape)",
      "operation": "layerForPath",
      "input": {
        "path": "/repo/packages/retry/src/retry/Retry.ts",
        "options": {
          "bindings": [
            { "kind": "package", "pattern": "errors", "layer": "foundation" },
            { "kind": "package", "pattern": "retry", "layer": "coordinator" }
          ],
          "layers": ["foundation", "primitive", "capability", "coordinator"],
          "sourceRoot": "packages"
        }
      },
      "expected": {
        "output": "coordinator"
      }
    },
    {
      "name": "'package' kind: a package with no binding resolves to undefined, a silent pass",
      "operation": "layerForPath",
      "input": {
        "path": "/repo/packages/unmapped-package/src/index.ts",
        "options": {
          "bindings": [
            { "kind": "package", "pattern": "errors", "layer": "foundation" },
            { "kind": "package", "pattern": "retry", "layer": "coordinator" }
          ],
          "layers": ["foundation", "primitive", "capability", "coordinator"],
          "sourceRoot": "packages"
        }
      },
      "expected": {
        "output": null
      }
    },
    {
      "name": "'package' kind: a binding naming a layer absent from the configured layers array resolves to undefined, same as any other typo",
      "operation": "layerForPath",
      "input": {
        "path": "/repo/packages/retry/src/retry/Retry.ts",
        "options": {
          "bindings": [
            { "kind": "package", "pattern": "retry", "layer": "coordinator" }
          ],
          "layers": ["foundation", "primitive", "capability"],
          "sourceRoot": "packages"
        }
      },
      "expected": {
        "output": null
      }
    },
    {
      "name": "'package' kind D7: continues scanning past a non-bound occurrence of sourceRoot instead of giving up (vendored nested packages/ directory)",
      "operation": "layerForPath",
      "input": {
        "path": "/repo/packages/vendor-nested/packages/retry/src/retry/Retry.ts",
        "options": {
          "bindings": [
            { "kind": "package", "pattern": "errors", "layer": "foundation" },
            { "kind": "package", "pattern": "retry", "layer": "coordinator" }
          ],
          "layers": ["foundation", "primitive", "capability", "coordinator"],
          "sourceRoot": "packages"
        }
      },
      "expected": {
        "output": "coordinator"
      }
    },
    {
      "name": "'module' kind: a bare workspace specifier (not merely a path-alias prefix) resolves directly",
      "operation": "layerForImport",
      "input": {
        "specifier": "@studnicky/errors",
        "importingFile": "/repo/packages/retry/src/retry/Retry.ts",
        "options": {
          "bindings": [
            { "kind": "module", "pattern": "@studnicky/errors", "layer": "foundation" },
            { "kind": "package", "pattern": "retry", "layer": "coordinator" }
          ],
          "layers": ["foundation", "coordinator"],
          "sourceRoot": "packages"
        }
      },
      "expected": {
        "output": "foundation"
      }
    },
    {
      "name": "'dependency' kind: an external npm package resolves to its bound layer, making it constrainable by a boundary rule",
      "operation": "layerForImport",
      "input": {
        "specifier": "undici",
        "importingFile": "/repo/packages/fetch/src/index.ts",
        "options": {
          "bindings": [
            { "kind": "dependency", "pattern": "undici", "layer": "external" },
            { "kind": "package", "pattern": "fetch", "layer": "capability" }
          ],
          "layers": ["external", "capability"],
          "sourceRoot": "packages"
        }
      },
      "expected": {
        "output": "external"
      }
    },
    {
      "name": "'dependency' kind: an UNBOUND external specifier still resolves to undefined -- a silent pass, not a default deny",
      "operation": "layerForImport",
      "input": {
        "specifier": "zod",
        "importingFile": "/repo/packages/fetch/src/index.ts",
        "options": {
          "bindings": [
            { "kind": "dependency", "pattern": "undici", "layer": "external" },
            { "kind": "package", "pattern": "fetch", "layer": "capability" }
          ],
          "layers": ["external", "capability"],
          "sourceRoot": "packages"
        }
      },
      "expected": {
        "output": null
      }
    },
    {
      "name": "'builtin' kind: a bare Node builtin specifier resolves to the bound group layer",
      "operation": "layerForImport",
      "input": {
        "specifier": "fs",
        "importingFile": "/repo/packages/file-lock/src/index.ts",
        "options": {
          "bindings": [
            { "kind": "builtin", "layer": "external" }
          ],
          "layers": ["external", "coordinator"],
          "sourceRoot": "packages"
        }
      },
      "expected": {
        "output": "external"
      }
    },
    {
      "name": "'builtin' kind: the node:-prefixed spelling of the same builtin resolves to the SAME group layer, one binding covers both spellings",
      "operation": "layerForImport",
      "input": {
        "specifier": "node:fs",
        "importingFile": "/repo/packages/file-lock/src/index.ts",
        "options": {
          "bindings": [
            { "kind": "builtin", "layer": "external" }
          ],
          "layers": ["external", "coordinator"],
          "sourceRoot": "packages"
        }
      },
      "expected": {
        "output": "external"
      }
    },
    {
      "name": "'builtin' kind: a non-builtin specifier does not match the builtin group",
      "operation": "layerForImport",
      "input": {
        "specifier": "undici",
        "importingFile": "/repo/packages/file-lock/src/index.ts",
        "options": {
          "bindings": [
            { "kind": "builtin", "layer": "external" }
          ],
          "layers": ["external", "coordinator"],
          "sourceRoot": "packages"
        }
      },
      "expected": {
        "output": null
      }
    },
    {
      "name": "band taxonomy (allowedImports override): capability importing coordinator is UPWARD and forbidden",
      "operation": "canImport",
      "input": {
        "from": "capability",
        "to": "coordinator",
        "options": {
          "allowedImports": {
            "foundation": ["foundation"],
            "primitive": ["foundation", "primitive"],
            "capability": ["foundation", "primitive", "capability"],
            "coordinator": ["foundation", "primitive", "capability", "coordinator"]
          },
          "bindings": [],
          "layers": ["foundation", "primitive", "capability", "coordinator"],
          "sourceRoot": "packages"
        }
      },
      "expected": {
        "output": false
      }
    },
    {
      "name": "band taxonomy (allowedImports override): coordinator importing capability is DOWNWARD and allowed",
      "operation": "canImport",
      "input": {
        "from": "coordinator",
        "to": "capability",
        "options": {
          "allowedImports": {
            "foundation": ["foundation"],
            "primitive": ["foundation", "primitive"],
            "capability": ["foundation", "primitive", "capability"],
            "coordinator": ["foundation", "primitive", "capability", "coordinator"]
          },
          "bindings": [],
          "layers": ["foundation", "primitive", "capability", "coordinator"],
          "sourceRoot": "packages"
        }
      },
      "expected": {
        "output": true
      }
    }
  ]
}
