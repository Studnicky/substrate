{
  "cases": [
    {
      "name": "resolves a path under sourceRoot/domain/... to \"domain\"",
      "operation": "layerForPath",
      "input": {
        "path": "/repo/src/domain/user/User.ts"
      },
      "expected": {
        "output": "domain"
      }
    },
    {
      "name": "resolves a path under an unconfigured segment to undefined",
      "operation": "layerForPath",
      "input": {
        "path": "/repo/src/utils/format.ts"
      },
      "expected": {
        "output": null
      }
    },
    {
      "name": "resolves a path not under sourceRoot at all to undefined",
      "operation": "layerForPath",
      "input": {
        "path": "/repo/scripts/build.ts"
      },
      "expected": {
        "output": null
      }
    },
    {
      "name": "resolves an alias-prefixed specifier via the alias map directly",
      "operation": "layerForImport",
      "input": {
        "specifier": "@domain/user",
        "importingFile": "/repo/src/application/service.ts"
      },
      "expected": {
        "output": "domain"
      }
    },
    {
      "name": "resolves a relative specifier via path resolution against the importing file directory",
      "operation": "layerForImport",
      "input": {
        "specifier": "../domain/foo",
        "importingFile": "/repo/src/application/service.ts"
      },
      "expected": {
        "output": "domain"
      }
    },
    {
      "name": "resolves a bare npm-style specifier to undefined",
      "operation": "layerForImport",
      "input": {
        "specifier": "lodash",
        "importingFile": "/repo/src/application/service.ts"
      },
      "expected": {
        "output": null
      }
    },
    {
      "name": "resolves a relative specifier that resolves outside sourceRoot to undefined",
      "operation": "layerForImport",
      "input": {
        "specifier": "../../scripts/build",
        "importingFile": "/repo/src/application/service.ts"
      },
      "expected": {
        "output": null
      }
    },
    {
      "name": "always allows same-layer imports",
      "operation": "canImport",
      "input": {
        "from": "application",
        "to": "application"
      },
      "expected": {
        "output": true
      }
    },
    {
      "name": "disallows domain -> application per the default matrix",
      "operation": "canImport",
      "input": {
        "from": "domain",
        "to": "application"
      },
      "expected": {
        "output": false
      }
    },
    {
      "name": "allows application -> domain per the default matrix",
      "operation": "canImport",
      "input": {
        "from": "application",
        "to": "domain"
      },
      "expected": {
        "output": true
      }
    },
    {
      "name": "allows infrastructure -> anything configured",
      "operation": "canImport",
      "input": {
        "from": "infrastructure",
        "to": "domain"
      },
      "expected": {
        "output": true
      }
    },
    {
      "name": "allows infrastructure -> anything configured",
      "operation": "canImport",
      "input": {
        "from": "infrastructure",
        "to": "adapters"
      },
      "expected": {
        "output": true
      }
    },
    {
      "name": "respects an allowedImports override that changes the default-matrix result",
      "operation": "canImport",
      "input": {
        "from": "domain",
        "to": "application",
        "options": {
          "aliasPrefixes": {
            "@domain/": "domain",
            "@ports/": "ports"
          },
          "allowedImports": {
            "domain": [
              "domain",
              "application"
            ]
          },
          "layers": [
            "domain",
            "ports",
            "application",
            "adapters",
            "infrastructure"
          ],
          "sourceRoot": "src"
        }
      },
      "expected": {
        "output": true
      }
    },
    {
      "name": "returns false for an unrecognized layer name",
      "operation": "canImport",
      "input": {
        "from": "domain",
        "to": "nonexistent"
      },
      "expected": {
        "output": false
      }
    }
  ]
}
