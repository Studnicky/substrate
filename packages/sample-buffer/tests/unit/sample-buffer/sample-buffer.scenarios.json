{
  "cases": [
    {
      "name": "construction-large",
      "description": "creates buffer with large capacity, starts empty",
      "shape": "construction",
      "input": {
        "sampleBuffer": {
          "capacity": 100
        }
      },
      "expected": {
        "full": false,
        "length": 0
      }
    },
    {
      "name": "construction-small",
      "description": "creates buffer with small capacity, starts empty",
      "shape": "construction",
      "input": {
        "sampleBuffer": {
          "capacity": 10
        }
      },
      "expected": {
        "full": false,
        "length": 0
      }
    },
    {
      "name": "capacity-zero",
      "description": "rejects zero capacity",
      "shape": "capacity-error",
      "input": {
        "sampleBuffer": {
          "capacity": 0
        }
      },
      "expected": {
        "errorName": "SampleBufferError"
      }
    },
    {
      "name": "capacity-negative",
      "description": "rejects negative capacity",
      "shape": "capacity-error",
      "input": {
        "sampleBuffer": {
          "capacity": -1
        }
      },
      "expected": {
        "errorName": "SampleBufferError"
      }
    },
    {
      "name": "capacity-non-integer",
      "description": "rejects non-integer capacity",
      "shape": "capacity-error",
      "input": {
        "sampleBuffer": {
          "capacity": 1.5
        }
      },
      "expected": {
        "errorName": "SampleBufferError"
      }
    },
    {
      "name": "invalid-multi-error",
      "description": "rejects options with multiple validation errors",
      "shape": "invalid-multi-error",
      "input": {
        "sampleBuffer": {
          "capacity": 0,
          "extra": true
        }
      },
      "expected": {
        "errorName": "SampleBufferError",
        "messageIncludes": [
          "must NOT have additional properties",
          "/capacity must be >= 1"
        ]
      }
    },
    {
      "name": "is-full-one",
      "description": "isFull is false after one push into capacity-3 buffer",
      "shape": "is-full",
      "input": {
        "sampleBuffer": {
          "capacity": 3
        },
        "pushes": [
          1
        ]
      },
      "expected": {
        "full": false
      }
    },
    {
      "name": "is-full-two",
      "description": "isFull is false after two pushes into capacity-3 buffer",
      "shape": "is-full",
      "input": {
        "sampleBuffer": {
          "capacity": 3
        },
        "pushes": [
          1,
          2
        ]
      },
      "expected": {
        "full": false
      }
    },
    {
      "name": "is-full-three",
      "description": "isFull is true after filling capacity-3 buffer",
      "shape": "is-full",
      "input": {
        "sampleBuffer": {
          "capacity": 3
        },
        "pushes": [
          1,
          2,
          3
        ]
      },
      "expected": {
        "full": true
      }
    },
