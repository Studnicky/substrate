{
  "name": "@studnicky/clock",
  "version": "15.0.2",
  "description": "Wall-clock and monotonic time primitives with injectable providers for deterministic testing",
  "keywords": [
    "clock",
    "deterministic",
    "hrtime",
    "testing",
    "time",
    "virtual-clock"
  ],
  "homepage": "https://studnicky.github.io/substrate/packages/clock",
  "bugs": {
    "url": "https://github.com/Studnicky/substrate/issues"
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/clock"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./monotonic-now": {
      "types": "./dist/monotonic-now/index.d.ts",
      "import": "./dist/monotonic-now/index.js"
    },
    "./monotonic-now/interfaces": {
      "types": "./dist/monotonic-now/interfaces/index.d.ts",
      "import": "./dist/monotonic-now/interfaces/index.js"
    },
    "./timing": {
      "types": "./dist/timing/index.d.ts",
      "import": "./dist/timing/index.js"
    },
    "./timing/entities": {
      "types": "./dist/timing/entities/index.d.ts",
      "import": "./dist/timing/entities/index.js"
    },
    "./timing/interfaces": {
      "types": "./dist/timing/interfaces/index.d.ts",
      "import": "./dist/timing/interfaces/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist coverage test-reports tsconfig.tsbuildinfo",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "tsx ../../scripts/test-suite.ts all --package ."
  },
  "dependencies": {
    "@studnicky/config": "workspace:*",
    "@studnicky/entity": "workspace:*",
    "@studnicky/errors": "workspace:*",
    "@studnicky/json": "workspace:*",
    "@studnicky/types": "workspace:*"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
