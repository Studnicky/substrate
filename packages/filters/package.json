{
  "name": "@studnicky/filters",
  "version": "15.1.1",
  "description": "Composable declarative filtering primitives for @studnicky/substrate",
  "keywords": [
    "composition",
    "filter",
    "predicate",
    "validation"
  ],
  "homepage": "https://studnicky.github.io/substrate/packages/filters",
  "bugs": {
    "url": "https://github.com/Studnicky/substrate/issues"
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/filters"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#runtime": {
      "browser": "./dist/runtime/browser/index.js",
      "node": "./dist/runtime/node/index.js",
      "default": "./dist/runtime/node/index.js"
    }
  },
  "exports": {
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./matching": {
      "types": "./dist/matching/index.d.ts",
      "import": "./dist/matching/index.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.js"
    },
    "./facets": {
      "types": "./dist/facets/index.d.ts",
      "import": "./dist/facets/index.js"
    },
    "./facets/types": {
      "types": "./dist/facets/types/index.d.ts",
      "import": "./dist/facets/types/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist coverage test-reports tsconfig.tsbuildinfo",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "tsx ../../scripts/test-suite.ts all --package ."
  },
  "dependencies": {
    "@studnicky/entity": "workspace:*",
    "@studnicky/errors": "workspace:*",
    "@studnicky/json": "workspace:*",
    "@studnicky/matching": "workspace:*",
    "@studnicky/types": "workspace:*",
    "@types/json-schema": "^7.0.15"
  },
  "engines": {
    "node": ">=24.12.0",
    "npm": ">=11.0.0"
  }
}
