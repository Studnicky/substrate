{
  "name": "@studnicky/throttle",
  "version": "15.0.0",
  "description": "Generic async operation throttle with sliding window concurrency control",
  "keywords": [
    "async",
    "concurrency",
    "nodejs",
    "rate-limiting",
    "sliding-window",
    "throttle",
    "typescript"
  ],
  "homepage": "https://studnicky.github.io/substrate/packages/throttle",
  "bugs": {
    "url": "https://github.com/Studnicky/substrate/issues"
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/throttle"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist coverage test-reports tsconfig.tsbuildinfo",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "tsx ../../scripts/test-suite.ts all --package ."
  },
  "dependencies": {
    "@studnicky/concurrency": "workspace:*",
    "@studnicky/config": "workspace:*",
    "@studnicky/entity": "workspace:*",
    "@studnicky/errors": "workspace:*",
    "@studnicky/fsm": "workspace:*",
    "@studnicky/sample-buffer": "workspace:*",
    "@studnicky/signal": "workspace:*",
    "@studnicky/types": "workspace:*"
  },
  "devDependencies": {
    "@studnicky/batch": "workspace:*",
    "@studnicky/clock": "workspace:*",
    "@studnicky/example-smoke-kit": "workspace:*",
    "@studnicky/resilience": "workspace:*",
    "@studnicky/retry": "workspace:*",
    "@studnicky/scenario-kit": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
