    {
      "name": "adaptive-scales-up",
      "description": "Throttle scales adaptive concurrency upward when observed latency is below target",
      "shape": "adaptive-scales-up",
      "input": {
        "batch": {
          "itemCount": 10,
          "maxConcurrent": 1
        },
        "clock": {
          "operationDurationMs": 1,
          "operationSpacingMs": 20,
          "startMs": 0
        },
        "throttle": {
          "adaptive": {
            "adjustmentInterval": 100,
            "enabled": true,
            "maxConcurrency": 4,
            "minConcurrency": 1,
            "sampleWindow": 10,
            "scaleDownThreshold": 1.5,
            "scaleUpThreshold": 0.8,
            "stepSize": 1,
            "targetLatencyMs": 100
          },
          "concurrencyLimit": 2
        }
      },
      "expected": {
        "adjustmentDirection": "up",
        "concurrencyLimit": 3
      }
    },
    {
      "name": "adaptive-scales-down",
      "description": "Throttle scales adaptive concurrency downward when observed latency is above target",
