{
  "cases": [
    {
      "name": "valid-all-fields",
      "description": "Throttle accepts valid adaptive config with all required fields",
      "shape": "valid-all-fields",
      "input": {
        "throttle": {
          "adaptive": {
            "adjustmentInterval": 1000,
            "enabled": true,
            "maxConcurrency": 50,
            "minConcurrency": 5,
            "sampleWindow": 100,
            "scaleDownThreshold": 1.5,
            "scaleUpThreshold": 0.5,
            "stepSize": 2,
            "targetLatencyMs": 200
          },
          "concurrencyLimit": 10
        }
      },
      "expected": {
        "concurrencyLimit": 10,
        "adaptive": {
          "enabled": true,
          "minConcurrency": 5,
          "maxConcurrency": 50,
          "targetLatencyMs": 200
        }
      }
    },
    {
      "name": "valid-required-fields",
      "description": "Throttle accepts adaptive config with only required fields and applies defaults",
      "shape": "valid-required-fields",
      "input": {
        "throttle": {
          "adaptive": {
            "enabled": true,
            "targetLatencyMs": 200
          },
          "concurrencyLimit": 10
        }
      },
      "expected": {
        "minConcurrency": 1,
        "maxConcurrency": 100
      }
    },
    {
      "name": "valid-disabled-no-extra-fields",
      "description": "Throttle accepts disabled adaptive config without other fields",
      "shape": "valid-disabled-no-extra-fields",
      "input": {
        "throttle": {
          "adaptive": {
            "enabled": false
          },
          "concurrencyLimit": 10
        }
      },
      "expected": {
        "enabled": false
      }
    },
    {
      "name": "valid-disabled-defaulted-config",
      "description": "Throttle validates the fully defaulted disabled adaptive configuration",
      "shape": "valid-disabled-defaulted-config",
      "input": {
        "disabledConfig": {
          "adjustmentInterval": 1000,
          "enabled": false,
          "maxConcurrency": 100,
          "minConcurrency": 1,
          "sampleWindow": 100,
          "scaleDownThreshold": 1.5,
          "scaleUpThreshold": 0.8,
          "stepSize": 1,
          "targetLatencyMs": 0
        },
        "throttle": {
          "concurrencyLimit": 10
        }
      },
      "expected": {
        "validated": true,
        "throttleValidated": true,
        "rejectEnabledTrue": true
      }
    },
