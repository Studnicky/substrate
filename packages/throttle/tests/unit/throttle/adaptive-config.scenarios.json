    {
      "name": "adaptive-adjust-hook-throws",
      "description": "Throttle rejects when adaptive adjustment hook throws during scaling",
      "shape": "adaptive-adjust-hook-throws",
      "input": {
        "batch": {
          "itemCount": 10,
          "maxConcurrent": 1
        },
        "clock": {
          "operationDurationMs": 1,
          "operationSpacingMs": 20,
          "startMs": 0
        },
        "throttle": {
          "adaptive": {
            "adjustmentInterval": 100,
            "enabled": true,
            "maxConcurrency": 4,
            "minConcurrency": 1,
            "sampleWindow": 10,
            "scaleDownThreshold": 1.5,
            "scaleUpThreshold": 0.8,
            "stepSize": 1,
            "targetLatencyMs": 100
          },
          "concurrencyLimit": 2
        },
        "hookErrorMessage": "adaptive adjust boom"
      },
      "expected": {
        "error": "HookInvocationError",
        "hookErrorMessage": "adaptive adjust boom"
      }
