{
  "name": "@studnicky/cache",
  "version": "15.2.0",
  "description": "In-process LRU + TTL cache and keyed single-flight memoization",
  "keywords": [
    "cache",
    "lru",
    "lru-cache",
    "memoize",
    "single-flight",
    "ttl",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/Studnicky/substrate/issues"
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/cache"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#runtime": {
      "browser": "./dist/runtime/browser/index.js",
      "node": "./dist/runtime/node/index.js",
      "default": "./dist/runtime/node/index.js"
    }
  },
  "exports": {
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memoize": {
      "types": "./dist/memoize/index.d.ts",
      "import": "./dist/memoize/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "tsx ../../scripts/test-suite.ts all --package ."
  },
  "dependencies": {
    "@studnicky/clock": "workspace:*",
    "@studnicky/concurrency": "workspace:*",
    "@studnicky/entity": "workspace:*",
    "@studnicky/errors": "workspace:*",
    "@studnicky/json": "workspace:*",
    "@studnicky/types": "workspace:*"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=24.0.0"
  }
}
