{
  "name": "@studnicky/resilience",
  "version": "15.0.0",
  "description": "Async resilience primitives: CircuitBreaker, TokenBucket, KeyedRateLimiter, SlidingWindowLimiter, DeadLetterQueue",
  "keywords": [
    "circuit-breaker",
    "dead-letter-queue",
    "rate-limiter",
    "resilience",
    "sliding-window",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/Studnicky/substrate/issues"
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/resilience"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./keyed": {
      "types": "./dist/keyed/index.d.ts",
      "import": "./dist/keyed/index.js"
    },
    "./keyed/entities": {
      "types": "./dist/keyed/entities/index.d.ts",
      "import": "./dist/keyed/entities/index.js"
    },
    "./keyed/interfaces": {
      "types": "./dist/keyed/interfaces/index.d.ts",
      "import": "./dist/keyed/interfaces/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "test": "tsx ../../scripts/test-suite.ts all --package ."
  },
  "dependencies": {
    "@studnicky/cache": "workspace:*",
    "@studnicky/circular-buffer": "workspace:*",
    "@studnicky/entity": "workspace:*",
    "@studnicky/errors": "workspace:*",
    "@studnicky/fsm": "workspace:*",
    "@studnicky/scheduler": "workspace:*",
    "@studnicky/signal": "workspace:*",
    "@studnicky/types": "workspace:*"
  },
  "devDependencies": {
    "@studnicky/example-smoke-kit": "workspace:*",
    "@studnicky/scenario-kit": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
