      "input": {
        "resilience": {
          "failureThreshold": 0,
          "resetTimeoutMs": 100
        }
      },
      "expected": {
        "throws": "ResilienceConfigError"
      }
    },
    {
      "name": "resilience-circuitbreaker-invalid-reset-timeout",
      "description": "CircuitBreaker rejects resetTimeoutMs < 0",
      "shape": "cb-invalid-reset-timeout",
      "input": {
        "resilience": {
          "failureThreshold": 1,
          "resetTimeoutMs": -1
        }
      },
      "expected": {
        "throws": "ResilienceConfigError"
      }
    },
    {
      "name": "resilience-circuitbreaker-starts-closed",
