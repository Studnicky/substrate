          "states": [
            "closed",
            "halfOpen",
            "open",
            "half-open"
          ]
        }
      },
      "expected": {
        "validStates": [
          "closed",
          "halfOpen",
          "open"
        ],
        "invalidState": "half-open"
      }
    },
    {
