{
  "cases": [
    {
      "name": "json-clone-deep-number",
      "description": "Clone.deep clones number by value",
      "shape": "clone-deep-number",
      "input": {
        "json": {
          "value": 42
        }
      },
      "expected": {
        "cloned": 42
      }
    },
    {
      "name": "json-clone-deep-string",
      "description": "Clone.deep clones string by value",
      "shape": "clone-deep-string",
      "input": {
        "json": {
          "value": "hello"
        }
      },
      "expected": {
        "cloned": "hello"
      }
    },
    {
      "name": "json-clone-deep-null",
      "description": "Clone.deep clones null by value",
      "shape": "clone-deep-null",
      "input": {
        "json": {
          "value": null
        }
      },
      "expected": {
        "cloned": null
      }
    },
    {
      "name": "json-clone-deep-array",
      "description": "Clone.deep clones arrays without sharing references",
      "shape": "clone-deep-array",
      "input": {
        "json": {
          "value": [
            1,
            [
              2,
              3
            ],
            {
              "a": 4
            }
          ]
        }
      },
      "expected": {
        "cloned": [
          1,
          [
            2,
            3
          ],
          {
            "a": 4
          }
        ],
        "distinct": true
      }
    },
    {
      "name": "json-clone-deep-nested-object",
      "description": "Clone.deep clones nested objects",
      "shape": "clone-deep-nested-object",
      "input": {
        "json": {
          "value": {
            "a": 1,
            "b": {
              "c": 2
            }
          }
        }
      },
      "expected": {
        "cloned": {
          "a": 1,
          "b": {
            "c": 2
          }
        },
        "distinct": true
      }
    },
    {
      "name": "json-clone-deep-map",
      "description": "Clone.deep clones JSON map descriptors deeply",
      "shape": "clone-deep-map",
      "input": {
        "json": {
          "value": {
            "__shape": "map",
            "entries": [
              [
                "key",
                {
                  "value": 1
                }
              ]
            ]
          }
        }
      },
      "expected": {
        "distinct": true,
        "size": 1
      }
    },
    {
      "name": "json-clone-deep-set",
      "description": "Clone.deep clones JSON set descriptors",
      "shape": "clone-deep-set",
      "input": {
        "json": {
          "value": {
            "__shape": "set",
            "values": [
              1,
              2,
              3
            ]
          }
        }
      },
      "expected": {
        "distinct": true,
        "has": [
          1,
          2,
          3
        ]
      }
    },
    {
      "name": "json-clone-deep-date",
      "description": "Clone.deep preserves date text values",
      "shape": "clone-deep-date",
      "input": {
        "json": {
          "value": "2024-06-01"
        }
      },
      "expected": {
        "cloned": "2024-06-01"
      }
    },
    {
      "name": "json-clone-deep-isolation",
      "description": "Clone.deep mutations to the clone do not affect the original",
      "shape": "clone-deep-isolation",
      "input": {
        "json": {
          "value": {
            "a": 1,
            "b": {
              "c": 2
            }
          }
        }
      },
      "expected": {
        "originalUnchanged": true
      }
    },
    {
      "name": "json-clone-shallow",
      "description": "Clone.shallow preserves nested references",
      "shape": "clone-shallow",
      "input": {
        "json": {
          "value": {
            "a": 1,
            "b": {
              "c": 2
            }
          }
        }
      },
      "expected": {
        "nestedShared": true
      }
    },
    {
      "name": "json-clone-subclass-root",
      "description": "Clone subclass override tags the root object",
      "shape": "clone-subclass-root",
      "input": {
        "json": {
          "value": {
            "a": 1
          }
        }
      },
      "expected": {
        "tagged": true
      }
    },
    {
      "name": "json-clone-subclass-nested",
      "description": "Clone subclass override propagates through nested objects",
      "shape": "clone-subclass-nested",
      "input": {
        "json": {
          "value": {
            "a": 1,
            "nested": {
              "b": 2
            }
          }
        }
      },
      "expected": {
        "tagged": true,
        "nestedTagged": true
      }
    },
    {
      "name": "json-clone-subclass-base",
      "description": "base Clone.deep ignores subclass override",
      "shape": "clone-subclass-base",
      "input": {
        "json": {
          "value": {
            "a": 1,
            "nested": {
              "b": 2
            }
          }
        }
      },
      "expected": {
        "tagged": false
      }
    },
    {
      "name": "json-data-deepequal-true",
      "description": "Predicates.areDeeplyEqual accepts identical primitives and structurally-equal compound values",
      "shape": "data-deepequal-true",
      "input": {
        "json": {
          "primitives": [
            1,
            "a",
            true,
            null
          ],
          "pairs": [
            {
              "left": {
                "a": 1,
                "b": 2
              },
              "right": {
                "a": 1,
                "b": 2
              }
            },
            {
              "left": [
                1,
                [
                  2,
                  3
                ],
                {
                  "x": 4
                }
              ],
              "right": [
                1,
                [
                  2,
                  3
                ],
                {
                  "x": 4
                }
              ]
            },
            {
              "left": {
                "nested": {
                  "deep": {
                    "value": [
                      1,
                      {
                        "y": 2
                      }
                    ]
                  }
                }
              },
              "right": {
                "nested": {
                  "deep": {
                    "value": [
                      1,
                      {
                        "y": 2
                      }
                    ]
                  }
                }
              }
            }
          ]
        }
      },
      "expected": {
        "result": true
      }
    },
    {
      "name": "json-data-deepequal-false",
      "description": "Predicates.areDeeplyEqual rejects different primitives",
      "shape": "data-deepequal-false",
      "input": {
        "json": {
          "values": [
            1,
            2,
            "a",
            "b",
            null,
            null
          ]
        }
      },
      "expected": {
        "result": false
      }
    },
    {
      "name": "json-data-deepequal-special",
      "description": "Predicates.areDeeplyEqual handles arrays, objects, dates, regexps, sets, maps, and mixed types",
      "shape": "data-deepequal-special",
      "input": {
        "json": {
          "pairs": [
            {
              "shape": "nan",
              "left": null,
              "right": null,
              "equal": true
            },
            {
              "shape": "array",
              "left": [
                1,
                2,
                3
              ],
              "right": [
                1,
                2,
                3
              ],
              "equal": true
            },
            {
              "shape": "array",
              "left": [
                1,
                2
              ],
              "right": [
                1,
                2,
                3
              ],
              "equal": false
            },
            {
              "shape": "object",
              "left": {
                "a": {
                  "b": 1
                }
              },
              "right": {
                "a": {
                  "b": 1
                }
              },
              "equal": true
            },
            {
              "shape": "object",
              "left": {
                "a": {
                  "b": 1
                }
              },
              "right": {
                "a": {
                  "b": 2
                }
              },
              "equal": false
            },
            {
              "shape": "date",
              "left": "2024-01-01",
              "right": "2024-01-01",
              "equal": true
            },
            {
              "shape": "regexp",
              "left": "abc",
              "right": "def",
              "equal": false
            },
            {
              "shape": "set",
              "left": [
                1,
                2,
                3
              ],
              "right": [
                1,
                2,
                3
              ],
              "equal": true
            },
            {
              "shape": "map",
              "left": [
                [
                  "a",
                  1
                ]
              ],
              "right": [
                [
                  "a",
                  1
                ]
              ],
              "equal": true
            },
            {
              "shape": "mixed",
              "left": [],
              "right": {},
              "equal": false
            }
          ]
        }
      },
      "expected": {
        "result": true
      }
    },
    {
      "name": "json-data-plain-object",
      "description": "Predicates.isPlainObject recognizes plain objects and rejects non-plain values",
      "shape": "data-plain-object",
      "input": {
        "json": {
          "values": [
            "plain",
            "array",
            "date"
          ]
        }
      },
      "expected": {
        "plain": true,
        "array": false,
        "date": false
      }
    },
    {
      "name": "json-data-record",
      "description": "Predicates.isRecord recognizes objects and maps while rejecting non-records",
      "shape": "data-record",
      "input": {
        "json": {
          "values": [
            "object",
            "map",
            "array",
            "null"
          ]
        }
      },
      "expected": {
        "object": true,
        "map": true,
        "array": false,
        "null": false
      }
    },
    {
      "name": "json-data-cycle",
      "description": "Predicates.hasCycle detects cyclic and acyclic structures",
      "shape": "data-cycle",
      "input": {
        "json": {
          "values": [
            "acyclic",
            "object-cycle",
            "array-cycle"
          ]
        }
      },
      "expected": {
        "acyclic": false,
        "objectCycle": true,
        "arrayCycle": true
      }
    },
    {
      "name": "json-data-deepequal-negative-branches",
      "description": "Predicates.areDeeplyEqual rejects unequal JSON arrays and objects",
      "shape": "data-deepequal-negative-branches",
      "input": {
        "json": {
          "checks": [
            "array-size",
            "array-value",
            "object-size",
            "object-missing"
          ]
        }
      },
      "expected": {
        "allNegativeChecksFail": true
      }
    },
    {
      "name": "json-frozen-flat",
      "description": "Frozen.deepFreeze freezes a flat object",
      "shape": "frozen-flat",
      "input": {
        "json": {
          "value": {
            "a": 1,
            "b": 2
          }
        }
      },
      "expected": {
        "frozen": true
      }
    },
    {
      "name": "json-frozen-nested",
      "description": "Frozen.deepFreeze deeply freezes nested objects and arrays",
      "shape": "frozen-nested",
      "input": {
        "json": {
          "value": {
            "a": 1,
            "b": {
              "c": 3
            }
          }
        }
      },
      "expected": {
        "frozen": true,
        "nestedFrozen": true
      }
    },
    {
      "name": "json-frozen-reference",
      "description": "Frozen.deepFreeze returns the same reference",
      "shape": "frozen-reference",
      "input": {
        "json": {
          "value": {
            "a": 1
          }
        }
      },
      "expected": {
        "sameReference": true
      }
    },
    {
      "name": "json-frozen-cycle",
      "description": "Frozen.deepFreeze handles circular references",
      "shape": "frozen-cycle",
      "input": {
        "json": {
          "value": {
            "a": 1,
            "self": "cycle"
          }
        }
      },
      "expected": {
        "noThrow": true
      }
    },
    {
      "name": "json-frozen-primitives",
      "description": "Frozen.deepFreeze passes through primitives unchanged",
      "shape": "frozen-primitives",
      "input": {
        "json": {
          "values": [
            42,
            "hello",
            null
          ]
        }
      },
      "expected": {
        "passthrough": true
      }
    },
    {
      "name": "json-frozen-map-set",
      "description": "Frozen.deepFreeze preserves read access while blocking mutation",
      "shape": "frozen-map-set",
      "input": {
        "json": {
          "map": {
            "entries": [
              [
                "a",
                1
              ]
            ]
          },
          "set": {
            "values": [
              "a"
            ]
          }
        }
      },
      "expected": {
        "mutationBlocked": true
      }
    },
    {
      "name": "json-frozen-map-values",
      "description": "Frozen.deepFreeze deeply freezes values reachable from a Map",
      "shape": "frozen-map-values",
      "input": {
        "json": {
          "map": {
            "entries": [
              [
                "a",
                {
                  "nested": 1
                }
              ]
            ]
          }
        }
      },
      "expected": {
        "nestedFrozen": true
      }
    },
    {
      "name": "json-frozen-set-values",
      "description": "Frozen.deepFreeze deeply freezes values reachable from a Set",
      "shape": "frozen-set-values",
      "input": {
        "json": {
          "setValues": [
            {
              "nested": 1
            }
          ]
        }
      },
      "expected": {
        "nestedFrozen": true,
        "size": 1
      }
    },
    {
      "name": "json-frozen-subclass-skip",
      "description": "Frozen subclasses can skip freezing selected object shapes while still freezing children",
      "shape": "frozen-subclass-skip",
      "input": {
        "json": {
          "value": {
            "child": {
              "frozen": true
            },
            "mutable": true
          }
        }
      },
      "expected": {
        "childFrozen": true,
        "rootFrozen": false
      }
    },
    {
      "name": "json-merge-primitives",
      "description": "Merge.deep handles primitive, object, array, and atomic overlay cases",
      "shape": "merge-primitives",
      "input": {
        "json": {
          "left": 1,
          "right": 2
        }
      },
      "expected": {
        "merged": 2
      }
    },
    {
      "name": "json-merge-isolation",
      "description": "Merge.deep isolates inputs and outputs from later mutation",
      "shape": "merge-isolation",
      "input": {
        "json": {
          "left": {
            "baseOnly": {
              "count": 1
            },
            "items": [
              {
                "id": 1
              }
            ]
          },
          "right": {
            "overlayOnly": {
              "count": 2
            },
            "items": [
              {
                "id": 2
              }
            ]
          }
        }
      },
      "expected": {
        "isolated": true
      }
    },
    {
      "name": "json-merge-hidden-class",
      "description": "Merge.deep preserves a canonical key write order regardless of input insertion order",
      "shape": "merge-hidden-class",
      "input": {
        "json": {
          "first": {
            "left": {
              "b": 1,
              "a": 2
            },
            "right": {
              "c": 3
            }
          },
          "second": {
            "left": {
              "a": 10,
              "b": 20
            },
            "right": {
              "c": 30
            }
          }
        }
      },
      "expected": {
        "keyOrder": [
          "a",
          "b",
          "c"
        ],
        "stableShape": true
      }
    },
    {
      "name": "json-sort-functions",
      "description": "Sort comparators handle natural and length-based ordering",
      "shape": "sort-functions",
      "input": {
        "json": {
          "values": [
            3,
            1,
            2
          ]
        }
      },
      "expected": {
        "ascending": [
          1,
          2,
          3
        ],
        "descending": [
          3,
          2,
          1
        ]
      }
    },
    {
      "name": "json-entities-core",
      "description": "JSON internal entities validate their core payloads",
      "shape": "entities-core",
      "input": {
        "json": {
          "entities": [
            {
              "id": "a"
            },
            {
              "id": "b"
            }
          ]
        }
      },
      "expected": {
        "ids": [
          "a",
          "b"
        ]
      }
    }
  ]
}
