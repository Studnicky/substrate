{
  "name": "@studnicky/worker-pool",
  "version": "13.0.1",
  "description": "Bounded node:worker_threads pool that fans work items across workers with a typed message envelope and per-task timeout",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./lease": {
      "types": "./dist/lease/index.d.ts",
      "import": "./dist/lease/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist coverage test-reports tsconfig.tsbuildinfo",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "node ../../scripts/test-suite.mjs all --package ."
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/worker-pool"
  },
  "bugs": {
    "url": "https://github.com/Studnicky/substrate/issues"
  },
  "homepage": "https://studnicky.github.io/substrate/packages/worker-pool",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "keywords": [
    "worker",
    "worker_threads",
    "pool",
    "concurrency",
    "typescript",
    "nodejs"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@studnicky/batch": "workspace:*",
    "@studnicky/concurrency": "workspace:*",
    "@studnicky/errors": "workspace:*",
    "@studnicky/entity": "workspace:*",
    "@studnicky/fsm": "workspace:*",
    "@studnicky/signal": "workspace:*",
    "@studnicky/system": "workspace:*",
    "@studnicky/types": "workspace:*",
    "json-schema-to-ts": "^3.1.1"
  }
}
