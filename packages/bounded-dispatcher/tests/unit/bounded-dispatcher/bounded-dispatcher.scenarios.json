{
  "cases": [
    {
      "name": "bounded-dispatcher-dispatch-success",
      "description": "publishes start then success for a resolving fn",
      "shape": "dispatch-success",
      "input": {
        "dispatcher": {
          "bus": { "shape": "default" },
          "options": {},
          "scheduler": { "shape": "default" }
        },
        "result": "ok"
      },
      "expected": {
        "result": "ok",
        "received": [
          { "phase": "start" },
          { "phase": "success", "result": "ok" }
        ]
      }
    },
    {
      "name": "bounded-dispatcher-dispatch-error",
      "description": "publishes start then error for a rejecting fn, and rethrows",
      "shape": "dispatch-error",
      "input": {
        "dispatcher": {
          "bus": { "shape": "default" },
          "options": {},
          "scheduler": { "shape": "default" }
        },
        "errorMessage": "boom"
      },
      "expected": {
        "hookErrorCount": 0,
        "receivedPhases": ["start", "error"],
        "errorMessage": "boom"
      }
    },
    {
      "name": "bounded-dispatcher-dispatch-concurrency-bound",
      "description": "never runs more than permits fn bodies concurrently",
      "shape": "dispatch-concurrency-bound",
      "input": {
        "dispatcher": {
          "bus": { "shape": "default" },
          "options": { "permits": 2 },
          "scheduler": { "shape": "default" }
        },
        "batch": { "labels": ["a", "b", "c", "d", "e"] }
      },
      "expected": { "maxConcurrentObserved": 2, "results": ["done-a", "done-b", "done-c", "done-d", "done-e"] }
    },
    {
      "name": "bounded-dispatcher-dispatch-serializes",
      "description": "serializes fn bodies entirely when permits is 1",
      "shape": "dispatch-serializes",
      "input": {
        "dispatcher": {
          "bus": { "shape": "default" },
          "options": { "permits": 1 },
          "scheduler": { "shape": "default" }
        },
        "batch": { "taskCount": 3 }
      },
      "expected": { "maxConcurrentObserved": 1 }
    },
    {
      "name": "bounded-dispatcher-backpressure-isolation",
      "description": "runs permits fn bodies concurrently even while the dispatch subscriber is stalled",
      "shape": "backpressure-isolation",
      "input": {
        "dispatcher": {
          "bus": { "shape": "options", "options": { "highWaterMark": 1 } },
          "options": { "permits": 3 },
          "scheduler": { "shape": "default" }
        },
        "batch": { "taskCount": 3 }
      },
      "expected": { "releaserCount": 3, "maxConcurrentObserved": 3 }
    },
    {
      "name": "bounded-dispatcher-reject-start-publication",
      "description": "records a rejected start publication and retains the work result",
      "shape": "reject-start-publication",
      "input": {
        "dispatcher": {
          "bus": { "failureOrdinal": 1, "shape": "rejecting" },
          "options": {},
          "scheduler": { "shape": "default" }
        },
        "publicationCauseMessage": "reject-start-publication failed",
        "result": "work result"
      },
      "expected": { "hookName": "publishDispatchStart", "hookErrorCount": 1, "causeMessage": "reject-start-publication failed" }
    },
    {
      "name": "bounded-dispatcher-reject-success-publication",
      "description": "records a rejected success publication and retains the work result",
      "shape": "reject-success-publication",
      "input": {
        "dispatcher": {
          "bus": { "failureOrdinal": 2, "shape": "rejecting" },
          "options": {},
          "scheduler": { "shape": "default" }
        },
        "publicationCauseMessage": "reject-success-publication failed",
        "result": "work result"
      },
      "expected": { "hookName": "publishDispatchSuccess", "hookErrorCount": 1, "causeMessage": "reject-success-publication failed" }
    },
    {
      "name": "bounded-dispatcher-reject-error-publication",
      "description": "records a rejected error publication and retains the work error",
      "shape": "reject-error-publication",
      "input": {
        "dispatcher": {
          "bus": { "failureOrdinal": 2, "shape": "rejecting" },
          "options": {},
          "scheduler": { "shape": "default" }
        },
        "publicationCauseMessage": "reject-error-publication failed",
        "workErrorMessage": "work failed"
      },
      "expected": { "hookName": "publishDispatchError", "hookErrorCount": 1, "causeMessage": "reject-error-publication failed" }
    },
    {
      "name": "bounded-dispatcher-snapshot-hook-failures",
      "description": "returns nested snapshots that cannot mutate retained hook failures",
      "shape": "snapshot-hook-failures",
      "input": {
        "dispatcher": {
          "bus": { "failureOrdinal": 1, "shape": "rejecting" },
          "options": {},
          "scheduler": { "shape": "default" }
        },
        "publicationCauseValue": 1,
        "mutatedValue": 99,
        "result": "work result"
      },
      "expected": { "hookName": "publishDispatchStart", "hookErrorCount": 1, "snapshotValue": 1 }
    },
    {
      "name": "bounded-dispatcher-schedule-fires",
      "description": "fires fn through dispatch only once virtual time reaches atMs",
      "shape": "schedule-fires",
      "input": {
        "dispatcher": {
          "atMs": 1000,
          "bus": { "shape": "default" },
          "options": {},
          "scheduler": { "counter": {}, "shape": "virtual" }
        },
        "fireResult": "scheduled-done"
      },
      "expected": { "beforeAdvanceFired": false, "afterAdvanceFired": true, "firedResult": "scheduled-done" }
    },
    {
      "name": "bounded-dispatcher-schedule-cancel",
      "description": "returns the scheduler-owned task handle and cancel prevents the fire",
      "shape": "schedule-cancel",
      "input": {
        "dispatcher": {
          "atMs": 1000,
          "bus": { "shape": "default" },
          "options": {},
          "scheduler": { "counter": {}, "shape": "virtual" }
        }
      },
      "expected": { "fired": false, "cancelType": "function", "atMs": 1000 }
    },
    {
      "name": "bounded-dispatcher-schedule-uses-dispatch",
      "description": "routes the scheduled fn through the permit bound like a direct dispatch call",
      "shape": "schedule-uses-dispatch",
      "input": {
        "dispatcher": {
          "atMs": 100,
          "bus": { "shape": "default" },
          "options": { "permits": 1 },
          "scheduler": { "counter": {}, "shape": "virtual" }
        }
      },
      "expected": { "order": ["scheduled-start", "scheduled-end"] }
    }
  ]
}
