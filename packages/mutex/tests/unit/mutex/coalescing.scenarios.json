{
  "cases": [
    {
      "name": "shares-result",
      "description": "Mutex shares result when coalescing is enabled",
      "shape": "shares-result",
      "input": {
        "batch": { "callerCount": 3 },
        "delayMs": 50,
        "key": "key1",
        "mutex": { "enableCoalescing": true },
        "result": "result"
      },
      "expected": { "executionCount": 1, "results": ["result", "result", "result"] }
    },
    {
      "name": "validates-each-caller-result",
      "description": "Mutex validates each caller result when same-key callers request different types",
      "shape": "validates-each-caller-result",
      "input": {
        "delayMs": 25,
        "key": "shared-key",
        "mutex": { "enableCoalescing": true },
        "numberResult": 42,
        "stringResult": "not-executed"
      },
      "expected": { "numberResult": 42, "rejectedType": "TypeError" }
    },
    {
      "name": "no-share-by-default",
      "description": "Mutex does not share result when coalescing is disabled by default",
      "shape": "no-share-by-default",
      "input": { "batch": { "callerCount": 3 }, "delayMs": 10, "key": "key1" },
      "expected": { "executionCount": 3, "results": ["result-1", "result-2", "result-3"] }
    },
    {
      "name": "coalesces-per-key",
      "description": "Mutex coalesces per key independently",
      "shape": "coalesces-per-key",
      "input": {
        "delayMs": 50,
        "keys": ["key1", "key2"],
        "mutex": { "enableCoalescing": true },
        "batch": { "perKeyCount": 2 }
      },
      "expected": {
        "executionCounts": { "key1": 1, "key2": 1 },
        "results": ["key1-result", "key1-result", "key2-result", "key2-result"]
      }
    },
    {
      "name": "allows-new-execution-after-complete",
      "description": "Mutex allows new execution after previous completes",
      "shape": "allows-new-execution-after-complete",
      "input": { "key": "key1", "mutex": { "enableCoalescing": true } },
      "expected": { "executionCount": 2, "results": [1, 2] }
    },
    {
      "name": "propagates-errors",
      "description": "Mutex propagates errors to all coalesced callers",
      "shape": "propagates-errors",
      "input": {
        "batch": { "callerCount": 3 },
        "delayMs": 50,
        "errorMessage": "Operation failed",
        "key": "key1",
        "mutex": { "enableCoalescing": true }
      },
      "expected": { "executionCount": 1, "rejectionMessage": "Operation failed" }
    },
    {
      "name": "allows-retry-after-error",
      "description": "Mutex allows retry after error with coalescing",
      "shape": "allows-retry-after-error",
      "input": {
        "firstErrorMessage": "First call fails",
        "key": "key1",
        "mutex": { "enableCoalescing": true },
        "successResult": "success"
      },
      "expected": { "callCount": 2, "result": "success" }
    },
    {
      "name": "stats-coalescedCount-enabled",
      "description": "Mutex tracks coalescedCount in stats when coalescing is enabled",
      "shape": "stats-coalescedCount-enabled",
      "input": { "batch": { "callerCount": 3 }, "delayMs": 50, "key": "key1", "mutex": { "enableCoalescing": true } },
      "expected": { "coalescedCount": 2, "totalExecuted": 1 }
    },
    {
      "name": "stats-coalescedCount-disabled",
      "description": "Mutex does not increment coalescedCount when coalescing is disabled",
      "shape": "stats-coalescedCount-disabled",
      "input": { "batch": { "callerCount": 2 }, "delayMs": 10, "key": "key1", "mutex": { "enableCoalescing": false } },
      "expected": { "coalescedCount": 0, "totalExecuted": 2 }
    },
    {
      "name": "stats-coalescedCount-joined",
      "description": "Mutex coalescedCount increments for each joined request",
      "shape": "stats-coalescedCount-joined",
      "input": {
        "batch": { "callerCount": 3 },
        "delayMs": 50,
        "key": "key1",
        "mutex": { "enableCoalescing": true }
      },
      "expected": { "coalescedCount": 2 }
    },
    {
      "name": "clear-allows-new-operations",
      "description": "Mutex allows new operations after clear() is called",
      "shape": "clear-allows-new-operations",
      "input": { "delayMs": 10, "key": "key1", "mutex": { "enableCoalescing": true } },
      "expected": { "firstResult": "first-result", "secondResult": "second-result" }
    },
    {
      "name": "clear-resets-coalescing-state",
      "description": "Mutex resets coalescing state after clear",
      "shape": "clear-resets-coalescing-state",
      "input": { "key": "key1", "mutex": { "enableCoalescing": true } },
      "expected": { "calls": 2, "results": ["result-1", "result-2"] }
    }
  ]
}
