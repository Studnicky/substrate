{
  "assertString": [
    {
      "description": "passes for a string value",
      "input": "hello",
      "name": "field",
      "outcome": "returns"
    },
    {
      "description": "skips validation for undefined",
      "input": {
        "shape": "undefined"
      },
      "name": "field",
      "outcome": "returns"
    },
    {
      "description": "skips validation for null",
      "input": {
        "shape": "null"
      },
      "name": "field",
      "outcome": "returns"
    },
    {
      "description": "throws for a number",
      "input": 42,
      "name": "field",
      "outcome": {
        "message": "field must be a string"
      }
    }
  ],
  "assertNumber": [
    {
      "description": "passes for a valid number",
      "input": 5,
      "name": "count",
      "outcome": "returns"
    },
    {
      "description": "skips for null",
      "input": {
        "shape": "null"
      },
      "name": "count",
      "outcome": "returns"
    },
    {
      "description": "throws for NaN",
      "input": {
        "shape": "nan"
      },
      "name": "count",
      "outcome": {
        "message": "count must be a number"
      }
    }
  ],
  "assertBoolean": [
    {
      "description": "passes for true",
      "input": true,
      "name": "flag",
      "outcome": "returns"
    },
    {
      "description": "passes for false",
      "input": false,
      "name": "flag",
      "outcome": "returns"
    },
    {
      "description": "throws for a string",
      "input": "true",
      "name": "flag",
      "outcome": {
        "message": "flag must be a boolean"
      }
    }
  ],
  "assertFunction": [
    {
      "description": "passes for a function",
      "input": {
        "shape": "function"
      },
      "name": "fn",
      "outcome": "returns"
    },
    {
      "description": "throws for a non-function",
      "input": 42,
      "name": "fn",
      "outcome": {
        "message": "fn must be a function"
      }
    }
  ],
  "assertInteger": [
    {
      "description": "passes for an integer",
      "input": 10,
      "name": "count",
      "outcome": "returns"
    },
    {
      "description": "throws for a float",
      "input": 3.14,
      "name": "count",
      "outcome": {
        "message": "count must be an integer"
      }
    }
  ],
  "assertFinite": [
    {
      "description": "passes for a finite number",
      "input": 100,
      "name": "val",
      "outcome": "returns"
    },
    {
      "description": "throws for Infinity",
      "input": {
        "shape": "infinity"
      },
      "name": "val",
      "outcome": {
        "message": "val must be finite"
      }
    },
    {
      "description": "throws for -Infinity",
      "input": {
        "shape": "negativeInfinity"
      },
      "name": "val",
      "outcome": {
        "message": "val must be finite"
      }
    }
  ],
  "assertNonNegative": [
    {
      "description": "passes for 0",
      "input": 0,
      "name": "count",
      "outcome": "returns"
    },
    {
      "description": "passes for positive number",
      "input": 5,
      "name": "count",
      "outcome": "returns"
    },
    {
      "description": "throws for negative number",
      "input": -1,
      "name": "count",
      "outcome": {
        "message": "count must be non-negative"
      }
    }
  ],
  "assertPositive": [
    {
      "description": "passes for a positive number",
      "input": 1,
      "name": "val",
      "outcome": "returns"
    },
    {
      "description": "throws for 0",
      "input": 0,
      "name": "val",
      "outcome": {
        "message": "val must be positive"
      }
    },
    {
      "description": "throws for negative",
      "input": -5,
      "name": "val",
      "outcome": {
        "message": "val must be positive"
      }
    }
  ],
  "assertMin": [
    {
      "description": "passes when value meets minimum",
      "input": 10,
      "min": 10,
      "name": "val",
      "outcome": "returns"
    },
    {
      "description": "throws when value is below minimum",
      "input": 4,
      "min": 5,
      "name": "val",
      "outcome": {
        "message": "val must be at least 5"
      }
    }
  ],
  "assertPositiveOrInfinity": [
    {
      "description": "passes for Infinity",
      "input": {
        "shape": "infinity"
      },
      "name": "val",
      "outcome": "returns"
    },
    {
      "description": "passes for positive number",
      "input": 1,
      "name": "val",
      "outcome": "returns"
    },
    {
      "description": "throws for 0",
      "input": 0,
      "name": "val",
      "outcome": {
        "message": "val must be positive or Infinity"
      }
    }
  ],
  "assertHasMethod": [
    {
      "description": "passes when object has the method",
      "input": {
        "shape": "objectWithMethod",
        "method": "log"
      },
      "method": "log",
      "name": "logger",
      "outcome": "returns"
    },
    {
      "description": "throws when object lacks the method",
      "input": {},
      "method": "log",
      "name": "logger",
      "outcome": {
        "message": "logger must have a log method"
      }
    },
    {
      "description": "throws when value is not an object",
      "input": 42,
      "method": "log",
      "name": "logger",
      "outcome": {
        "message": "logger must be an object"
      }
    },
    {
      "description": "skips validation for undefined",
      "input": {
        "shape": "undefined"
      },
      "method": "log",
      "name": "logger",
      "outcome": "returns"
    },
    {
      "description": "propagates a real error thrown by exotic property access instead of swallowing it",
      "input": {
        "shape": "throwingGetter",
        "method": "log",
        "errorMessage": "boom"
      },
      "method": "log",
      "name": "logger",
      "outcome": {
        "shape": "throwsError",
        "message": "boom"
      }
    },
    {
      "description": "falls back to a ConfigurationError when exotic property access throws a non-Error",
      "input": {
        "shape": "throwingGetterNonError",
        "method": "log",
        "thrownValue": "boom-string"
      },
      "method": "log",
      "name": "logger",
      "outcome": {
        "message": "logger must have a log method"
      }
    }
  ],
  "assertFunctionOrObjectWithMethod": [
    {
      "description": "passes for a function",
      "input": {
        "shape": "function"
      },
      "method": "emit",
      "name": "handler",
      "outcome": "returns"
    },
    {
      "description": "passes for an object with the method",
      "input": {
        "shape": "objectWithMethod",
        "method": "emit"
      },
      "method": "emit",
      "name": "handler",
      "outcome": "returns"
    },
    {
      "description": "throws for an object missing the method",
      "input": {},
      "method": "emit",
      "name": "handler",
      "outcome": {
        "message": "handler must be a function or an object with a emit method"
      }
    },
    {
      "description": "skips validation for null",
      "input": {
        "shape": "null"
      },
      "method": "emit",
      "name": "handler",
      "outcome": "returns"
    },
    {
      "description": "propagates a real error thrown by exotic property access instead of swallowing it",
      "input": {
        "shape": "throwingGetter",
        "method": "emit",
        "errorMessage": "boom"
      },
      "method": "emit",
      "name": "handler",
      "outcome": {
        "shape": "throwsError",
        "message": "boom"
      }
    },
    {
      "description": "falls back to a ConfigurationError when exotic property access throws a non-Error",
      "input": {
        "shape": "throwingGetterNonError",
        "method": "emit",
        "thrownValue": "boom-string"
      },
      "method": "emit",
      "name": "handler",
      "outcome": {
        "message": "handler must be a function or an object with a emit method"
      }
    }
  ],
  "assertNoUnknownKeys": [
    {
      "description": "passes when all keys are known",
      "input": {
        "a": 1,
        "b": 2
      },
      "knownKeys": [
        "a",
        "b",
        "c"
      ],
      "outcome": "returns"
    },
    {
      "description": "throws when an unknown key is present",
      "input": {
        "a": 1,
        "x": 99
      },
      "knownKeys": [
        "a",
        "b"
      ],
      "outcome": {
        "message": "Unknown configuration key: x"
      }
    }
  ]
}
