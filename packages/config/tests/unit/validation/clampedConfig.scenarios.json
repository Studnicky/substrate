{
  "cases": [
    {
      "name": "clamp-below-min",
      "description": "clamps a field below min up to min",
      "shape": "clamp-below-min",
      "input": {
        "config": { "timeoutMs": 10 },
        "rules": { "timeoutMs": { "minimum": 100, "maximum": 5000, "reason": "timeout too low" } }
      },
      "expected": { "result": { "timeoutMs": 100 } }
    },
    {
      "name": "clamp-above-max",
      "description": "clamps a field above max down to max",
      "shape": "clamp-above-max",
      "input": {
        "config": { "timeoutMs": 999999 },
        "rules": { "timeoutMs": { "minimum": 100, "maximum": 5000, "reason": "timeout too high" } }
      },
      "expected": { "result": { "timeoutMs": 5000 } }
    },
    {
      "name": "in-range-untouched",
      "description": "leaves an in-range field untouched",
      "shape": "in-range-untouched",
      "input": {
        "config": { "timeoutMs": 2000 },
        "rules": { "timeoutMs": { "minimum": 100, "maximum": 5000, "reason": "timeout out of range" } }
      },
      "expected": { "result": { "timeoutMs": 2000 } }
    },
    {
      "name": "unruled-field-untouched",
      "description": "leaves a field not present in rules untouched",
      "shape": "unruled-field-untouched",
      "input": {
        "config": { "timeoutMs": 2000, "unruled": -99999 },
        "rules": { "timeoutMs": { "minimum": 100, "maximum": 5000, "reason": "timeout out of range" } }
      },
      "expected": { "result": { "timeoutMs": 2000, "unruled": -99999 } }
    },
    {
      "name": "non-numeric-field-untouched",
      "description": "leaves a non-numeric field untouched even if the key is ruled",
      "shape": "non-numeric-field-untouched",
      "input": {
        "config": { "timeoutMs": "not-a-number" },
        "rules": { "timeoutMs": { "minimum": 100, "maximum": 5000, "reason": "timeout out of range" } }
      },
      "expected": { "result": { "timeoutMs": "not-a-number" } }
    },
    {
      "name": "absent-field-untouched",
      "description": "leaves a field absent from config untouched",
      "shape": "absent-field-untouched",
      "input": {
        "config": { "other": 1 },
        "rules": { "timeoutMs": { "minimum": 100, "maximum": 5000, "reason": "timeout out of range" } }
      },
      "expected": { "result": { "other": 1 } }
    },
    {
      "name": "returns-new-object",
      "description": "returns a new object, not the same reference as the input",
      "shape": "returns-new-object",
      "input": {
        "config": { "timeoutMs": 10 },
        "rules": { "timeoutMs": { "minimum": 100, "maximum": 5000, "reason": "timeout too low" } }
      },
      "expected": { "input": { "timeoutMs": 10 }, "result": { "timeoutMs": 100 }, "sameRef": false }
    },
    {
      "name": "on-clamp-fires",
      "description": "onClamp fires with raw, clamped, and reason when a field is clamped",
      "shape": "on-clamp-fires",
      "input": {
        "config": { "timeoutMs": 10 },
        "rules": { "timeoutMs": { "minimum": 100, "maximum": 5000, "reason": "timeout too low" } }
      },
      "expected": {
        "event": { "clamped": 100, "field": "timeoutMs", "raw": 10, "reason": "timeout too low" },
        "result": { "timeoutMs": 100 }
      }
    },
    {
      "name": "on-clamp-skipped-in-range",
      "description": "onClamp does not fire for a field left in range",
      "shape": "on-clamp-skipped-in-range",
      "input": {
        "config": { "timeoutMs": 2000 },
        "rules": { "timeoutMs": { "minimum": 100, "maximum": 5000, "reason": "timeout out of range" } }
      },
      "expected": { "eventCount": 0, "result": { "timeoutMs": 2000 } }
    },
    {
      "name": "on-clamp-multi-field",
      "description": "onClamp observes every clamp event across multiple fields",
      "shape": "on-clamp-multi-field",
      "input": {
        "config": { "timeoutMs": 10, "retries": 999, "concurrency": 4 },
        "rules": {
          "concurrency": { "minimum": 1, "maximum": 8, "reason": "concurrency out of range" },
          "retries": { "minimum": 0, "maximum": 10, "reason": "retries too high" },
          "timeoutMs": { "minimum": 100, "maximum": 5000, "reason": "timeout too low" }
        }
      },
      "expected": {
        "eventFields": ["timeoutMs", "retries"],
        "result": { "concurrency": 4, "retries": 10, "timeoutMs": 100 }
      }
    },
    {
      "name": "default-hook-noop",
      "description": "default ClampedConfig has a no-op onClamp",
      "shape": "default-hook-noop",
      "input": {
        "config": { "timeoutMs": 10 },
        "rules": { "timeoutMs": { "minimum": 100, "maximum": 5000, "reason": "timeout too low" } }
      },
      "expected": { "result": { "timeoutMs": 100 } }
    },
    {
      "name": "throwing-hook-preserves-result",
      "description": "a throwing onClamp hook does not replace the clamped result",
      "shape": "throwing-hook-preserves-result",
      "input": {
        "config": { "timeoutMs": 10 },
        "rules": { "timeoutMs": { "minimum": 100, "maximum": 5000, "reason": "timeout too low" } }
      },
      "expected": { "result": { "timeoutMs": 100 } }
    },
    {
      "name": "throwing-hook-preserves-input",
      "description": "a throwing onClamp hook does not corrupt the input config",
      "shape": "throwing-hook-preserves-input",
      "input": {
        "config": { "timeoutMs": 10 },
        "rules": { "timeoutMs": { "minimum": 100, "maximum": 5000, "reason": "timeout too low" } }
      },
      "expected": { "input": { "timeoutMs": 10 }, "result": { "timeoutMs": 100 } }
    },
    {
      "name": "async-throwing-hook-is-contained",
      "description": "an unexpectedly async rejecting onClamp override preserves the clamped result",
      "shape": "async-throwing-hook-is-contained",
      "input": {
        "config": { "timeoutMs": 10 },
        "rules": { "timeoutMs": { "minimum": 100, "maximum": 5000, "reason": "timeout too low" } }
      },
      "expected": { "hookInvoked": true, "rejectionCount": 0, "result": { "timeoutMs": 100 } }
    }
  ]
}
