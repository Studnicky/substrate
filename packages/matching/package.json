{
  "name": "@studnicky/matching",
  "version": "15.0.2",
  "description": "Deterministic matching, scoring, encoding, and candidate-source primitives",
  "bugs": {
    "url": "https://github.com/Studnicky/substrate/issues"
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/matching"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#runtime": {
      "browser": "./dist/runtime/browser/index.js",
      "node": "./dist/runtime/node/index.js",
      "default": "./dist/runtime/node/index.js"
    }
  },
  "exports": {
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./candidate-sources": {
      "types": "./dist/candidate-sources/index.d.ts",
      "import": "./dist/candidate-sources/index.js"
    },
    "./encoders": {
      "types": "./dist/encoders/index.d.ts",
      "import": "./dist/encoders/index.js"
    },
    "./extractors": {
      "types": "./dist/extractors/index.d.ts",
      "import": "./dist/extractors/index.js"
    },
    "./matchers": {
      "types": "./dist/matchers/index.d.ts",
      "import": "./dist/matchers/index.js"
    },
    "./normalizers": {
      "types": "./dist/normalizers/index.d.ts",
      "import": "./dist/normalizers/index.js"
    },
    "./scorers": {
      "types": "./dist/scorers/index.d.ts",
      "import": "./dist/scorers/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./semantic/node": {
      "types": "./dist/semantic/node/index.d.ts",
      "import": "./dist/semantic/node/index.js"
    },
    "./semantic/browser": {
      "types": "./dist/semantic/browser/index.d.ts",
      "import": "./dist/semantic/browser/index.js"
    },
    "./semantic/entities": {
      "types": "./dist/semantic/entities/index.d.ts",
      "import": "./dist/semantic/entities/index.js"
    },
    "./semantic/interfaces": {
      "types": "./dist/semantic/interfaces/index.d.ts",
      "import": "./dist/semantic/interfaces/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist coverage test-reports tsconfig.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "test": "tsx ../../scripts/test-suite.ts all --package ."
  },
  "dependencies": {
    "@studnicky/cache": "workspace:*",
    "@studnicky/entity": "workspace:*",
    "@studnicky/errors": "workspace:*",
    "@studnicky/types": "workspace:*",
    "double-metaphone": "2.0.1",
    "picomatch": "4.0.7"
  },
  "devDependencies": {
    "@types/picomatch": "4.0.3"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
