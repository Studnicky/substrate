{
  "cases": [
    {
      "name": "empty-pipeline-returns-input",
      "description": "returns input unchanged when pipeline is empty",
      "shape": "empty-pipeline-returns-input",
      "input": { "value": "hello" },
      "expected": { "value": "hello" }
    },
    {
      "name": "single-stage-applies",
      "description": "constructs with a single stage",
      "shape": "single-stage-applies",
      "input": { "value": 0 },
      "expected": { "value": 1 }
    },
    {
      "name": "multiple-stages-apply-all",
      "description": "constructs with multiple stages",
      "shape": "multiple-stages-apply-all",
      "input": { "value": 0 },
      "expected": { "value": 2 }
    },
    {
      "name": "single-async-stage-applies",
      "description": "applies a single async transform",
      "shape": "single-async-stage-applies",
      "input": { "value": "hello" },
      "expected": { "value": "hello world" }
    },
    {
      "name": "mixed-sync-async-stages",
      "description": "chains async and sync transforms",
      "shape": "mixed-sync-async-stages",
      "input": { "value": "start" },
      "expected": { "value": "start async sync" }
    },
    {
      "name": "object-context-pass-through",
      "description": "passes object context through transforms",
      "shape": "object-context-pass-through",
      "input": { "value": { "count": 0, "label": "test" } },
      "expected": { "value": { "count": 1, "label": "test!" } }
    },
    {
      "name": "does-not-mutate-original-input",
      "description": "does not mutate the original input",
      "shape": "does-not-mutate-original-input",
      "input": { "value": [1, 2, 3] },
      "expected": { "original": [1, 2, 3], "value": [1, 2, 3, 99] }
    },
    {
      "name": "throwing-lifecycle-observer-has-no-effect",
      "description": "a throwing lifecycle observer leaves the stage result intact",
      "shape": "throwing-lifecycle-observer-has-no-effect",
      "input": { "value": 0 },
      "expected": { "value": 1 }
    },
    {
      "name": "stages-is-defensive-snapshot",
      "description": "stages returns a defensive snapshot",
      "shape": "stages-is-defensive-snapshot",
      "input": { "value": 0 },
      "expected": { "value": 1 }
    },
    {
      "name": "async-observer-has-no-effect",
      "description": "a resolving observer leaves the stage result intact",
      "shape": "async-observer-has-no-effect",
      "input": {
        "stages": [
          { "shape": "add", "value": 1 }
        ],
        "value": 0
      },
      "expected": { "value": 1 }
    },
    {
      "name": "hanging-observer-has-no-effect",
      "description": "a hanging observer leaves the stage result intact",
      "shape": "hanging-observer-has-no-effect",
      "input": {
        "stages": [
          { "shape": "add", "value": 1 }
        ],
        "value": 0
      },
      "expected": { "value": 1 }
    }
  ]
}
