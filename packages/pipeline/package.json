{
  "name": "@studnicky/pipeline",
  "version": "15.1.0",
  "description": "Generic typed async pipeline for sequential context transforms",
  "keywords": [
    "async",
    "middleware",
    "pipeline",
    "transform",
    "typescript"
  ],
  "homepage": "https://studnicky.github.io/substrate/packages/pipeline",
  "bugs": {
    "url": "https://github.com/Studnicky/substrate/issues"
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/pipeline"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#runtime": {
      "browser": "./dist/runtime/browser/index.js",
      "node": "./dist/runtime/node/index.js",
      "default": "./dist/runtime/node/index.js"
    }
  },
  "exports": {
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./fsm": {
      "types": "./dist/fsm/index.d.ts",
      "import": "./dist/fsm/index.js"
    },
    "./fsm/interfaces": {
      "types": "./dist/fsm/interfaces/index.d.ts",
      "import": "./dist/fsm/interfaces/index.js"
    },
    "./fsm/entities": {
      "types": "./dist/fsm/entities/index.d.ts",
      "import": "./dist/fsm/entities/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist coverage test-reports tsconfig.tsbuildinfo",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "tsx ../../scripts/test-suite.ts all --package ."
  },
  "dependencies": {
    "@studnicky/entity": "workspace:*",
    "@studnicky/errors": "workspace:*",
    "@studnicky/fsm": "workspace:*",
    "@studnicky/json": "workspace:*",
    "@studnicky/types": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
