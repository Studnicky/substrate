{
  "cases": [
    {
      "name": "level-values",
      "description": "LOG_LEVEL values are stable",
      "shape": "level-values",
      "input": {
        "values": {
          "TRACE": 0,
          "DEBUG": 1,
          "INFO": 2,
          "WARN": 3,
          "ERROR": 4,
          "SILENT": 5
        }
      },
      "expected": {
        "values": {
          "TRACE": 0,
          "DEBUG": 1,
          "INFO": 2,
          "WARN": 3,
          "ERROR": 4,
          "SILENT": 5
        }
      }
    },
    {
      "name": "level-order",
      "description": "levels are ordered by severity",
      "shape": "level-order",
      "input": {
        "ordered": true
      },
      "expected": {
        "ordered": true
      }
    },
    {
      "name": "level-map",
      "description": "LOG_LEVEL_MAP resolves lowercase names",
      "shape": "level-map",
      "input": {
        "resolved": {
          "trace": 0,
          "debug": 1,
          "info": 2,
          "warn": 3,
          "error": 4,
          "silent": 5
        }
      },
      "expected": {
        "resolved": {
          "trace": 0,
          "debug": 1,
          "info": 2,
          "warn": 3,
          "error": 4,
          "silent": 5
        }
      }
    },
    {
      "name": "parse-numeric",
      "description": "parseLogLevel passes through numeric levels",
      "shape": "parse-numeric",
      "input": {
        "values": [
          0,
          1,
          2,
          3,
          4,
          5
        ]
      },
      "expected": {
        "values": [
          0,
          1,
          2,
          3,
          4,
          5
        ]
      }
    },
    {
      "name": "parse-string",
      "description": "parseLogLevel parses lowercase names",
      "shape": "parse-string",
      "input": {
        "values": {
          "trace": 0,
          "debug": 1,
          "info": 2,
          "warn": 3,
          "error": 4,
          "silent": 5
        }
      },
      "expected": {
        "values": {
          "trace": 0,
          "debug": 1,
          "info": 2,
          "warn": 3,
          "error": 4,
          "silent": 5
        }
      }
    },
    {
      "name": "parse-invalid-string",
      "description": "parseLogLevel falls back to INFO for invalid inputs",
      "shape": "parse-invalid-string",
      "input": {
        "values": {
          "empty": 2,
          "invalid": 2,
          "uppercase": 2,
          "title": 2,
          "spaced": 2,
          "negative": 2,
          "large": 2
        }
      },
      "expected": {
        "values": {
          "empty": 2,
          "invalid": 2,
          "uppercase": 2,
          "title": 2,
          "spaced": 2,
          "negative": 2,
          "large": 2
        }
      }
    },
    {
      "name": "safe-stringify-basic",
      "description": "safeStringify handles basic JSON shapes",
      "shape": "safe-stringify-basic",
      "input": {
        "outputs": [
          "{\"name\":\"test\",\"value\":42}",
          "[1,2,3]",
          "{\"level1\":{\"level2\":{\"level3\":\"deep value\"}}}",
          "{\"value\":null}",
          "{}"
        ]
      },
      "expected": {
        "outputs": [
          "{\"name\":\"test\",\"value\":42}",
          "[1,2,3]",
          "{\"level1\":{\"level2\":{\"level3\":\"deep value\"}}}",
          "{\"value\":null}",
          "{}"
        ]
      }
    },
    {
      "name": "safe-stringify-circular",
      "description": "safeStringify handles circular references",
      "shape": "safe-stringify-circular",
      "input": {
        "result1Contains": [
          "\"name\":\"test\"",
          "\"self\":\"[Circular]\""
        ],
        "result2Contains": [
          "\"name\":\"obj1\"",
          "\"name\":\"obj2\"",
          "[Circular]"
        ]
      },
      "expected": {
        "result1Contains": [
          "\"name\":\"test\"",
          "\"self\":\"[Circular]\""
        ],
        "result2Contains": [
          "\"name\":\"obj1\"",
          "\"name\":\"obj2\"",
          "[Circular]"
        ]
      }
    },
    {
      "name": "safe-stringify-types",
      "description": "safeStringify handles nested types and symbols",
      "shape": "safe-stringify-types",
      "input": {
        "contains": [
          "\"value\":\"deep\"",
          "\"circularRef\":\"[Circular]\""
        ],
        "parsed": {
          "array": [
            1,
            2,
            3
          ],
          "boolean": true,
          "nested": {
            "key": "value"
          },
          "nullValue": null,
          "number": 42,
          "string": "text"
        }
      },
      "expected": {
        "contains": [
          "\"value\":\"deep\"",
          "\"circularRef\":\"[Circular]\""
        ],
        "parsed": {
          "array": [
            1,
            2,
            3
          ],
          "boolean": true,
          "nested": {
            "key": "value"
          },
          "nullValue": null,
          "number": 42,
          "string": "text"
        }
      }
    },
    {
      "name": "safe-stringify-json-edges",
      "description": "safeStringify handles dates, primitive values, empty containers, and symbol-keyed properties",
      "shape": "safe-stringify-json-edges",
      "input": {},
      "expected": {
        "dateContains": "2024-01-01T00:00:00.000Z",
        "emptyObject": "{}",
        "emptyArray": "[]",
        "primitives": {
          "boolean": "true",
          "null": "null",
          "number": "42",
          "string": "\"string\""
        },
        "symbolObject": "{\"regular\":\"regular value\"}"
      }
    },
    {
      "name": "log-fault-basic",
      "description": "LogFault creates an immutable fault from one configuration object",
      "shape": "log-fault-basic",
      "input": {
        "fault": {
          "component": "graph",
          "context": {
            "details": {
              "attempt": 1
            },
            "query": "SELECT..."
          },
          "message": "Query exceeded timeout",
          "name": "TimeoutError",
          "operation": "query",
          "status": "failed"
        }
      },
      "expected": {
        "event": "graph.query",
        "frozen": true,
        "message": "Query exceeded timeout",
        "nestedAttempt": 1,
        "name": "TimeoutError",
        "status": "failed"
      }
    },
    {
      "name": "log-fault-optional-fields",
      "description": "LogFault includes optional cause, duration, and stack fields when present",
      "shape": "log-fault-optional-fields",
      "input": {
        "fault": {
          "cause": "Connection pool exhausted",
          "component": "graph",
          "context": {},
          "durationMs": 30000,
          "message": "Query timeout",
          "name": "TimeoutError",
          "operation": "query",
          "stack": "Error: Query timeout\n    at foo.js:10:5",
          "status": "timeout"
        }
      },
      "expected": {
        "cause": "Connection pool exhausted",
        "durationMs": 30000,
        "stack": "Error: Query timeout\n    at foo.js:10:5"
      }
    },
    {
      "name": "log-fault-missing-component",
      "description": "LogFault rejects configs without component",
      "shape": "log-fault-missing-field",
      "input": {
        "fault": {
          "context": {},
          "message": "Failed",
          "name": "Error",
          "operation": "query",
          "status": "failed"
        }
      },
      "expected": {
        "message": "LogFault: component is required",
        "name": "LogBuildError"
      }
    },
    {
      "name": "log-fault-missing-operation",
      "description": "LogFault rejects configs without operation",
      "shape": "log-fault-missing-field",
      "input": {
        "fault": {
          "component": "graph",
          "context": {},
          "message": "Failed",
          "name": "Error",
          "status": "failed"
        }
      },
      "expected": {
        "message": "LogFault: operation is required",
        "name": "LogBuildError"
      }
    },
    {
      "name": "log-fault-missing-status",
      "description": "LogFault rejects configs without status",
      "shape": "log-fault-missing-field",
      "input": {
        "fault": {
          "component": "graph",
          "context": {},
          "message": "Failed",
          "name": "Error",
          "operation": "query"
        }
      },
      "expected": {
        "message": "LogFault: status is required",
        "name": "LogBuildError"
      }
    },
    {
      "name": "log-fault-missing-context",
      "description": "LogFault rejects configs without context",
      "shape": "log-fault-missing-field",
      "input": {
        "fault": {
          "component": "graph",
          "message": "Failed",
          "name": "Error",
          "operation": "query",
          "status": "failed"
        }
      },
      "expected": {
        "message": "LogFault: context is required (use empty object {} if no context needed)",
        "name": "LogBuildError"
      }
    },
    {
      "name": "log-fault-missing-name",
      "description": "LogFault rejects configs without error name",
      "shape": "log-fault-missing-field",
      "input": {
        "fault": {
          "component": "graph",
          "context": {},
          "message": "Failed",
          "operation": "query",
          "status": "failed"
        }
      },
      "expected": {
        "message": "LogFault: name is required",
        "name": "LogBuildError"
      }
    },
    {
      "name": "log-fault-missing-message",
      "description": "LogFault rejects configs without message",
      "shape": "log-fault-missing-field",
      "input": {
        "fault": {
          "component": "graph",
          "context": {},
          "name": "Error",
          "operation": "query",
          "status": "failed"
        }
      },
      "expected": {
        "message": "LogFault: message is required",
        "name": "LogBuildError"
      }
    },
    {
      "name": "log-fault-from-error-fields",
      "description": "LogFault accepts explicitly mapped Error fields and cause message",
      "shape": "log-fault-from-error-fields",
      "input": {
        "error": {
          "cause": "Root cause",
          "message": "Wrapper error",
          "name": "Error"
        },
        "fault": {
          "component": "graph",
          "context": {},
          "operation": "query",
          "status": "failed"
        }
      },
      "expected": {
        "cause": "Root cause",
        "event": "graph.query",
        "message": "Wrapper error",
        "name": "Error"
      }
    },
    {
      "name": "console-transport-dispatch",
      "description": "ConsoleTransport dispatches each log level to the matching console method and applies metadata prefixing",
      "shape": "console-transport-dispatch",
      "input": {
        "body": {
          "component": "console",
          "context": {},
          "operation": "write",
          "status": "success",
          "time": 123
        },
        "records": [
          {
            "level": 0,
            "message": "trace-message",
            "metadata": {},
            "method": "trace"
          },
          {
            "level": 1,
            "message": "debug-message",
            "metadata": {},
            "method": "debug"
          },
          {
            "level": 2,
            "message": "info-message",
            "metadata": {
              "requestId": "req-1"
            },
            "method": "info"
          },
          {
            "level": 3,
            "message": "warn-message",
            "metadata": {},
            "method": "warn"
          },
          {
            "level": 4,
            "message": "error-message",
            "metadata": {},
            "method": "error"
          }
        ],
        "transport": {
          "filtered": {
            "level": 1,
            "message": "filtered-debug",
            "minLevel": 3
          },
          "level": 0
        }
      },
      "expected": {
        "calls": {
          "debug": [
            "debug-message"
          ],
          "error": [
            "error-message"
          ],
          "info": [
            "{\"requestId\":\"req-1\"} info-message"
          ],
          "trace": [
            "trace-message"
          ],
          "warn": [
            "warn-message",
            "warn-after-filter"
          ]
        }
      }
    },
    {
      "name": "console-transport-invalid-level",
      "description": "ConsoleTransport rejects non-string and non-number level options",
      "shape": "console-transport-invalid-level",
      "input": {
        "transport": {
          "level": {}
        }
      },
      "expected": {
        "message": "level must be a string or number",
        "name": "ConfigurationError"
      }
    },
    {
      "name": "error-constructors",
      "description": "logger error constructors preserve names, messages, code, and cause wiring",
      "shape": "error-constructors",
      "input": {},
      "expected": {
        "code": "logger.error",
        "constructors": [
          {
            "message": "base logger failure",
            "name": "LoggerError",
            "withCause": true
          },
          {
            "message": "circular metadata",
            "name": "CircularReferenceError",
            "withCause": true
          },
          {
            "message": "file write failed",
            "name": "FileDestinationError",
            "withCause": true
          },
          {
            "message": "invalid level",
            "name": "InvalidLogLevelError",
            "withCause": true
          },
          {
            "message": "LogBody: component is required",
            "name": "LogBuildError",
            "withCause": false
          }
        ]
      }
    },
    {
      "name": "entity-composition",
      "description": "logger entity composition contracts are enforced",
      "shape": "entity-composition",
      "input": {
        "logDataValid": true,
        "logDataInvalid": false,
        "cloudwatchValid": true,
        "hookShapeValid": true,
        "hookShapeInvalid": false
      },
      "expected": {
        "logDataValid": true,
        "logDataInvalid": false,
        "cloudwatchValid": true,
        "hookShapeValid": true,
        "hookShapeInvalid": false
      }
    }
  ]
}
