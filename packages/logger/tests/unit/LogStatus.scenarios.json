{
  "cases": [
    {
      "name": "status-lifecycle-values",
      "description": "LOG_STATUS exposes lifecycle status values",
      "shape": "status-lifecycle-values",
      "input": { "values": ["pending", "in_progress", "complete"] },
      "expected": { "values": ["pending", "in_progress", "complete"] }
    },
    {
      "name": "status-success-values",
      "description": "LOG_STATUS exposes success status values",
