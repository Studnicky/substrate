      "input": { "values": ["pending", "in_progress", "complete"] },
      "expected": { "values": ["pending", "in_progress", "complete"] }
    },
    {
      "name": "status-categories-success",
      "description": "STATUS_CATEGORIES exposes success category",
      "shape": "status-categories-success",
      "input": { "values": ["success", "partial", "cached", "skipped"] },
      "expected": { "values": ["success", "partial", "cached", "skipped"] }
    },
    {
      "name": "status-categories-failure",
      "description": "STATUS_CATEGORIES exposes failure category",
      "shape": "status-categories-failure",
      "input": { "values": ["failed", "timeout", "invalid", "not_found", "unauthorized", "rate_limited", "unavailable"] },
      "expected": { "values": ["failed", "timeout", "invalid", "not_found", "unauthorized", "rate_limited", "unavailable"] }
    },
    {
      "name": "status-categories-retry",
