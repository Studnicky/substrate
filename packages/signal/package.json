{
  "name": "@studnicky/signal",
  "version": "15.0.0",
  "description": "AbortSignal composition for caller signals, deadlines, and a never-aborting reference",
  "keywords": [
    "abort",
    "abortsignal",
    "cancellation",
    "signal",
    "timeout",
    "typescript"
  ],
  "homepage": "https://studnicky.github.io/substrate/packages/signal",
  "bugs": {
    "url": "https://github.com/Studnicky/substrate/issues"
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/signal"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "tsx ../../scripts/test-suite.ts all --package ."
  },
  "dependencies": {
    "@studnicky/errors": "workspace:*",
    "@studnicky/types": "workspace:*"
  },
  "devDependencies": {
    "@studnicky/clock": "workspace:*",
    "@studnicky/entity": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
