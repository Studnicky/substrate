{
  "name": "@studnicky/entity",
  "version": "15.1.0",
  "description": "Entity construction primitives: strict creation and intake compilation, canonical entity contracts, and cycle-safe value-graph checks",
  "keywords": [
    "boundary",
    "entity",
    "intake",
    "schema",
    "validation"
  ],
  "homepage": "https://studnicky.github.io/substrate/packages/entity",
  "bugs": {
    "url": "https://github.com/Studnicky/substrate/issues"
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/entity"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#runtime": {
      "browser": "./dist/runtime/browser/index.js",
      "node": "./dist/runtime/node/index.js",
      "default": "./dist/runtime/node/index.js"
    }
  },
  "exports": {
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "benchmark": "pnpm run build && tsc --project benchmarks/tsconfig.json && tsx benchmarks/entityCompiler.ts",
    "clean": "rm -rf dist coverage test-reports tsconfig.tsbuildinfo",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "tsx ../../scripts/test-suite.ts all --package ."
  },
  "dependencies": {
    "@studnicky/types": "workspace:*",
    "@types/json-schema": "^7.0.15"
  },
  "devDependencies": {
    "json-schema-to-ts": "^3.1.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
