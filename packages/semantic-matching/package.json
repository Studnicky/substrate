{
  "name": "@studnicky/semantic-matching",
  "version": "11.1.0",
  "description": "Composable contracts for vectorization, vector indexes, reranking, classification, and adjudication",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist coverage test-reports tsconfig.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "test": "node ../../scripts/test-suite.mjs all --package ."
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/semantic-matching"
  },
  "bugs": { "url": "https://github.com/Studnicky/substrate/issues" },
  "publishConfig": { "registry": "https://npm.pkg.github.com", "access": "public" },
  "engines": { "node": ">=24.0.0", "npm": ">=11.0.0" },
  "dependencies": { "@studnicky/types": "workspace:*" }
}
