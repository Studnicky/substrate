{
  "cases": [
    {
      "name": "missing-worker-path",
      "description": "throws when workerPath is missing",
      "shape": "missing-worker-path",
      "input": {
        "workerPool": { "workerPath": "" }
      },
      "expected": { "errorMessageIncludes": "configuration is invalid" }
    },
    {
      "name": "default-concurrency",
      "description": "runs successfully when concurrency is omitted",
      "shape": "default-concurrency",
      "input": {
        "workerPool": {
          "workerPath": "../../fixtures/worker/echoWorker.ts"
        },
        "items": [{ "value": "a" }]
      },
      "expected": { "results": ["a"] }
    },
    {
      "name": "caller-supplied-signal",
      "description": "composes a caller-supplied Signal exactly once per task, deriving both the startup and task deadlines from it",
      "shape": "caller-supplied-signal",
      "input": {
        "workerPool": {
          "timeoutMs": 1000,
          "workerPath": "../../fixtures/worker/echoWorker.ts"
        },
        "items": [{ "value": "a" }],
        "signal": { "shape": "tracking" }
      },
      "expected": {
        "composeCalls": 1,
        "results": ["a"]
      }
    },
    {
      "name": "explicit-bounded-concurrency",
      "description": "builds a functioning pool with bounded concurrency",
      "shape": "explicit-bounded-concurrency",
      "input": {
        "workerPool": {
          "batch": { "concurrency": 2 },
          "concurrency": 2,
          "workerPath": "../../fixtures/worker/echoWorker.ts"
        },
        "items": [{ "value": "a" }]
      },
      "expected": { "results": ["a"] }
    },
    {
      "name": "foreign-construction",
      "description": "rejects a subclass constructor that does not return a worker pool instance",
      "shape": "foreign-construction",
      "input": {
        "workerPool": {
          "batch": { "concurrency": 1 },
          "concurrency": 1,
          "workerPath": "../../fixtures/worker/echoWorker.ts"
        }
      },
      "expected": {
        "errorMessageIncludes": "must construct a WorkerPool instance"
      }
    }
  ]
}
