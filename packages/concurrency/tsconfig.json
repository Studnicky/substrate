{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": ["ESNext", "DOM"],
    "paths": {
      "#file-system": ["./src/file-system/node/index.ts"],
      "#runtime": ["./src/runtime/node/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "references": [
    {
      "path": "../clock"
    },
    {
      "path": "../config"
    },
    {
      "path": "../circular-buffer"
    },
    {
      "path": "../errors"
    },
    {
      "path": "../entity"
    },
    {
      "path": "../fsm"
    },
    {
      "path": "../scheduler"
    },
    {
      "path": "../signal"
    },
    {
      "path": "../types"
    },
    {
      "path": "../virtual-fs"
    }
  ]
}
