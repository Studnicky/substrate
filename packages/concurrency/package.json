{
  "name": "@studnicky/concurrency",
  "version": "15.0.0",
  "description": "Async coordination primitives: Semaphore, Coalesce, Channel, AsyncIter",
  "keywords": [
    "async-iter",
    "channel",
    "coalesce",
    "concurrency",
    "semaphore",
    "single-flight",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/Studnicky/substrate/issues"
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/concurrency"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./queue/node": {
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.js"
    },
    "./queue/browser": {
      "types": "./dist/queue/index.d.ts",
      "import": "./dist/queue/index.js"
    },
    "./queue/entities": {
      "types": "./dist/queue/entities/index.d.ts",
      "import": "./dist/queue/entities/index.js"
    },
    "./queue/interfaces": {
      "types": "./dist/queue/interfaces/index.d.ts",
      "import": "./dist/queue/interfaces/index.js"
    },
    "./mutex": {
      "types": "./dist/mutex/index.d.ts",
      "import": "./dist/mutex/index.js"
    },
    "./file-lock/node": {
      "types": "./dist/file-lock/node/index.d.ts",
      "import": "./dist/file-lock/node/index.js"
    },
    "./file-lock/browser": {
      "types": "./dist/file-lock/browser/index.d.ts",
      "import": "./dist/file-lock/browser/index.js"
    },
    "./file-lock/entities": {
      "types": "./dist/file-lock/entities/index.d.ts",
      "import": "./dist/file-lock/entities/index.js"
    },
    "./file-lock/interfaces": {
      "types": "./dist/file-lock/interfaces/index.d.ts",
      "import": "./dist/file-lock/interfaces/index.js"
    },
    "./batch": {
      "types": "./dist/batch/index.d.ts",
      "import": "./dist/batch/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist coverage test-reports tsconfig.tsbuildinfo",
    "test": "tsx ../../scripts/test-suite.ts all --package ."
  },
  "dependencies": {
    "@studnicky/circular-buffer": "workspace:*",
    "@studnicky/clock": "workspace:*",
    "@studnicky/config": "workspace:*",
    "@studnicky/entity": "workspace:*",
    "@studnicky/errors": "workspace:*",
    "@studnicky/fsm": "workspace:*",
    "@studnicky/signal": "workspace:*",
    "@studnicky/types": "workspace:*",
    "@studnicky/virtual-fs": "workspace:*"
  },
  "devDependencies": {
    "@studnicky/scheduler": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
