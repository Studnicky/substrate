{
  "name": "@studnicky/context",
  "version": "15.1.0",
  "description": "Async context isolation for Node and browser code",
  "keywords": [
    "async",
    "async-local-storage",
    "context",
    "request-context",
    "typescript"
  ],
  "homepage": "https://studnicky.github.io/substrate/packages/context",
  "bugs": {
    "url": "https://github.com/Studnicky/substrate/issues"
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/context"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#platform": {
      "browser": "./dist/platform/browser/index.js",
      "node": "./dist/platform/node/index.js",
      "default": "./dist/platform/node/index.js"
    },
    "#runtime": {
      "browser": "./dist/runtime/browser/index.js",
      "node": "./dist/runtime/node/index.js",
      "default": "./dist/runtime/node/index.js"
    }
  },
  "exports": {
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./node/transform": {
      "types": "./dist/node/transform.d.ts",
      "import": "./dist/node/transform.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./browser/transform": {
      "types": "./dist/browser/transform.d.ts",
      "import": "./dist/browser/transform.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./store/node": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./store/browser": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./store/interfaces": {
      "types": "./dist/store/interfaces/index.d.ts",
      "import": "./dist/store/interfaces/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist coverage test-reports tsconfig.tsbuildinfo",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "tsx ../../scripts/test-suite.ts all --package ."
  },
  "dependencies": {
    "@studnicky/entity": "workspace:*",
    "@studnicky/errors": "workspace:*",
    "@studnicky/fsm": "workspace:*",
    "@studnicky/json": "workspace:*",
    "@studnicky/store": "workspace:*",
    "@studnicky/types": "workspace:*",
    "rollup": "^4.63.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@studnicky/concurrency": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
