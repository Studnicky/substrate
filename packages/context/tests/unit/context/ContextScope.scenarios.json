          "userId": "user-123"
        }
      }
    },
    {
      "name": "middleware-chain-pattern",
      "description": "middleware chain pattern",
      "kind": "middleware-chain-pattern",
      "input": {
        "context": {
          "name": "middleware"
        },
        "scope": {
          "initial": {
            "requestId": "req-789"
          }
        }
      },
      "expected": {
        "authenticated": true,
        "logged": true,
        "requestId": "req-789",
        "user": {
          "id": "123"
        },
        "validated": true
      }
    },
    {
      "name": "parallel-operations-pattern",
      "description": "parallel operations with shared context",
      "kind": "parallel-operations-pattern",
      "input": {
        "context": {
          "name": "parallel"
        },
        "scope": {
          "delays": [
            10,
            20,
            15
          ],
          "initial": {
            "results": []
          }
        }
      },
      "expected": {
        "results": [
          "op1",
          "op2",
          "op3"
        ]
