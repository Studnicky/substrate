      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "initial": "value"
          }
        }
      },
      "expected": {
        "afterError": true
      }
    },
    {
      "name": "terminate-after-error",
      "description": "can terminate after error in execute",
      "kind": "terminate-after-error",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "key": "value"
          }
        }
      },
      "expected": {
        "terminate": {
          "key": "value"
        }
      }
    },
