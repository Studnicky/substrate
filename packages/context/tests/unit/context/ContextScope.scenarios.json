{
  "cases": [
    {
      "name": "active-on-construction",
      "description": "scope starts active after initialize",
      "kind": "active-on-construction",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "key": "value"
          }
        }
      },
      "expected": {
        "result": "value"
      }
    },
    {
      "name": "multi-execute-before-terminate",
      "description": "scope can execute multiple times before terminate",
      "kind": "multi-execute-before-terminate",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "executions": [
            1,
            2,
            3
          ]
        }
      },
      "expected": {
        "executions": [
          1,
          2,
          3
        ]
      }
    },
    {
      "name": "terminated-scope-throws",
      "description": "terminated scope throws on execute",
      "kind": "terminated-scope-throws",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "message": "test scope has been terminated"
        }
      },
      "expected": {
        "message": "test scope has been terminated"
      }
    },
    {
      "name": "terminate-once",
      "description": "terminate can only be called once",
      "kind": "terminate-once",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "message": "test scope has already been terminated"
        }
      },
      "expected": {
        "message": "test scope has already been terminated"
      }
    },
    {
      "name": "persist-values-across-executes",
      "description": "values set in first execute persist to second execute",
      "kind": "persist-values-across-executes",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "fromFirst": "value1",
          "fromSecond": "value2"
        }
      },
      "expected": {
        "terminate": {
          "fromFirst": "value1",
          "fromSecond": "value2"
        }
      }
    },
    {
      "name": "overwrite-later-values",
      "description": "modifications in later execute overwrite earlier values",
      "kind": "overwrite-later-values",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "counter": 0
          }
        }
      },
      "expected": {
        "counter": 3
      }
    },
    {
      "name": "delete-affects-later-executes",
      "description": "deletions in one execute affect subsequent executes",
      "kind": "delete-affects-later-executes",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "keep": "kept",
            "remove": "removed"
          }
        }
      },
      "expected": {
        "terminate": {
          "keep": "kept"
        }
      }
    },
    {
      "name": "async-accumulates-state",
      "description": "accumulates state through async execute calls",
      "kind": "async-accumulates-state",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "step": 0
          }
        }
      },
      "expected": {
        "terminate": {
          "async1": "done",
          "async2": "done",
          "step": 2
        }
      }
    },
    {
      "name": "promise-resolve-propagation",
      "description": "context propagates through Promise.resolve",
      "kind": "promise-resolve-propagation",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "id": "promise-test"
          }
        }
      },
      "expected": {
        "id": "promise-test"
      }
    },
    {
      "name": "timeout-propagation",
      "description": "context propagates through setTimeout",
      "kind": "timeout-propagation",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "id": "timeout-test"
          }
        }
      },
      "expected": {
        "id": "timeout-test"
      }
    },
    {
      "name": "promise-all-propagation",
      "description": "context propagates through Promise.all",
      "kind": "promise-all-propagation",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "id": "all-test"
          }
        }
      },
      "expected": {
        "results": [
          "all-test",
          "all-test",
          "all-test"
        ]
      }
    },
    {
      "name": "nested-async-functions",
      "description": "context propagates through nested async functions",
      "kind": "nested-async-functions",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "depth": 0
          }
        }
      },
      "expected": {
        "finalDepth": 3
      }
    },
    {
      "name": "mutations-visible-after-await",
      "description": "mutations within async operations are visible after await",
      "kind": "mutations-visible-after-await",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "before": true,
          "after": true
        }
      },
      "expected": {
        "terminate": {
          "after": true,
          "before": true
        }
      }
    },
    {
      "name": "separate-scopes-isolated",
      "description": "separate scopes have isolated stores",
      "kind": "separate-scopes-isolated",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": [
            {
              "id": "scope-1"
            },
            {
              "id": "scope-2"
            },
            {
              "id": "scope-3"
            }
          ]
        }
      },
      "expected": {
        "contains": [
          "1:scope-1",
          "2:scope-2",
          "3:scope-3"
        ]
      }
    },
    {
      "name": "mutations-in-one-scope-not-others",
      "description": "mutations in one scope do not affect concurrent scopes",
      "kind": "mutations-in-one-scope-not-others",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "value": "original"
          }
        }
      },
      "expected": {
        "scope1": "modified-by-1",
        "scope2": "modified-by-2"
      }
    },
    {
      "name": "independent-key-sets",
      "description": "each scope maintains independent key sets",
      "kind": "independent-key-sets",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "shared": true
          }
        }
      },
      "expected": {
        "only1": [
          "only1"
        ],
        "only2": [
          "only2"
        ]
      }
    },
    {
      "name": "snapshot-complete",
      "description": "returns complete snapshot of all values",
      "kind": "snapshot-complete",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "initial1": "a",
            "initial2": "b"
          }
        }
      },
      "expected": {
        "snapshot": {
          "added1": "c",
          "added2": "d",
          "initial1": "a",
          "initial2": "b"
        }
      }
    },
    {
      "name": "snapshot-clears-store",
      "description": "clears internal store after terminate",
      "kind": "snapshot-clears-store",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "key": "value"
          }
        }
      },
      "expected": {
        "first": "value",
        "secondThrows": true
      }
    },
    {
      "name": "snapshot-independent-copy",
      "description": "snapshot is independent copy",
      "kind": "snapshot-independent-copy",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "obj": {
              "nested": "original"
            }
          }
        }
      },
      "expected": {
        "nested": "mutated"
      }
    },
    {
      "name": "prevent-execute-after-terminate",
      "description": "prevents execute after terminate",
      "kind": "prevent-execute-after-terminate",
      "input": {
        "context": {
          "name": "my-scope"
        },
        "scope": {
          "message": "my-scope scope has been terminated"
        }
      },
      "expected": {
        "message": "my-scope scope has been terminated"
      }
    },
    {
      "name": "immediate-terminate-with-values",
      "description": "can terminate immediately after initialize with initial values",
      "kind": "immediate-terminate-with-values",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "initial": {
            "a": 1,
            "b": 2
          }
        }
      },
      "expected": {
        "terminate": {
          "a": 1,
          "b": 2
        }
      }
    },
    {
      "name": "immediate-terminate-empty",
      "description": "returns empty object when initialized without values and no execute",
      "kind": "immediate-terminate-empty",
      "input": {
        "context": {
          "name": "test"
        },
        "scope": {
          "terminate": {}
        }
      },
      "expected": {
        "terminate": {}
      }
    },
    {
