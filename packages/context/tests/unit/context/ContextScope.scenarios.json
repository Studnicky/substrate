    {
      "name": "request-handling-pattern",
      "description": "request handling pattern",
      "kind": "request-handling-pattern",
      "input": {
        "context": {
          "name": "request"
        },
        "scope": {
          "requestId": "req-456"
        }
      },
      "expected": {
        "response": {
          "body": "{\"data\":\"processed\"}",
          "status": 200
        },
        "finalState": {
