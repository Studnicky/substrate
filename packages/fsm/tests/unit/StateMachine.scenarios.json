{
  "cases": [
    {
      "name": "transitions-off-on",
      "description": "transitions off to on",
      "shape": "transitions-off-on",
      "input": { "variant": "off" },
      "expected": { "stateVariant": "on" }
    },
    {
      "name": "transitions-on-off",
      "description": "transitions on to off",
      "shape": "transitions-on-off",
      "input": { "variant": "on" },
      "expected": { "stateVariant": "off" }
    },
    {
      "name": "wraps-reducer-throw",
      "description": "wraps reducer throw as ReducerThrewError",
      "shape": "wraps-reducer-throw",
      "input": { "variant": "off" },
      "expected": {
        "errorName": "ReducerThrewError"
      }
    },
    {
      "name": "rejected-error-surfaces",
      "description": "TransitionRejectedError surfaces without wrapping",
      "shape": "rejected-error-surfaces",
      "input": { "variant": "off" },
      "expected": {
        "errorName": "TransitionRejectedError",
        "eventType": "toggle",
        "stateVariant": "off"
      }
    },
    {
      "name": "plain-error-wraps",
      "description": "plain reducer errors still wrap as ReducerThrewError",
      "shape": "plain-error-wraps",
      "input": { "variant": "off" },
      "expected": { "errorName": "ReducerThrewError" }
    },
    {
      "name": "terminated-blocks-transition",
      "description": "isTerminated blocks further transitions",
      "shape": "terminated-blocks-transition",
      "input": { "variant": "off" },
      "expected": {
        "firstTransitionStateVariant": "on",
        "secondErrorName": "MachineTerminatedError",
        "secondEventType": "toggle",
        "secondStateVariant": "on"
      }
    },
    {
      "name": "terminated-access-hook",
      "description": "onTerminatedAccess fires on terminated state access",
      "shape": "terminated-access-hook",
      "input": { "variant": "on" },
      "expected": {
        "callCount": 1,
        "callEventType": "toggle",
        "callStateVariant": "on"
      }
    }
  ]
}
