{
  "name": "@studnicky/fsm",
  "version": "14.0.0",
  "description": "Pure reducer FSM with async effect interpreter and actor registry",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./node": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "type-check": "tsc --noEmit",
    "test": "tsx ../../scripts/test-suite.ts all --package ."
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/fsm"
  },
  "bugs": {
    "url": "https://github.com/Studnicky/substrate/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "keywords": [
    "fsm",
    "state-machine",
    "finite-state-machine",
    "reducer",
    "actor",
    "typescript"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@studnicky/circular-buffer": "workspace:*",
    "@studnicky/clock": "workspace:*",
    "@studnicky/entity": "workspace:*",
    "@studnicky/errors": "workspace:*",
    "@studnicky/json": "workspace:*",
    "@studnicky/pipeline": "workspace:*",
    "@studnicky/types": "workspace:*"
  },
  "devDependencies": {
    "@studnicky/example-smoke-kit": "workspace:*",
    "@studnicky/scenario-kit": "workspace:*"
  }
}
