{
  "cases": [
    {
      "name": "url-only",
      "description": "SocketExhaustionError creates an error with URL only",
      "shape": "url-only",
      "input": {
        "url": "https://api.example.com/data"
      },
      "expected": {
        "dispatcherStats": "__UNDEFINED__",
        "maximumConnections": 0,
        "pendingRequests": 0,
        "queuedRequests": 0,
        "url": "https://api.example.com/data"
      }
    },
    {
      "name": "with-stats",
      "description": "SocketExhaustionError creates an error with dispatcher stats",
      "shape": "with-stats",
      "input": {
        "url": "https://api.example.com/data",
        "stats": {
          "connected": 20,
          "free": 0,
          "pending": 15,
          "queued": 5,
          "running": 20,
          "size": 40
        }
      },
      "expected": {
        "dispatcherStats": {
          "connected": 20,
          "free": 0,
          "pending": 15,
          "queued": 5,
          "running": 20,
          "size": 40
        },
        "maximumConnections": 20,
        "pendingRequests": 15,
        "queuedRequests": 5,
        "url": "https://api.example.com/data"
      }
    },
    {
      "name": "message-includes-stats",
      "description": "SocketExhaustionError includes stats in the error message",
      "shape": "message-includes-stats",
      "input": {
        "url": "https://test.com/api",
        "stats": {
          "connected": 10,
          "free": 2,
          "pending": 5,
          "queued": 3,
          "running": 8,
          "size": 16
        }
      },
      "expected": {
        "messageIncludes": [
          "connected: 10",
          "free: 2",
          "pending: 5",
          "queued: 3",
          "increasing pool size"
        ]
      }
    },
    {
      "name": "catchable",
      "description": "SocketExhaustionError is catchable as Error",
      "shape": "catchable",
      "input": {
        "url": "https://test.com/api",
        "stats": {
          "connected": 5,
          "free": 0,
          "pending": 10,
          "queued": 0,
          "running": 5,
          "size": 15
        }
      },
      "expected": {
        "caughtName": "SocketExhaustionError",
        "url": "https://test.com/api"
      }
    },
    {
      "name": "property-types",
      "description": "SocketExhaustionError exposes the correct property types",
      "shape": "property-types",
      "input": {
        "url": "https://api.com/test",
        "stats": {
          "connected": 15,
          "free": 3,
          "pending": 8,
          "queued": 2,
          "running": 12,
          "size": 22
        }
      },
      "expected": {
        "dispatcherStatsType": "object",
        "freeConnectionsType": "number",
        "maximumConnectionsType": "number",
        "pendingRequestsType": "number",
        "queuedRequestsType": "number",
        "urlType": "string"
      }
    },
    {
      "name": "preserve-through-throw",
      "description": "SocketExhaustionError preserves its properties through throw and catch",
      "shape": "preserve-through-throw",
      "input": {
        "url": "https://api.com/test",
        "stats": {
          "connected": 10,
          "free": 0,
          "pending": 5,
          "queued": 0,
          "running": 10,
          "size": 15
        }
      },
      "expected": {
        "dispatcherStatsDefined": true,
        "freeConnections": 0,
        "maximumConnections": 10,
        "pendingRequests": 5,
        "url": "https://api.com/test"
      }
    }
  ]
}
