{
  "cases": [
    {
      "name": "queued-request-aborts-before-dispatch",
      "description": "TestDispatcher rejects a queued request that aborts before it reaches dispatch",
      "shape": "queued-request-aborts-before-dispatch",
      "input": {
        "longUrl": "http://127.0.0.1:41234/delay?ms=50",
        "queuedUrl": "http://127.0.0.1:41234/echo",
        "abortAfterMs": 5,
        "testDispatcher": {
          "connections": 1,
          "enabled": true
        }
      },
      "expected": {
        "origin": "http://127.0.0.1:41234",
        "longStatus": 200,
        "queuedErrorName": "AbortError",
        "queuedErrorMessage": "The operation was aborted.",
        "stats": {
          "connected": 1,
          "free": 1,
          "pending": 0,
          "queued": 0,
          "running": 0,
          "size": 0
        }
      }
    },
    {
      "name": "signal-aborted-before-wait",
      "description": "TestDispatcher rejects when the signal is already aborted",
      "shape": "signal-aborted-before-wait",
      "input": {
        "url": "http://127.0.0.1:41234/echo",
        "testDispatcher": {
          "connections": 1,
          "enabled": true
        }
      },
      "expected": {
        "origin": "http://127.0.0.1:41234",
        "queuedErrorName": "AbortError",
        "queuedErrorMessage": "The operation was aborted."
      }
    },
    {
      "name": "invalid-protocol",
      "description": "TestDispatcher rejects unsupported protocols",
      "shape": "invalid-protocol",
      "input": {
        "url": "ftp://example.test/resource",
        "testDispatcher": {
          "connections": 1,
          "enabled": true
        }
      },
      "expected": {
        "origin": "ftp://example.test",
        "errorCode": "ERR_INVALID_PROTOCOL",
        "errorMessage": "unsupported protocol ftp:"
      }
    },
    {
      "name": "enetunreach",
      "description": "TestDispatcher rejects unreachable networks",
      "shape": "enetunreach",
      "input": {
        "url": "http://192.0.2.10/ok",
        "testDispatcher": {
          "connections": 1,
          "enabled": true
        }
      },
      "expected": {
        "origin": "http://192.0.2.10",
        "errorCode": "ENETUNREACH",
        "errorMessage": "connect ENETUNREACH http://192.0.2.10"
      }
    },
    {
      "name": "enotfound",
      "description": "TestDispatcher rejects missing domains",
      "shape": "enotfound",
      "input": {
        "url": "http://does-not-exist.test/ok",
        "testDispatcher": {
          "connections": 1,
          "enabled": true
        }
      },
      "expected": {
        "origin": "http://does-not-exist.test",
        "errorCode": "ENOTFOUND",
        "errorMessage": "getaddrinfo ENOTFOUND http://does-not-exist.test"
      }
    },
    {
      "name": "ok",
      "description": "TestDispatcher returns text for /ok",
      "shape": "ok",
      "input": {
        "url": "http://127.0.0.1:41234/ok",
        "testDispatcher": {
          "connections": 1,
          "enabled": true
        }
      },
      "expected": {
        "origin": "http://127.0.0.1:41234",
        "status": 200,
        "body": "ok"
      }
    },
    {
      "name": "text-response",
      "description": "TestDispatcher returns text for unsupported paths",
      "shape": "text-response",
      "input": {
        "url": "http://127.0.0.1:41234/unhandled",
        "testDispatcher": {
          "connections": 1,
          "enabled": true
        }
      },
      "expected": {
        "origin": "http://127.0.0.1:41234",
        "status": 404,
        "body": "{\"error\":\"Not Found\"}"
      }
    },
    {
      "name": "url-echo",
      "description": "TestDispatcher echoes query parameters",
      "shape": "url-echo",
      "input": {
        "url": "http://127.0.0.1:41234/echo?x=1&y=two",
        "testDispatcher": {
          "connections": 1,
          "enabled": true
        }
      },
      "expected": {
        "origin": "http://127.0.0.1:41234",
        "status": 200,
        "body": {
          "query": {
            "x": "1",
            "y": "two"
          }
        }
      }
    },
    {
      "name": "post-echo",
      "description": "TestDispatcher echoes POST bodies and headers",
      "shape": "post-echo",
      "input": {
        "url": "http://127.0.0.1:41234/echo",
        "init": {
          "body": "{\"hello\":\"world\"}",
          "headers": {
            "x-custom": "value"
          },
          "method": "POST"
        },
        "testDispatcher": {
          "connections": 1,
          "enabled": true
        }
      },
      "expected": {
        "origin": "http://127.0.0.1:41234",
        "status": 200,
        "body": {
          "body": {
            "hello": "world"
          },
          "headers": {
            "x-custom": "value"
          }
        }
      }
    },
