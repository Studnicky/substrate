        "init": {
          "headers": {
            "content-type": "text/plain"
          },
          "method": "POST"
        },
        "testDispatcher": {
          "connections": 1,
          "enabled": true
        }
      },
      "expected": {
        "origin": "http://127.0.0.1:41234",
        "status": 200,
        "body": {
          "body": {},
          "headers": {
            "content-type": "text/plain"
          }
        }
      }
    },
