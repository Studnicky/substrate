    {
      "name": "post-blob",
      "description": "TestDispatcher rejects Blob request bodies",
      "shape": "post-blob",
      "input": {
        "url": "http://127.0.0.1:41234/echo",
        "body": "blob-body",
        "init": {
          "method": "POST"
        },
        "testDispatcher": {
          "connections": 1,
          "enabled": true
        }
      },
      "expected": {
        "errorCode": "errors.runtime",
        "origin": "http://127.0.0.1:41234",
        "errorMessage": "Blob request bodies are not supported in the fetch test dispatcher"
      }
    },
    {
      "name": "post-posts",
      "description": "TestDispatcher creates a post record",
      "shape": "post-posts",
      "input": {
        "url": "http://127.0.0.1:41234/posts",
        "init": {
          "body": "{\"title\":\"New Post\"}",
          "method": "POST"
        },
        "testDispatcher": {
          "connections": 1,
          "enabled": true
        }
      },
      "expected": {
        "origin": "http://127.0.0.1:41234",
        "status": 201,
        "body": {
          "title": "New Post",
          "id": 101
        }
      }
