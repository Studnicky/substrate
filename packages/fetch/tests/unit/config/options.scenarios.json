{
  "cases": [
    {
      "name": "options-undefined",
      "description": "ValidateOptions accepts undefined",
      "expected": {
        "kind": "ok"
      },
      "input": {
        "options": {
          "__kind": "undefined"
        }
      }
    },
    {
      "name": "options-null",
      "description": "ValidateOptions accepts null",
      "expected": {
        "kind": "ok"
      },
      "input": {
        "options": null
      }
    },
    {
      "name": "options-non-object",
      "description": "ValidateOptions rejects non-object values",
      "expected": {
        "kind": "throws",
        "messageIncludes": [
          "options must be an object"
        ]
      },
      "input": {
        "options": "invalid"
      }
    },
    {
      "name": "options-array",
      "description": "ValidateOptions rejects arrays",
      "expected": {
        "kind": "throws",
        "messageIncludes": [
          "options must be an object"
        ]
      },
      "input": {
        "options": []
      }
    },
    {
      "name": "options-body-object",
      "description": "ValidateOptions accepts body values without inspecting them",
      "expected": {
        "kind": "ok"
      },
      "input": {
        "options": {
          "body": {
            "nested": true
          }
        }
      }
    },
    {
      "name": "options-body-array",
      "description": "ValidateOptions accepts array body values without inspecting them",
      "expected": {
        "kind": "ok"
      },
      "input": {
        "options": {
          "body": [
            1,
            "two",
            null
          ]
        }
      }
    },
    {
