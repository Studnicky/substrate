{
  "cases": [
    {
      "name": "metadata-undefined",
      "description": "ValidateMetadata accepts undefined",
      "expected": {},
      "input": {
        "metadata": {
          "shape": "undefined"
        }
      },
      "outcome": "ok"
    },
    {
      "name": "metadata-null",
      "description": "FetchClient rejects null metadata through entity intake",
      "expected": {
        "messageIncludes": [
          "metadata"
        ]
      },
      "input": {
        "metadata": null
      },
      "outcome": "throws"
    },
    {
      "name": "metadata-valid-object",
      "description": "ValidateMetadata accepts plain objects",
      "expected": {},
      "input": {
        "metadata": {
          "service": "api",
          "version": 1,
          "nested": {
            "enabled": true
          }
        }
      },
      "outcome": "ok"
    },
    {
      "name": "metadata-array",
      "description": "ValidateMetadata rejects arrays",
      "expected": {
        "messageIncludes": [
          "metadata must be an object"
        ]
      },
      "input": {
        "metadata": []
      },
      "outcome": "throws"
    },
    {
      "name": "metadata-non-object",
      "description": "ValidateMetadata rejects non-object values",
      "expected": {
        "messageIncludes": [
          "metadata must be an object"
        ]
      },
      "input": {
        "metadata": "invalid"
      },
      "outcome": "throws"
    }
  ]
}
