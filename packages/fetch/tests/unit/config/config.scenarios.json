    },
    {
      "name": "headers-invalid-value",
      "description": "FetchClient rejects non-string header values",
      "shape": "headers-invalid-value",
      "input": {
        "fetchClient": {
          "headers": {
            "X-Custom": 123
          }
        }
      },
      "expected": {
        "shape": "throws",
        "messageIncludes": [
          "header value for \"X-Custom\" must be a string"
        ]
      }
    },
    {
      "name": "headers-valid",
      "description": "FetchClient accepts valid headers",
      "shape": "headers-valid",
      "input": {
        "fetchClient": {
          "headers": {
            "Authorization": "Bearer token"
          }
        }
      },
      "expected": {
        "shape": "ok"
      }
    },
    {
      "name": "params-non-object",
      "description": "FetchClient rejects non-object params",
