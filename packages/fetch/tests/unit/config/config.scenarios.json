{
  "cases": [
    {
      "name": "baseURL-non-string",
      "description": "FetchClient rejects non-string baseURL",
      "shape": "baseURL-non-string",
      "input": {
        "fetchClient": {
          "baseURL": 123
        }
      },
      "expected": {
        "shape": "throws",
        "messageIncludes": [
          "baseURL must be a string"
        ]
      }
    },
    {
      "name": "baseURL-empty",
      "description": "FetchClient rejects empty baseURL",
      "shape": "baseURL-empty",
      "input": {
        "fetchClient": {
          "baseURL": ""
        }
      },
      "expected": {
        "shape": "throws",
        "messageIncludes": [
          "baseURL must not be empty"
        ]
      }
    },
    {
      "name": "baseURL-invalid-url",
      "description": "FetchClient rejects invalid baseURL URLs",
      "shape": "baseURL-invalid-url",
      "input": {
        "fetchClient": {
          "baseURL": "not-a-valid-url"
        }
      },
      "expected": {
        "shape": "throws",
        "messageIncludes": [
          "baseURL must be a valid URL"
        ]
      }
    },
    {
      "name": "baseURL-valid",
      "description": "FetchClient accepts valid baseURL",
      "shape": "baseURL-valid",
      "input": {
        "fetchClient": {
          "baseURL": "https://api.example.com"
        }
      },
      "expected": {
        "shape": "ok"
      }
    },
    {
      "name": "headers-non-object",
