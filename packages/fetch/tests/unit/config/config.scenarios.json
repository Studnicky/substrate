      "name": "params-invalid-value",
      "description": "FetchClient rejects invalid param value types",
      "shape": "params-invalid-value",
      "input": {
        "fetchClient": {
          "params": {
            "invalid": {
              "nested": "object"
            }
          }
        }
      },
      "expected": {
        "shape": "throws",
        "messageIncludes": [
          "param value for \"invalid\" must be string, number, boolean, or array of these types"
        ]
      }
    },
    {
      "name": "params-valid",
      "description": "FetchClient accepts valid params",
      "shape": "params-valid",
      "input": {
        "fetchClient": {
          "params": {
            "key": "value",
            "page": 1,
            "active": true,
            "tags": [
              "javascript",
              "typescript"
            ],
            "other": null,
            "missing": {
              "shape": "undefined"
            }
          }
        }
      },
      "expected": {
        "shape": "ok"
      }
    },
