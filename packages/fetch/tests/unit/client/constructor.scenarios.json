{
  "cases": [
    {
      "name": "valid-no-config",
      "description": "FetchClient.create creates a client with no config",
      "kind": "valid-no-config",
      "input": {
        "fetchClient": {}
      },
      "expected": {
        "accepted": true
      }
    },
    {
      "name": "valid-baseURL",
      "description": "FetchClient.create creates a client with baseURL",
      "kind": "valid-baseURL",
      "input": {
        "fetchClient": {
          "baseURL": "https://api.example.com"
        }
      },
      "expected": {
        "accepted": true
      }
    },
    {
      "name": "valid-headers",
      "description": "FetchClient.create creates a client with default headers",
      "kind": "valid-headers",
      "input": {
        "fetchClient": {
          "headers": {
            "Authorization": "Bearer token"
          }
        }
      },
      "expected": {
        "accepted": true
      }
    },
    {
      "name": "valid-timeout",
      "description": "FetchClient.create creates a client with timeout",
      "kind": "valid-timeout",
      "input": {
        "fetchClient": {
          "timeout": 5000
        }
      },
      "expected": {
        "accepted": true
      }
    },
    {
      "name": "valid-dispatcher",
      "description": "FetchClient.create creates a client with dispatcher",
      "kind": "valid-dispatcher",
      "input": {
        "fetchClient": {
          "dispatcher": {
            "connections": 10,
            "enabled": true
          }
        }
      },
      "expected": {
        "accepted": true
      }
    },
    {
      "name": "valid-requestIdGenerator",
      "description": "FetchClient.create creates a client with custom requestIdGenerator",
      "kind": "valid-requestIdGenerator",
      "input": {
        "fetchClient": {
          "requestIdGenerator": {
            "kind": "static-request-id",
            "value": "custom-id"
          }
        }
      },
      "expected": {
        "accepted": true
      }
    },
    {
      "name": "valid-autoGenerateRequestId-false",
      "description": "FetchClient.create creates a client with autoGenerateRequestId disabled",
      "kind": "valid-autoGenerateRequestId-false",
      "input": {
        "fetchClient": {
          "autoGenerateRequestId": false
        }
      },
      "expected": {
        "accepted": true
      }
    },
    {
      "name": "valid-metadata",
      "description": "FetchClient.create creates a client with metadata",
      "kind": "valid-metadata",
      "input": {
        "fetchClient": {
          "metadata": {
            "service": "test-service",
            "version": "1.0.0"
          }
        }
      },
      "expected": {
        "accepted": true
      }
    },
    {
      "name": "valid-default-params",
      "description": "FetchClient.create creates a client with default params",
      "kind": "valid-default-params",
      "input": {
        "fetchClient": {
          "params": {
            "api_key": "test-key"
          }
        }
      },
      "expected": {
        "accepted": true
      }
    },
    {
      "name": "valid-fetch-options",
      "description": "FetchClient.create creates a client with fetch options",
      "kind": "valid-fetch-options",
      "input": {
        "fetchClient": {
          "options": {
            "credentials": "include"
          }
        }
      },
      "expected": {
        "accepted": true
      }
    },
    {
      "name": "invalid-baseURL",
      "description": "FetchClient.create rejects invalid baseURL",
      "kind": "invalid-baseURL",
      "input": {
        "fetchClient": {
          "baseURL": "not-a-valid-url"
        }
      },
      "expected": {
        "message": "baseURL must be a valid URL"
      }
    },
    {
      "name": "invalid-timeout-negative",
      "description": "FetchClient.create rejects negative timeout",
      "kind": "invalid-timeout-negative",
      "input": {
        "fetchClient": {
          "timeout": -1000
        }
      },
      "expected": {
        "message": "timeout must be positive"
      }
    },
    {
      "name": "invalid-timeout-non-numeric",
      "description": "FetchClient.create rejects non-numeric timeout",
      "kind": "invalid-timeout-non-numeric",
      "input": {
        "fetchClient": {
          "timeout": "not-a-number"
        }
      },
      "expected": {
        "message": "timeout must be a number"
      }
    },
    {
      "name": "invalid-headers-object",
      "description": "FetchClient.create rejects invalid headers object",
      "kind": "invalid-headers-object",
      "input": {
        "fetchClient": {
          "headers": "not-an-object"
        }
      },
      "expected": {
        "message": "headers must be an object"
      }
    },
    {
      "name": "invalid-unknown-keys",
      "description": "FetchClient.create rejects unknown configuration keys",
      "kind": "invalid-unknown-keys",
      "input": {
        "fetchClient": {
          "unknownKey": "value"
        }
      },
      "expected": {
        "message": "\"unknownKey\" is not declared in the schema"
      }
    },
    {
      "name": "invalid-requestIdGenerator",
      "description": "FetchClient.create rejects invalid requestIdGenerator",
      "kind": "invalid-requestIdGenerator",
      "input": {
        "fetchClient": {
          "requestIdGenerator": "not-a-function"
        }
      },
      "expected": {
        "message": "requestIdGenerator must be a function"
      }
    },
    {
      "name": "invalid-requestIdGenerator-return-type",
      "description": "FetchClient.create rejects requestIdGenerator return values that are not strings",
      "kind": "invalid-requestIdGenerator-return-type",
      "input": {
        "fetchClient": {
          "requestIdGenerator": {
            "kind": "static-request-id",
            "value": 123
          }
        }
      },
      "expected": {
        "message": "requestIdGenerator must return a string"
      }
    },
    {
      "name": "invalid-requestIdGenerator-throws",
      "description": "FetchClient.create rejects requestIdGenerator functions that throw",
      "kind": "invalid-requestIdGenerator-throws",
      "input": {
        "fetchClient": {
          "requestIdGenerator": {
            "kind": "throwing-request-id",
            "message": "request-id boom"
          }
        }
      },
      "expected": {
        "message": "requestIdGenerator function error: request-id boom"
      }
    },
    {
      "name": "behavior-baseURL",
      "description": "FetchClient applies baseURL to requests",
      "kind": "behavior-baseURL",
      "input": {
        "fetchClient": {
          "baseURL": "https://example.test"
        },
        "requestPath": "/posts/1"
      },
      "expected": {
        "requestUrl": "https://example.test/posts/1",
        "status": 200,
        "body": {
          "id": 1,
          "title": "Test Post"
        }
      }
    },
    {
      "name": "behavior-default-timeout",
      "description": "FetchClient applies default timeout to requests",
      "kind": "behavior-default-timeout",
      "input": {
        "fetchClient": {
          "baseURL": "https://example.test",
          "timeout": 100
        },
        "requestPath": "/delay"
      },
      "expected": {
        "errorName": "TimeoutError",
        "timeoutMs": 100
      }
    },
    {
      "name": "behavior-custom-requestIdGenerator",
      "description": "FetchClient uses custom requestIdGenerator",
      "kind": "behavior-custom-requestIdGenerator",
      "input": {
        "fetchClient": {
          "baseURL": "https://example.test",
          "requestIdGenerator": {
            "kind": "static-request-id",
            "value": "custom-test-id"
          }
        },
        "requestPath": "/posts/1"
      },
      "expected": {
        "body": {
          "id": 1,
          "title": "Test Post"
        },
        "requestId": "custom-test-id"
      }
    },
    {
      "name": "behavior-explicit-requestId",
      "description": "FetchClient keeps explicit requestId values",
      "kind": "behavior-explicit-requestId",
      "input": {
        "fetchClient": {
          "baseURL": "https://example.test",
          "autoGenerateRequestId": false
        },
        "requestPath": "/posts/1"
      },
      "expected": {
        "body": {
          "id": 1,
          "title": "Test Post"
        },
        "requestId": "manual-test-id"
      }
    },
    {
      "name": "behavior-metadata-merge",
      "description": "FetchClient merges default metadata with request metadata",
      "kind": "behavior-metadata-merge",
      "input": {
        "fetchClient": {
          "baseURL": "https://example.test",
          "metadata": {
            "service": "test-service"
          }
        },
        "requestPath": "/posts/1",
        "requestMetadata": {
          "operation": "get-post"
        }
      },
      "expected": {
        "body": {
          "id": 1,
          "title": "Test Post"
        },
        "metadata": {
          "service": "test-service",
          "operation": "get-post"
        }
      }
    },
    {
      "name": "behavior-detach-mutable-config",
      "description": "FetchClient detaches construction config from caller-owned mutable data",
      "kind": "behavior-detach-mutable-config",
      "input": {
        "fetchClient": {
          "baseURL": "https://example.test",
          "headers": {
            "X-Client": "initial-client"
          },
          "metadata": {
            "details": {
              "version": 1
            }
          },
          "options": {
            "headers": {
              "X-Option": "initial-option"
            },
            "json": {
              "nested": {
                "value": "initial-json"
              }
            },
            "metadata": {
              "details": {
                "enabled": true
              }
            }
          },
          "params": {
            "tag": [
              "one",
              "two"
            ]
          }
        },
        "requestPath": "/posts/1",
        "replacementFetchClient": {
          "baseURL": "http://127.0.0.1:1",
          "headers": {
            "X-Client": "replacement-client"
          },
          "metadata": {
            "details": {
              "version": 3
            }
          },
          "options": {
            "headers": {
              "X-Option": "replacement-option"
            }
          },
          "params": {
            "tag": [
              "replacement"
            ]
          }
        }
      },
      "expected": {
        "url": "https://example.test/posts/1?tag=one&tag=two",
        "metadata": {
          "details": {
            "version": 1
          }
        },
        "headers": {
          "X-Client": "initial-client",
          "X-Option": "initial-option"
        },
        "optionsMetadata": {
          "details": {
            "enabled": true
          }
        },
        "json": {
          "nested": {
            "value": "initial-json"
          }
        },
        "params": {
          "kind": "undefined"
        }
      }
    },
    {
      "name": "behavior-preserve-non-plain-json",
      "description": "FetchClient preserves non-plain json values without cloning them",
      "kind": "behavior-preserve-non-plain-json",
      "input": {
        "fetchClient": {
          "baseURL": "https://example.test"
        },
        "requestPath": "/posts/1",
        "boxedJson": {
          "value": "initial-json",
          "mutatedValue": "mutated-json"
        }
      },
      "expected": {
        "json": {
          "kind": "boxed-json",
          "value": "mutated-json"
        }
      }
    },
    {
      "name": "behavior-preserve-null-prototype-json",
      "description": "FetchClient preserves null-prototype json values without changing their shape",
      "kind": "behavior-preserve-null-prototype-json",
      "input": {
        "fetchClient": {
          "baseURL": "https://example.test"
        },
        "requestPath": "/posts/1",
        "nullPrototypeJson": {
          "items": [
            {
              "value": "initial"
            }
          ],
          "label": "initial-label"
        },
        "mutatedNullPrototypeJson": {
          "items": [
            {
              "value": "mutated"
            }
          ],
          "label": "mutated-label"
        }
      },
      "expected": {
        "json": {
          "items": [
            {
              "value": "initial"
            }
          ],
          "label": "initial-label"
        }
      }
    }
  ]
}
