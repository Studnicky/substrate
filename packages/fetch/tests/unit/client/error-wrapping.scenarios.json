{
  "cases": [
    {
      "name": "wrap-no-code",
      "description": "wrapUndiciError returns undefined when the error has no code",
      "shape": "wrap-no-code",
      "input": {
        "url": "https://example.test/ok",
        "fetchClient": {
          "baseURL": "https://example.test"
        }
      },
      "expected": {
        "shape": "undefined"
      }
    },
    {
      "name": "wrap-unknown-code",
      "description": "wrapUndiciError returns undefined for unknown error codes",
      "shape": "wrap-unknown-code",
      "input": {
        "errorCode": "UND_ERR_SOMETHING_ELSE",
        "url": "https://example.test/ok",
        "fetchClient": {
          "baseURL": "https://example.test"
        }
      },
      "expected": {
        "shape": "undefined"
      }
    },
    {
      "name": "handle-no-dispatcher",
      "description": "handleSocketExhaustion returns undefined when dispatcher is absent",
      "shape": "handle-no-dispatcher",
      "input": {
        "errorCode": "UND_ERR_CONNECT_TIMEOUT",
        "url": "https://example.test/ok",
        "fetchClient": {
          "baseURL": "https://example.test"
        }
      },
      "expected": {
        "shape": "undefined"
      }
    },
    {
      "name": "handle-invalid-origin",
      "description": "handleSocketExhaustion returns undefined when origin extraction fails",
      "shape": "handle-invalid-origin",
      "input": {
        "errorCode": "UND_ERR_CONNECT_TIMEOUT",
        "url": "not-a-valid-url",
        "fetchClient": {
          "baseURL": "https://example.test",
          "dispatcher": {
            "connections": 2,
            "enabled": true
          }
        }
      },
      "expected": {
        "shape": "undefined"
      }
    },
    {
      "name": "handle-dispatcher-health",
      "description": "handleSocketExhaustion creates a SocketExhaustionError when health stats are available",
      "shape": "handle-dispatcher-health",
      "input": {
        "errorCode": "UND_ERR_CONNECT_TIMEOUT",
        "url": "https://example.test/ok",
        "fetchClient": {
          "baseURL": "https://example.test",
          "dispatcher": {
            "connections": 2,
            "enabled": true
          }
        }
      },
      "expected": {
        "shape": "socket-exhaustion"
      }
    },
    {
      "name": "wrap-connect-timeout",
      "description": "wrapUndiciError maps connect timeout errors",
      "shape": "wrap-connect-timeout",
      "input": {
        "errorCode": "UND_ERR_CONNECT_TIMEOUT",
        "url": "not-a-valid-url",
        "fetchClient": {
          "baseURL": "https://example.test",
          "dispatcher": {
            "connections": 2,
            "enabled": true
          }
        }
      },
      "expected": {
        "shape": "error",
        "errorName": "ConnectTimeoutError"
      }
    },
    {
      "name": "wrap-body-timeout",
      "description": "wrapUndiciError maps body timeout errors",
      "shape": "wrap-body-timeout",
      "input": {
        "errorCode": "UND_ERR_BODY_TIMEOUT",
        "url": "https://example.test/ok",
        "fetchClient": {
          "baseURL": "https://example.test",
          "dispatcher": {
            "connections": 2,
            "enabled": true
          }
        }
      },
      "expected": {
        "shape": "error",
        "errorName": "BodyTimeoutError"
      }
    },
    {
      "name": "wrap-headers-timeout",
      "description": "wrapUndiciError maps headers timeout errors",
      "shape": "wrap-headers-timeout",
      "input": {
        "errorCode": "UND_ERR_HEADERS_TIMEOUT",
        "url": "https://example.test/ok",
        "fetchClient": {
          "baseURL": "https://example.test",
          "dispatcher": {
            "connections": 2,
            "enabled": true
          }
        }
      },
      "expected": {
        "shape": "error",
        "errorName": "HeadersTimeoutError"
      }
    },
    {
      "name": "wrap-socket-error",
      "description": "wrapUndiciError maps socket errors",
      "shape": "wrap-socket-error",
      "input": {
        "errorCode": "UND_ERR_SOCKET",
        "url": "https://example.test/ok",
        "fetchClient": {
          "baseURL": "https://example.test",
          "dispatcher": {
            "connections": 2,
            "enabled": true
          }
        }
      },
      "expected": {
        "shape": "error",
        "errorName": "SocketError"
      }
    }
  ]
}
