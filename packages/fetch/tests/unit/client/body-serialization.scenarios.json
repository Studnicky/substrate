{
  "cases": [
    {
      "name": "plain-object-post",
      "description": "FetchClient serializes a plain object via POST",
      "input": {
        "request": {
          "method": "POST",
          "path": "/posts",
          "body": {
            "baz": 123,
            "foo": "bar"
          }
        }
      },
      "expected": {
        "status": 201,
        "json": {
          "baz": 123,
          "foo": "bar",
          "id": 101
        }
      }
    },
    {
      "name": "plain-object-put",
      "description": "FetchClient serializes a plain object via PUT",
      "input": {
        "request": {
          "method": "PUT",
          "path": "/posts/1",
          "body": {
            "baz": 123,
            "foo": "bar"
          }
        }
      },
      "expected": {
        "status": 200,
        "json": {
          "baz": 123,
          "foo": "bar",
          "id": 1
        }
      }
    },
    {
      "name": "plain-object-patch",
      "description": "FetchClient serializes a plain object via PATCH",
      "input": {
        "request": {
          "method": "PATCH",
          "path": "/posts/1",
          "body": {
            "baz": 123,
            "foo": "bar"
          }
        }
      },
      "expected": {
        "status": 200,
        "json": {
          "baz": 123,
          "foo": "bar",
          "id": 1,
          "title": "Test Post"
        }
      }
    },
