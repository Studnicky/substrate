{
  "cases": [
    {
      "description": "Fetch request options entity accepts valid schema-expressible data",
      "expected": {
        "validationResults": [
          true
        ]
      },
      "input": {
        "validations": [
          {
            "entity": "FetchRequestOptionsEntity",
            "expected": true,
            "value": {
              "cache": "no-store",
              "keepalive": true,
              "method": "GET",
              "timeout": 500
            }
          }
        ]
      },
      "shape": "request-options-valid",
      "name": "request-options-valid"
    },
    {
      "description": "Fetch request options entity rejects invalid schema-expressible data",
      "expected": {
        "validationResults": [
          false
        ]
      },
      "input": {
        "validations": [
          {
            "entity": "FetchRequestOptionsEntity",
            "expected": false,
            "value": { "redirect": "elsewhere" }
          }
        ]
      },
      "shape": "request-options-invalid",
      "name": "request-options-invalid"
    },
    {
      "description": "Client config entity accepts valid schema-expressible data",
      "expected": {
        "validationResults": [
          true
        ]
      },
      "input": {
        "validations": [
          {
            "entity": "ClientConfigDataEntity",
            "expected": true,
            "value": {
              "autoGenerateRequestId": true,
              "baseURL": "https://example.test",
              "hookTimeoutMs": 100,
              "timeout": 500
            }
          }
        ]
      },
      "shape": "client-config-valid",
      "name": "client-config-valid"
    },
    {
      "description": "Client config entity rejects invalid schema-expressible data",
      "expected": {
        "validationResults": [
          false
        ]
      },
      "input": {
        "validations": [
          {
            "entity": "ClientConfigDataEntity",
            "expected": false,
            "value": { "timeout": -1 }
          }
        ]
      },
      "shape": "client-config-invalid",
      "name": "client-config-invalid"
    },
    {
      "description": "Query parameters entity accepts scalar values and scalar arrays",
      "expected": {
        "validationResults": [
          true
        ]
      },
      "input": {
        "validations": [
          {
            "entity": "QueryParametersEntity",
            "expected": true,
            "value": {
              "archived": false,
              "page": 1,
              "tags": [
                "typescript",
                null
              ]
            }
          }
        ]
      },
      "shape": "query-parameters-valid",
      "name": "query-parameters-valid"
    },
    {
      "description": "Query parameters entity rejects nested object values",
      "expected": {
        "validationResults": [
          false
        ]
      },
      "input": {
        "validations": [
          {
            "entity": "QueryParametersEntity",
            "expected": false,
            "value": {
              "filter": {
                "status": "active"
              }
            }
          }
        ]
      },
      "shape": "query-parameters-invalid",
      "name": "query-parameters-invalid"
    }
  ]
}
