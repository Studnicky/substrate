{
  "cases": [
    {
      "description": "Fetch request options entity accepts valid schema-expressible data",
      "expected": {
        "validationResults": [
          true
        ]
      },
      "input": {
        "validations": [
          {
            "entity": "FetchRequestOptionsEntity",
            "expected": true,
            "value": {
              "cache": "no-store",
              "keepalive": true,
              "method": "GET",
              "timeout": 500
            }
          }
        ]
      },
      "shape": "request-options-valid",
      "name": "request-options-valid"
    },
    {
      "description": "Fetch request options entity rejects invalid schema-expressible data",
      "expected": {
        "validationResults": [
          false
        ]
      },
      "input": {
        "validations": [
          {
            "entity": "FetchRequestOptionsEntity",
            "expected": false,
            "value": { "redirect": "elsewhere" }
          }
        ]
      },
      "shape": "request-options-invalid",
      "name": "request-options-invalid"
    },
    {
      "description": "Client config entity accepts valid schema-expressible data",
