        "validationResults": [
          true
        ]
      },
      "input": {
        "validations": [
          {
            "entity": "ClientConfigDataEntity",
            "expected": true,
            "value": {
              "autoGenerateRequestId": true,
              "baseURL": "https://example.test",
              "hookTimeoutMs": 100,
              "timeout": 500
            }
          }
        ]
      },
      "shape": "client-config-valid",
      "name": "client-config-valid"
    },
    {
      "description": "Client config entity rejects invalid schema-expressible data",
      "expected": {
        "validationResults": [
          false
        ]
      },
      "input": {
        "validations": [
          {
            "entity": "ClientConfigDataEntity",
            "expected": false,
            "value": { "timeout": -1 }
          }
        ]
      },
      "shape": "client-config-invalid",
      "name": "client-config-invalid"
    }
  ]
