{
  "cases": [
    {
      "name": "get-request",
      "description": "FetchClient performs GET requests",
      "input": {
        "path": "/posts/1"
      },
      "expected": {
        "status": 200
      },
      "shape": "GET"
    },
    {
      "name": "post-json",
      "description": "FetchClient performs POST requests with JSON bodies",
      "input": {
        "path": "/posts",
        "body": {
          "body": "content",
          "title": "test",
          "userId": 1
        }
      },
      "expected": {
        "status": 201,
        "json": {
          "body": "content",
          "id": 101,
          "title": "test",
          "userId": 1
        }
      },
      "shape": "POST"
    },
    {
      "name": "put-request",
      "description": "FetchClient performs PUT requests",
      "input": {
        "path": "/posts/1",
        "body": {
          "body": "content",
          "id": 1,
          "title": "updated",
          "userId": 1
        }
      },
      "expected": {
        "status": 200,
        "json": {
          "body": "content",
          "id": 1,
          "title": "updated",
          "userId": 1
        }
      },
      "shape": "PUT"
    },
    {
      "name": "patch-request",
      "description": "FetchClient performs PATCH requests",
      "input": {
        "path": "/posts/1",
        "body": {
          "title": "patched"
        }
      },
      "expected": {
        "status": 200,
        "json": {
          "id": 1,
          "title": "Test Post"
        }
      },
      "shape": "PATCH"
    },
    {
      "name": "delete-request",
      "description": "FetchClient performs DELETE requests",
      "input": {
        "path": "/posts/1"
      },
      "expected": {
        "status": 200
      },
      "shape": "DELETE"
    },
    {
      "name": "head-request",
      "description": "FetchClient performs HEAD requests",
      "input": {
        "path": "/posts/1"
      },
      "expected": {
        "status": 200
      },
      "shape": "HEAD"
    },
    {
      "name": "options-request",
      "description": "FetchClient performs OPTIONS requests",
      "input": {
        "path": "/posts/1"
      },
      "expected": {
        "status": 200
      },
      "shape": "OPTIONS"
    }
  ]
}
