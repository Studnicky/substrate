{
  "cases": [
    {
      "name": "small-timeout",
      "description": "FetchClient times out on a very small timeout",
      "input": {
        "request": {
          "timeout": 1,
          "url": "__TEST_URL__/posts/1"
        }
      },
      "expected": {
        "error": "TimeoutError",
        "timeoutMs": 1
      },
      "shape": "rejects"
    },
    {
      "name": "moderate-timeout",
      "description": "FetchClient completes with a moderate timeout",
      "input": {
        "request": {
          "timeout": 1000,
          "url": "__TEST_URL__/posts/1"
        }
      },
      "expected": {
        "status": 200
      },
      "shape": "status"
    },
    {
      "name": "large-timeout",
      "description": "FetchClient completes with a large timeout",
      "input": {
        "request": {
          "timeout": 60000,
          "url": "__TEST_URL__/posts/1"
        }
      },
      "expected": {
        "status": 200
      },
      "shape": "status"
    },
    {
      "name": "negative-timeout",
      "description": "FetchClient rejects a negative timeout",
      "input": {
        "clientConfig": {
          "timeout": -1
        }
      },
      "expected": {
        "messageIncludes": [
          "positive"
        ]
      },
      "shape": "create-throws"
    },
    {
      "name": "infinity-timeout",
      "description": "FetchClient rejects an infinite timeout",
      "input": {
        "clientConfig": {
          "timeout": {
            "shape": "infinity"
          }
        }
      },
      "expected": {
        "messageIncludes": [
          "finite"
        ]
      },
      "shape": "create-throws"
    },
    {
      "name": "string-timeout",
      "description": "FetchClient rejects a string timeout",
      "input": {
        "clientConfig": {
          "timeout": "1000"
        }
      },
      "expected": {
        "messageIncludes": [
          "number"
        ]
      },
      "shape": "create-throws"
    },
    {
      "name": "object-timeout",
      "description": "FetchClient rejects an object timeout",
      "input": {
        "clientConfig": {
          "timeout": {}
        }
      },
      "expected": {
        "messageIncludes": [
          "number"
        ]
      },
      "shape": "create-throws"
    },
    {
      "name": "null-timeout",
      "description": "FetchClient rejects a null timeout through entity intake",
      "input": {
        "clientConfig": {
          "timeout": null
        }
      },
      "expected": {
        "messageIncludes": [
          "timeout"
        ]
      },
      "shape": "create-throws"
    },
    {
      "name": "undefined-timeout",
      "description": "FetchClient accepts an undefined timeout",
      "input": {
        "clientConfig": {
          "timeout": {
            "shape": "undefined"
          }
        }
      },
      "expected": {},
      "shape": "create-ok"
    },
    {
      "name": "nan-timeout",
      "description": "FetchClient rejects NaN timeout",
      "input": {
        "clientConfig": {
          "timeout": {
            "shape": "nan"
          }
        }
      },
      "expected": {
        "messageIncludes": [
          "finite"
        ]
      },
      "shape": "create-throws"
    },
    {
      "name": "zero-timeout",
      "description": "FetchClient rejects a zero timeout",
      "input": {
        "clientConfig": {
          "baseURL": "__TEST_URL__",
          "timeout": 0
        }
      },
      "expected": {
        "messageIncludes": [
          "positive"
        ]
      },
      "shape": "create-throws"
    },
    {
      "name": "timeout-during-slow-request",
      "description": "FetchClient times out during a slow request",
      "input": {
        "request": {
          "timeout": 100,
          "url": "__TEST_URL__/delay"
        }
      },
      "expected": {
        "error": "TimeoutError",
        "timeoutMs": 100
      },
      "shape": "rejects"
    },
    {
      "name": "timeout-does-not-fire-for-fast-request",
      "description": "FetchClient completes a fast request before timeout",
      "input": {
        "request": {
          "timeout": 5000,
          "url": "__TEST_URL__/posts/1"
        }
      },
      "expected": {
        "status": 200
      },
      "shape": "status"
    },
    {
      "name": "subsequent-after-timeout",
      "description": "FetchClient continues working after a timeout",
      "input": {},
      "expected": {
        "steps": [
          {
            "expect": {
              "error": "TimeoutError",
              "shape": "rejects",
              "timeoutMs": 50
            },
            "request": {
              "timeout": 50,
              "url": "__TEST_URL__/delay"
            }
          },
          {
            "expect": {
              "shape": "status",
              "status": 200
            },
            "request": {
              "timeout": 5000,
              "url": "__TEST_URL__/posts/1"
            }
          }
        ]
      },
      "shape": "sequence"
    },
    {
      "name": "concurrent-timeouts",
      "description": "FetchClient handles concurrent requests with mixed results",
      "input": {},
      "expected": {
        "steps": [
          {
            "expect": {
              "error": "TimeoutError",
              "shape": "rejects",
              "timeoutMs": 50
            },
            "request": {
              "timeout": 50,
              "url": "__TEST_URL__/delay"
            }
          },
          {
            "expect": {
              "error": "TimeoutError",
              "shape": "rejects",
              "timeoutMs": 60
            },
            "request": {
              "timeout": 60,
              "url": "__TEST_URL__/delay"
            }
          },
          {
            "expect": {
              "shape": "status",
              "status": 200
            },
            "request": {
              "timeout": 5000,
              "url": "__TEST_URL__/posts/1"
            }
          }
        ]
      },
      "shape": "parallel"
    },
    {
      "name": "different-timeouts",
      "description": "FetchClient handles different timeout values on sequential requests",
      "input": {
        "clientConfig": {
          "baseURL": "__TEST_URL__"
        }
      },
      "expected": {
        "steps": [
          {
            "expect": {
              "error": "TimeoutError",
              "shape": "rejects",
              "timeoutMs": 50
            },
            "request": {
              "timeout": 50,
              "url": "/delay"
            }
          },
          {
            "expect": {
              "shape": "status",
              "status": 200
            },
            "request": {
              "timeout": 5000,
              "url": "/posts/1"
            }
          }
        ]
      },
      "shape": "sequence"
    },
    {
      "name": "default-client-timeout",
      "description": "FetchClient uses the client default timeout",
      "input": {
        "clientConfig": {
          "baseURL": "__TEST_URL__",
          "timeout": 50
        },
        "request": {
          "url": "/delay"
        }
      },
      "expected": {
        "error": "TimeoutError",
        "timeoutMs": 50
      },
      "shape": "rejects"
    },
    {
      "name": "request-overrides-client-timeout",
      "description": "FetchClient lets the request timeout override the client default",
      "input": {
        "clientConfig": {
          "baseURL": "__TEST_URL__",
          "timeout": 50
        },
        "request": {
          "timeout": 5000,
          "url": "/posts/1"
        }
      },
      "expected": {
        "status": 200
      },
      "shape": "status"
    },
    {
      "name": "includes-url",
      "description": "TimeoutError includes the request URL",
      "input": {
        "request": {
          "timeout": 50,
          "url": "__TEST_URL__/delay"
        }
      },
      "expected": {
        "error": "TimeoutError",
        "urlIncludes": "/delay"
      },
      "shape": "rejects"
    },
    {
      "name": "includes-timeout-value",
      "description": "TimeoutError includes the timeout value",
      "input": {
        "request": {
          "timeout": 123,
          "url": "__TEST_URL__/delay"
        }
      },
      "expected": {
        "error": "TimeoutError",
        "timeoutMs": 123
      },
      "shape": "rejects"
    },
    {
      "name": "error-name",
      "description": "TimeoutError reports the TimeoutError name",
      "input": {
        "request": {
          "timeout": 50,
          "url": "__TEST_URL__/delay"
        }
      },
      "expected": {
        "error": "TimeoutError"
      },
      "shape": "rejects"
    },
    {
      "name": "implicit-abort-controller",
      "description": "TimeoutError creates an implicit AbortController",
      "input": {
        "request": {
          "timeout": 50,
          "url": "__TEST_URL__/delay"
        }
      },
      "expected": {
        "error": "TimeoutError"
      },
      "shape": "rejects"
    },
    {
      "name": "explicit-signal-overrides-timeout",
      "description": "An explicit signal overrides timeout behavior",
      "input": {
        "request": {
          "signal": {
            "delayMs": 100,
            "shape": "abort-after-ms"
          },
          "timeout": 5000,
          "url": "__TEST_URL__/delay"
        }
      },
      "expected": {
        "error": "AbortError"
      },
      "shape": "rejects"
    },
    {
      "name": "integer-timeout",
      "description": "FetchClient accepts integer timeout values",
      "input": {
        "request": {
          "timeout": 50,
          "url": "__TEST_URL__/delay"
        }
      },
      "expected": {
        "error": "TimeoutError"
      },
      "shape": "rejects"
    },
    {
      "name": "fractional-timeout",
      "description": "FetchClient rejects a fractional timeout at the request boundary",
      "input": {
        "request": {
          "timeout": 50.5,
          "url": "__TEST_URL__/delay"
        }
      },
      "expected": {
        "error": "Error",
        "messageIncludes": [
          "integer"
        ]
      },
      "shape": "rejects"
    }
  ]
}
