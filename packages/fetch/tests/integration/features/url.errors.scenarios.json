    {
      "name": "empty-request-url",
      "description": "FetchClient rejects an empty request URL",
      "input": {
        "request": {
          "url": ""
        }
      },
      "expected": {
        "error": "Error",
        "shape": "rejects"
      }
    },
    {
      "name": "spaces-in-url",
      "description": "FetchClient rejects a request URL with spaces",
      "input": {
        "request": {
          "url": "http://invalid url with spaces.com/api"
        }
      },
      "expected": {
        "error": "TypeError",
        "shape": "rejects",
        "messageIncludes": [
          "url"
        ]
      }
    },
    {
      "name": "whitespace-url",
