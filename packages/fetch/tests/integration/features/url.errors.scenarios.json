    {
      "name": "auth-username-password",
      "description": "FetchClient rejects a URL with username and password before any request reaches the network",
      "input": {
        "request": {
          "url": "http://user:pass@127.0.0.1:41234/posts/1"
        }
      },
      "expected": {
        "error": "TypeError",
        "shape": "rejects-native",
        "messageIncludes": [
          "credentials"
        ]
      }
    },
