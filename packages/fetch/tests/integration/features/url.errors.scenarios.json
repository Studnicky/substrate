{
  "cases": [
    {
      "name": "baseurl-empty-string",
      "description": "FetchClient rejects an empty baseURL",
      "input": {
        "clientConfig": {
          "baseURL": ""
        }
      },
      "expected": {
        "shape": "create-throws",
        "messageIncludes": [
          "baseurl",
          "url"
        ]
      }
    },
    {
      "name": "baseurl-invalid-format",
      "description": "FetchClient rejects an invalid baseURL format",
      "input": {
        "clientConfig": {
          "baseURL": "not-a-url"
        }
      },
      "expected": {
        "shape": "create-throws",
        "messageIncludes": [
          "baseurl",
          "url"
        ]
      }
    },
    {
      "name": "baseurl-missing-protocol",
      "description": "FetchClient rejects a baseURL without protocol",
      "input": {
