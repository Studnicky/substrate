{
  "cases": [
    {
      "name": "invalid-connections-negative",
      "description": "validateDispatcher rejects negative connections",
      "shape": "invalid-config",
      "input": {
        "dispatcher": {
          "connections": -1
        }
      },
      "expected": {
        "error": "ConfigurationError"
      }
    },
    {
      "name": "invalid-connections-zero",
      "description": "validateDispatcher rejects zero connections",
      "shape": "invalid-config",
      "input": {
        "dispatcher": {
          "connections": 0
        }
      },
      "expected": {
        "error": "ConfigurationError"
      }
    },
    {
      "name": "invalid-connections-string",
