        }
      },
      "expected": {
        "error": "ConfigurationError"
      }
    },
    {
      "name": "invalid-connections-infinity",
      "description": "validateDispatcher rejects infinite connections",
      "shape": "invalid-config",
      "input": {
        "dispatcher": {
          "connections": {
            "__shape": "infinity"
          }
        }
      },
      "expected": {
        "error": "ConfigurationError"
      }
    },
    {
      "name": "invalid-connections-nan",
      "description": "validateDispatcher rejects NaN connections",
      "shape": "invalid-config",
      "input": {
        "dispatcher": {
          "connections": {
            "__shape": "nan"
          }
        }
      },
      "expected": {
        "error": "ConfigurationError"
      }
    },
    {
      "name": "many-concurrent-requests",
      "description": "a small pool still serves many concurrent requests",
      "shape": "many-concurrent-requests",
      "input": {
        "batch": {
          "requestCount": 10
        },
        "dispatcher": {
          "connections": 2
        }
      },
      "expected": {
        "statuses": [
          200,
          200,
          200,
          200,
          200,
          200,
          200,
          200,
          200,
          200
        ]
      }
    },
    {
      "name": "queue-requests-when-pool-is-full",
      "description": "a full pool queues requests",
      "shape": "queue-requests-when-pool-is-full",
      "input": {
        "dispatcher": {
          "connections": 1,
          "pipelining": 1
        }
      },
      "expected": {
        "fulfilled": 3
      }
    },
    {
      "name": "mixed-success-timeout-with-limited-connections",
      "description": "mixed success and timeout requests complete with limited connections",
      "shape": "mixed-success-timeout-with-limited-connections",
      "input": {
        "dispatcher": {
          "connections": 2
        }
      },
      "expected": {
        "results": [
          "timeout1",
          200,
          "timeout2",
          200
        ]
      }
    },
    {
      "name": "network-refused",
      "description": "connection refused errors surface through the pool",
      "shape": "network-refused",
      "input": {
        "dispatcher": {
          "connections": 5
        }
      },
      "expected": {
        "error": "connect"
      }
    },
    {
      "name": "dns-failure",
      "description": "DNS resolution failures surface through the pool",
      "shape": "dns-failure",
      "input": {
        "dispatcher": {
          "connections": 5
        }
      },
      "expected": {
        "error": "getaddrinfo"
      }
    },
    {
      "name": "isolates-network-errors",
      "description": "network errors stay isolated from successful requests",
      "shape": "isolates-network-errors",
      "input": {
        "dispatcher": {
          "connections": 5
        }
      },
      "expected": {
        "statuses": [
          "rejected",
          "fulfilled",
          "rejected",
          "fulfilled"
        ]
      }
    },
    {
      "name": "pool-after-network-error",
      "description": "the pool stays functional after a network error",
      "shape": "pool-after-network-error",
      "input": {
        "dispatcher": {
          "connections": 2
        }
      },
      "expected": {
        "status": 200
      }
    },
    {
      "name": "pool-after-timeout",
      "description": "the pool stays functional after a timeout",
      "shape": "pool-after-timeout",
      "input": {
        "dispatcher": {
          "connections": 2
        }
      },
      "expected": {
        "status": 200
      }
    },
    {
      "name": "sequential-errors",
      "description": "the pool handles multiple sequential timeouts",
      "shape": "sequential-errors",
      "input": {
        "repeats": 5,
        "dispatcher": {
          "connections": 2
        }
      },
      "expected": {
        "status": 200
      }
    },
    {
      "name": "many-concurrent-timeouts",
      "description": "the pool handles many concurrent timeouts",
      "shape": "many-concurrent-timeouts",
      "input": {
        "batch": {
          "requestCount": 10
        },
        "dispatcher": {
          "connections": 5
        }
      },
      "expected": {
        "results": [
          "timeout",
          "timeout",
          "timeout",
          "timeout",
          "timeout",
          "timeout",
          "timeout",
          "timeout",
          "timeout",
          "timeout"
        ]
      }
    },
    {
      "name": "many-concurrent-network-errors",
      "description": "the pool handles many concurrent network errors",
