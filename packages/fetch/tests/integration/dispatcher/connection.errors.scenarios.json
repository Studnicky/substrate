      "input": {
        "batch": {
          "requestCount": 10
        },
        "dispatcher": {
          "connections": 5
        }
      },
      "expected": {
        "results": [
          "error",
          "error",
          "error",
          "error",
          "error",
          "error",
          "error",
          "error",
          "error",
          "error"
        ]
      }
    },
    {
      "name": "mixed-errors-successes",
      "description": "the pool handles mixed errors and successes concurrently",
      "shape": "mixed-errors-successes",
      "input": {
        "dispatcher": {
          "connections": 5
        }
      },
      "expected": {
        "results": [
          200,
          "timeout",
          200,
          "timeout",
          200,
          "timeout"
        ]
      }
    },
    {
      "name": "saturated-health",
      "description": "dispatcher health reports a saturated pool",
      "shape": "saturated-health",
      "input": {
        "dispatcher": {
          "connections": 1
        },
        "waitMs": 300
      },
      "expected": {
        "healthy": false
      }
    },
    {
      "name": "health-after-errors",
      "description": "dispatcher health still works after errors",
      "shape": "health-after-errors",
      "input": {
        "dispatcher": {
          "connections": 2
        }
      },
      "expected": {
        "healthy": true
      }
    },
    {
      "name": "keep-alive-short",
      "description": "short keep-alive timeout causes a reconnect between requests",
      "shape": "keep-alive-short",
      "input": {
        "waitMs": 150,
        "dispatcher": {
          "connections": 2,
          "keepAliveTimeout": 100
        }
      },
      "expected": {
        "status": 200
      }
    },
    {
      "name": "keep-alive-long",
      "description": "long keep-alive timeout keeps the connection warm between requests",
      "shape": "keep-alive-long",
      "input": {
        "dispatcher": {
          "connections": 2,
          "keepAliveTimeout": 5000
        }
      },
      "expected": {
        "status": 200
      }
    },
    {
      "name": "pipelining-disabled",
      "description": "pipelining disabled still completes requests",
      "shape": "pipelining-disabled",
      "input": {
        "dispatcher": {
          "connections": 1,
