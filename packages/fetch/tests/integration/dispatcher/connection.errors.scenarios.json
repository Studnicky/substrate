    {
      "name": "close-waits",
      "description": "close waits for in-flight requests",
      "shape": "close-waits",
      "input": {
        "dispatcher": {
          "connections": 2
        }
      },
      "expected": {
        "closed": true
      }
    },
    {
      "name": "destroy-timeout-waits",
      "description": "destroy with timeout waits before closing",
      "shape": "destroy-timeout-waits",
      "input": {
        "dispatcher": {
          "connections": 2
        },
        "destroy": {
          "timeout": 100
        }
      },
      "expected": {
        "waited": true
      }
    },
    {
      "name": "destroy-zero-no-wait",
      "description": "destroy with zero timeout returns immediately",
      "shape": "destroy-zero-no-wait",
      "input": {
        "dispatcher": {
          "connections": 2
        },
        "destroy": {
          "timeout": 0
        }
      },
      "expected": {
        "waited": false
      }
    },
    {
      "name": "client-destroy-passes-timeout",
      "description": "FetchClient.destroy forwards the timeout to dispatcher destroy",
      "shape": "client-destroy-passes-timeout",
      "input": {
        "destroy": {
          "timeout": 100
        },
        "fetchClient": {
          "dispatcher": {
            "connections": 2,
            "enabled": true
          }
        }
      },
      "expected": {
        "waited": true
      }
    }
  ]
}
