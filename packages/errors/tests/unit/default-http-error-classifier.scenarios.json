{
  "cases": [
    {
      "name": "rate-limited",
      "description": "classifies HTTP 429 as retryable rate-limited",
      "kind": "rate-limited",
      "attemptNumber": 0,
      "input": { "status": 429 },
      "expected": { "reason": "Rate limited", "retryable": true }
    },
    {
      "name": "gateway-error",
      "description": "classifies HTTP 502 as retryable gateway error",
      "kind": "gateway-error",
      "attemptNumber": 0,
      "input": { "status": 502 },
      "expected": { "reason": "Gateway error (502)", "retryable": true }
    },
    {
      "name": "server-error",
      "description": "classifies HTTP 500 as retryable server error",
      "kind": "server-error",
      "attemptNumber": 0,
      "input": { "status": 500 },
      "expected": { "reason": "Server error (500)", "retryable": true }
    },
    {
      "name": "request-timeout",
      "description": "classifies HTTP 408 as retryable timeout",
      "kind": "request-timeout",
      "attemptNumber": 0,
      "input": { "status": 408 },
      "expected": { "reason": "Request timeout", "retryable": true }
    },
    {
      "name": "client-error",
      "description": "classifies HTTP 404 as non-retryable client error",
      "kind": "client-error",
      "attemptNumber": 0,
      "input": { "status": 404 },
      "expected": { "reason": "Client error (404)", "retryable": false }
    },
    {
      "name": "network-code",
      "description": "classifies a network code as retryable",
      "kind": "network-code",
      "attemptNumber": 0,
      "input": { "code": "ECONNREFUSED", "message": "connection refused" },
      "expected": { "reason": "Network error", "retryable": true }
    },
    {
      "name": "network-message",
      "description": "classifies a network-like message as retryable",
      "kind": "network-message",
      "attemptNumber": 0,
      "input": { "message": "socket hang up" },
      "expected": { "reason": "Network error", "retryable": true }
    },
    {
      "name": "unknown-early",
      "description": "classifies an unknown early attempt as retryable",
      "kind": "unknown-early",
      "attemptNumber": 0,
      "input": { "message": "unexpected" },
      "expected": { "reason": "Unknown error (will retry)", "retryable": true }
    },
    {
      "name": "unknown-late",
      "description": "classifies an unknown late attempt as non-retryable",
      "kind": "unknown-late",
      "attemptNumber": 2,
      "input": { "message": "unexpected" },
      "expected": { "reason": "Unknown error", "retryable": false }
    }
  ]
}
