{
  "cases": [
    {
      "name": "message-contains-hit",
      "description": "matches a message fragment case-insensitively",
      "shape": "message-contains-hit",
      "input": { "message": "Connection Refused", "patterns": ["connection refused"] },
      "expected": { "value": true }
    },
    {
      "name": "message-contains-miss",
      "description": "returns false when no fragment matches",
      "shape": "message-contains-miss",
      "input": { "message": "all good", "patterns": ["socket hang up"] },
      "expected": { "value": false }
    },
    {
      "name": "classifications",
      "description": "builds retryable and non-retryable classifications",
      "shape": "classifications",
      "input": { "message": "classify me" },
      "expected": { "retryable": true, "nonRetryable": false }
    }
  ]
}
