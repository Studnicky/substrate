{
  "cases": [
    {
      "name": "construction-empty",
      "description": "empty collection has ok === true and length === 0",
      "shape": "construction-empty",
      "input": { "shape": "empty-array" },
      "expected": { "length": 0, "ok": true }
    },
    {
      "name": "construction-non-empty",
      "description": "non-empty collection has ok === false",
      "shape": "construction-non-empty",
      "input": [{ "keyword": "required", "message": "required", "path": "/name" }],
      "expected": { "length": 1, "ok": false }
    },
    {
      "name": "create-from-array",
      "description": "produces correct collection from array",
      "shape": "create-from-array",
      "input": [{ "keyword": "format", "message": "must be email", "path": "/email" }],
      "expected": { "items": [{ "keyword": "format", "message": "must be email", "path": "/email" }], "length": 1 }
    },
    {
      "name": "detaches-source",
      "description": "detaches source items and every returned projection",
      "shape": "detaches-source",
      "input": [{ "keyword": "format", "message": "must be email", "path": "/email" }],
      "expected": { "items": [{ "keyword": "format", "message": "must be email", "path": "/email" }], "length": 1 }
    },
    {
      "name": "merge",
      "description": "combines violations from multiple collections",
      "shape": "merge",
      "input": {
        "left": [{ "keyword": "required", "message": "required", "path": "/a" }],
        "right": [{ "keyword": "minLength", "message": "too short", "path": "/b" }]
      },
      "expected": { "items": [{ "keyword": "required", "message": "required", "path": "/a" }, { "keyword": "minLength", "message": "too short", "path": "/b" }], "length": 2 }
    },
    {
      "name": "merge-empty",
      "description": "merging empty collections yields empty",
      "shape": "merge-empty",
      "input": { "left": { "shape": "empty-array" }, "right": { "shape": "empty-array" } },
      "expected": { "length": 0, "ok": true }
    },
    { "name": "from-null", "description": "returns empty collection for null", "shape": "from-null", "input": { "shape": "null" }, "expected": { "length": 0, "ok": true } },
    { "name": "from-undefined", "description": "returns empty collection for undefined", "shape": "from-undefined", "input": { "shape": "undefined" }, "expected": { "length": 0, "ok": true } },
    { "name": "from-empty-array", "description": "returns empty collection for empty array", "shape": "from-empty-array", "input": { "shape": "empty-array" }, "expected": { "length": 0, "ok": true } },
    {
      "name": "maps-ajv",
      "description": "maps Ajv-style errors to violations",
      "shape": "maps-ajv",
      "input": [
        { "instancePath": "/name", "keyword": "required", "message": "must have property name" },
        { "instancePath": "/email", "keyword": "format", "message": "must match format \"email\"" }
      ],
      "expected": { "items": [{ "keyword": "required", "message": "must have property name", "path": "/name" }, { "keyword": "format", "message": "must match format \"email\"", "path": "/email" }], "length": 2 }
    },
    {
      "name": "fallback-message",
      "description": "falls back to keyword as message when message is absent",
      "shape": "fallback-message",
      "input": [{ "instancePath": "/x", "keyword": "type" }],
      "expected": { "items": [{ "keyword": "type", "message": "type", "path": "/x" }], "length": 1 }
    },
    {
      "name": "aggregate-dedup",
      "description": "returns deduplicated sorted paths and keywords",
      "shape": "aggregate-dedup",
      "input": [
        { "keyword": "minLength", "message": "too short", "path": "/b" },
        { "keyword": "required", "message": "required", "path": "/a" },
        { "keyword": "type", "message": "wrong type", "path": "/b" },
        { "keyword": "required", "message": "required again", "path": "/a" }
      ],
      "expected": { "aggregate": { "count": 4, "keywords": ["minLength", "required", "type"], "paths": ["/a", "/b"] } }
    },
    { "name": "aggregate-empty", "description": "returns empty arrays for empty collection", "shape": "aggregate-empty", "input": { "shape": "empty-array" }, "expected": { "aggregate": { "count": 0, "keywords": [], "paths": [] } } },
    {
      "name": "report-default",
      "description": "returns RFC 9457 shape with defaults",
      "shape": "report-default",
      "input": [{ "keyword": "required", "message": "required", "path": "/x" }],
      "expected": {
        "report": {
          "detail": "1 validation error",
          "errors": [{ "keyword": "required", "message": "required", "path": "/x" }],
          "status": 422,
          "title": "Validation failed",
          "type": "https://problems.studnicky.dev/validation"
        }
      }
    },
    {
      "name": "report-empty",
      "description": "returns plural detail for an empty collection report",
      "shape": "report-empty",
      "input": { "shape": "empty-array" },
      "expected": {
        "report": {
          "detail": "0 validation errors",
          "errors": [],
          "status": 422,
          "title": "Validation failed",
          "type": "https://problems.studnicky.dev/validation"
        }
      }
    },
    {
      "name": "report-plural",
      "description": "uses plural detail for multiple errors",
      "shape": "report-plural",
      "input": [
        { "keyword": "required", "message": "required", "path": "/a" },
        { "keyword": "format", "message": "bad format", "path": "/b" }
      ],
      "expected": {
        "report": {
          "detail": "2 validation errors",
          "errors": [
            { "keyword": "required", "message": "required", "path": "/a" },
            { "keyword": "format", "message": "bad format", "path": "/b" }
          ],
          "status": 422,
          "title": "Validation failed",
          "type": "https://problems.studnicky.dev/validation"
        }
      }
    },
    {
      "name": "report-overrides",
      "description": "applies provided type and status overrides",
      "shape": "report-overrides",
      "input": {
        "options": { "status": 400, "type": "https://example.com/custom" },
        "violations": [{ "keyword": "required", "message": "required", "path": "/x" }]
      },
      "expected": {
        "report": {
          "detail": "1 validation error",
          "errors": [{ "keyword": "required", "message": "required", "path": "/x" }],
          "status": 400,
          "title": "Validation failed",
          "type": "https://example.com/custom"
        }
      }
    },
    {
      "name": "report-title",
      "description": "applies provided title override",
      "shape": "report-title",
      "input": {
        "options": { "title": "Schema check failed" },
        "violations": [{ "keyword": "required", "message": "required", "path": "/x" }]
      },
      "expected": {
        "report": {
          "detail": "1 validation error",
          "errors": [{ "keyword": "required", "message": "required", "path": "/x" }],
          "status": 422,
          "title": "Schema check failed",
          "type": "https://problems.studnicky.dev/validation"
        }
      }
    },
    {
      "name": "spread",
      "description": "spread yields all violations",
      "shape": "spread",
      "input": [
        { "keyword": "required", "message": "required", "path": "/a" },
        { "keyword": "minLength", "message": "too short", "path": "/b" }
      ],
      "expected": { "items": [{ "keyword": "required", "message": "required", "path": "/a" }, { "keyword": "minLength", "message": "too short", "path": "/b" }], "length": 2 }
    },
    {
      "name": "for-of",
      "description": "for-of iterates violations in order",
      "shape": "for-of",
      "input": [
        { "keyword": "required", "message": "required", "path": "/a" },
        { "keyword": "format", "message": "bad format", "path": "/b" },
        { "keyword": "type", "message": "wrong type", "path": "/c" }
      ],
      "expected": { "items": [{ "keyword": "required", "message": "required", "path": "/a" }, { "keyword": "format", "message": "bad format", "path": "/b" }, { "keyword": "type", "message": "wrong type", "path": "/c" }], "length": 3 }
    },
    {
      "name": "construction-invalid",
      "description": "throws ValidationError when constructed with a non-array value",
      "shape": "construction-invalid",
      "input": { "shape": "not-array" },
      "expected": { "messageIncludes": ["items must be an array"] }
    }
  ]
}
