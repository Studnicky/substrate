{
  "cases": [
    { "name": "assigns-fields", "description": "assigns typed fields onto the instance via Object.assign", "kind": "assigns-fields", "input": { "error": { "fields": { "path": "/tmp/lock", "timeoutMs": 5000 }, "options": { "code": "fileLock.timeout", "messageTemplate": "file-lock-timeout", "retryable": false } } }, "expected": { "path": "/tmp/lock", "timeoutMs": 5000 } },
    { "name": "message-callback", "description": "builds the message via the options.message callback", "kind": "message-callback", "input": { "error": { "fields": { "path": "/tmp/lock", "timeoutMs": 5000 }, "options": { "code": "fileLock.timeout", "messageTemplate": "file-lock-timeout", "retryable": false } } }, "expected": { "message": "Timed out acquiring lock on \"/tmp/lock\" after 5000ms" } },
    { "name": "forwards-code-retryable", "description": "forwards code and retryable to BaseError", "kind": "forwards-code-retryable", "input": { "error": { "fields": { "path": "/tmp/lock", "timeoutMs": 5000 }, "options": { "code": "fileLock.timeout", "messageTemplate": "file-lock-timeout", "retryable": false } } }, "expected": { "code": "fileLock.timeout", "retryable": false } },
    { "name": "preserves-instanceof", "description": "preserves instanceof the wrapped domain base and BaseError", "kind": "preserves-instanceof", "input": { "error": { "fields": { "path": "/tmp/lock", "timeoutMs": 5000 }, "options": { "code": "fileLock.timeout", "messageTemplate": "file-lock-timeout", "retryable": false } } }, "expected": { "instanceOf": ["Error", "BaseError", "StubFileLockError", "StubFileLockTimeoutError"] } },
    { "name": "name-resolves", "description": "name resolves to the concrete leaf class", "kind": "name-resolves", "input": { "error": { "fields": { "path": "/tmp/lock", "timeoutMs": 5000 }, "options": { "code": "fileLock.timeout", "messageTemplate": "file-lock-timeout", "retryable": false } } }, "expected": { "name": "StubFileLockTimeoutError" } },
    { "name": "omits-optional-fields", "description": "omits optional fields when not provided", "kind": "omits-optional-fields", "input": { "error": { "fields": { "path": "/tmp/lock", "timeoutMs": 1000 }, "options": { "code": "fileLock.timeout", "message": "timed out" } } }, "expected": { "hasCause": false, "hasCorrelationId": false, "hasMetadata": false, "hasRetryable": false } },
    { "name": "includes-optional-fields", "description": "includes cause, correlationId, metadata, and retryable when provided", "kind": "includes-optional-fields", "input": { "error": { "fields": { "path": "/tmp/lock", "timeoutMs": 1000 }, "options": { "causeMessage": "disk full", "code": "fileLock.timeout", "correlationId": "corr-1", "message": "timed out", "metadata": { "attempt": 3 }, "retryable": true } } }, "expected": { "hasCause": true, "correlationId": "corr-1", "retryable": true, "metadata": { "attempt": 3 } } },
    { "name": "same-fields-object", "description": "passes the same fields object to the message callback that the caller assigns", "kind": "same-fields-object", "input": { "error": { "fields": { "path": "/tmp/lock", "timeoutMs": 1000 }, "options": { "code": "fileLock.timeout", "message": "timed out" } } }, "expected": { "sameObject": true } }
  ]
}
