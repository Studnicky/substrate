{
  "cases": [
    { "name": "instanceof", "description": "is an instance of BaseError and Error", "kind": "instanceof", "input": { "message": "bad input", "path": "/field" }, "expected": { "instanceof": ["BaseError", "Error", "ValidationError"] } },
    { "name": "code", "description": "has code errors.validationFailed", "kind": "code", "input": { "message": "bad input", "path": "/field" }, "expected": { "code": "errors.validationFailed" } },
    { "name": "retryable", "description": "is not retryable", "kind": "retryable", "input": { "message": "bad input", "path": "/field" }, "expected": { "retryable": false } },
    { "name": "message-with-path", "description": "formats message with path", "kind": "message-with-path", "input": { "message": "must be string", "path": "/user/name" }, "expected": { "messageIncludes": ["/user/name", "must be string"] } },
    { "name": "correlation-id", "description": "stores correlationId when provided", "kind": "correlation-id", "input": { "message": "bad input", "path": "/x", "correlationId": "trace-abc" }, "expected": { "correlationId": "trace-abc" } },
    { "name": "violations-present", "description": "stores violations when provided", "kind": "violations-present", "input": { "message": "multiple", "path": "/root", "violations": [{ "message": "required", "path": "/a" }, { "message": "too short", "path": "/b" }] }, "expected": { "violationsLength": 2 } },
    { "name": "violations-present-details", "description": "preserves nested violation details", "kind": "violations-present-details", "input": { "message": "multiple", "path": "/root", "violations": [{ "details": { "limit": 3 }, "message": "too long", "path": "/b" }] }, "expected": { "violationsLimit": 3 } },
    { "name": "violations-complex-details", "description": "preserves nested arrays and non-plain objects in violation details", "kind": "violations-complex-details", "input": { "message": "multiple", "path": "/root", "violations": [{ "details": { "instance": "marker", "plain": { "nested": { "count": 2 } }, "tags": ["one", ["two"]] }, "message": "too long", "path": "/b" }] }, "expected": { "count": 2, "instance": "marker", "tags": ["one"] } },
    { "name": "violations-absent", "description": "leaves violations undefined when not provided", "kind": "violations-absent", "input": { "message": "bad", "path": "/x" }, "expected": { "violations": { "kind": "undefined" } } },
    { "name": "detach-violations", "description": "detaches nested violations at construction and projection boundaries", "kind": "detach-violations", "input": { "message": "invalid", "path": "/name", "violations": [{ "details": { "limit": 3 }, "message": "too long", "path": "/name" }] }, "expected": { "violations": [{ "details": { "limit": 3 }, "message": "too long", "path": "/name" }] } },
    { "name": "user-message-violations", "description": "returns formatted message with violations", "kind": "user-message-violations", "input": { "message": "failed", "path": "/root", "violations": [{ "message": "required", "path": "/a" }, { "message": "too long", "path": "/b" }] }, "expected": { "messageIncludes": ["/a", "/b", "required"] } },
    { "name": "user-message-empty-violations", "description": "returns plain message when violations are empty", "kind": "user-message-empty-violations", "input": { "message": "bad input", "path": "/field", "violations": [] }, "expected": { "message": "Validation failed at \"/field\": bad input" } },
    { "name": "user-message-plain", "description": "returns plain message when no violations", "kind": "user-message-plain", "input": { "message": "bad input", "path": "/field" }, "expected": { "message": "Validation failed at \"/field\": bad input" } },
    { "name": "json-serializes", "description": "serializes with code and message", "kind": "json-serializes", "input": { "message": "invalid", "path": "/x" }, "expected": { "code": "errors.validationFailed", "messageType": "string" } },
    { "name": "json-roundtrip", "description": "JSON.stringify roundtrip works", "kind": "json-roundtrip", "input": { "message": "bad", "path": "/y" }, "expected": { "code": "errors.validationFailed" } },
    { "name": "json-includes-violations", "description": "includes violations in JSON when provided", "kind": "json-includes-violations", "input": { "message": "invalid", "path": "/x", "violations": [{ "message": "required", "path": "/a" }] }, "expected": { "hasViolations": true } },
    { "name": "json-excludes-violations", "description": "excludes violations from JSON when absent", "kind": "json-excludes-violations", "input": { "message": "invalid", "path": "/x" }, "expected": { "hasViolations": false } }
  ]
}
