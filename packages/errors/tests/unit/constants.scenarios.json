        "AUTHORIZATION_ERROR": "AUTHORIZATION_ERROR",
        "CONFIGURATION_ERROR": "CONFIGURATION_ERROR",
        "CONNECTION_ERROR": "CONNECTION_ERROR",
        "DATABASE_ERROR": "DATABASE_ERROR",
        "EXTERNAL_SERVICE_ERROR": "EXTERNAL_SERVICE_ERROR",
        "INTERNAL_ERROR": "INTERNAL_ERROR",
        "NOT_FOUND": "NOT_FOUND",
        "RATE_LIMIT_ERROR": "RATE_LIMIT_ERROR",
        "TIMEOUT_ERROR": "TIMEOUT_ERROR",
        "VALIDATION_ERROR": "VALIDATION_ERROR"
      },
      "expected": {
        "AUTHENTICATION_ERROR": "AUTHENTICATION_ERROR",
        "AUTHORIZATION_ERROR": "AUTHORIZATION_ERROR",
        "CONFIGURATION_ERROR": "CONFIGURATION_ERROR",
        "CONNECTION_ERROR": "CONNECTION_ERROR",
        "DATABASE_ERROR": "DATABASE_ERROR",
        "EXTERNAL_SERVICE_ERROR": "EXTERNAL_SERVICE_ERROR",
        "INTERNAL_ERROR": "INTERNAL_ERROR",
        "NOT_FOUND": "NOT_FOUND",
        "RATE_LIMIT_ERROR": "RATE_LIMIT_ERROR",
        "TIMEOUT_ERROR": "TIMEOUT_ERROR",
        "VALIDATION_ERROR": "VALIDATION_ERROR"
      }
    },
    {
      "name": "http-status-client",
      "description": "HttpStatus exposes client error codes",
      "shape": "http-status-client",
      "input": {
        "BAD_REQUEST": 400,
        "CONFLICT": 409,
        "FORBIDDEN": 403,
        "METHOD_NOT_ALLOWED": 405,
        "NOT_FOUND": 404,
        "TOO_MANY_REQUESTS": 429,
        "UNAUTHORIZED": 401,
        "UNPROCESSABLE_ENTITY": 422
      },
      "expected": {
        "BAD_REQUEST": 400,
        "CONFLICT": 409,
        "FORBIDDEN": 403,
        "METHOD_NOT_ALLOWED": 405,
        "NOT_FOUND": 404,
        "TOO_MANY_REQUESTS": 429,
        "UNAUTHORIZED": 401,
        "UNPROCESSABLE_ENTITY": 422
      }
    },
    {
      "name": "http-status-server",
      "description": "HttpStatus exposes server error codes",
      "shape": "http-status-server",
      "input": {
        "BAD_GATEWAY": 502,
        "GATEWAY_TIMEOUT": 504,
        "INTERNAL_SERVER_ERROR": 500,
        "NOT_IMPLEMENTED": 501,
        "SERVICE_UNAVAILABLE": 503
      },
      "expected": {
        "BAD_GATEWAY": 502,
        "GATEWAY_TIMEOUT": 504,
        "INTERNAL_SERVER_ERROR": 500,
        "NOT_IMPLEMENTED": 501,
        "SERVICE_UNAVAILABLE": 503
      }
    },
    {
      "name": "defaults-authentication",
      "description": "AUTHENTICATION has correct defaults",
      "shape": "defaults",
      "input": { "scenario": "AUTHENTICATION" },
      "expected": { "code": "AUTHENTICATION_ERROR", "retryable": false, "statusCode": 401 }
    },
    {
      "name": "defaults-authorization",
      "description": "AUTHORIZATION has correct defaults",
      "shape": "defaults",
      "input": { "scenario": "AUTHORIZATION" },
      "expected": { "code": "AUTHORIZATION_ERROR", "retryable": false, "statusCode": 403 }
    },
    {
      "name": "defaults-connection",
      "description": "CONNECTION has correct defaults",
      "shape": "defaults",
      "input": { "scenario": "CONNECTION" },
      "expected": { "code": "CONNECTION_ERROR", "retryable": true, "statusCode": 503 }
    },
    {
      "name": "defaults-database",
      "description": "DATABASE has correct defaults",
      "shape": "defaults",
      "input": { "scenario": "DATABASE" },
      "expected": { "code": "DATABASE_ERROR", "retryable": false, "statusCode": 500 }
