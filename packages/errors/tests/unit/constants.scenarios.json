    {
      "name": "module-error-authentication",
      "description": "ModuleError.create uses AUTHENTICATION defaults",
      "shape": "module-error-authentication",
      "input": {
        "error": {
          "message": "Authentication failed",
          "options": { "context": { "userId": "123" }, "scenario": "AUTHENTICATION" }
        }
      },
      "expected": {
        "code": "AUTHENTICATION_ERROR",
        "context": { "userId": "123" },
        "retryable": false,
        "statusCode": 401
      }
    },
    {
      "name": "retryable-connection",
      "description": "CONNECTION marks errors as retryable",
      "shape": "retryable",
      "input": { "error": { "message": "retry", "options": { "scenario": "CONNECTION" } } },
      "expected": { "code": "CONNECTION_ERROR", "retryable": true }
    },
    {
      "name": "retryable-timeout",
      "description": "TIMEOUT marks errors as retryable",
      "shape": "retryable",
      "input": { "error": { "message": "retry", "options": { "scenario": "TIMEOUT" } } },
      "expected": { "code": "TIMEOUT_ERROR", "retryable": true }
    },
    {
      "name": "retryable-rate-limit",
      "description": "RATE_LIMIT marks errors as retryable",
      "shape": "retryable",
      "input": { "error": { "message": "retry", "options": { "scenario": "RATE_LIMIT" } } },
      "expected": { "code": "RATE_LIMIT_ERROR", "retryable": true }
    },
    {
      "name": "retryable-external-service",
      "description": "EXTERNAL_SERVICE marks errors as retryable",
      "shape": "retryable",
      "input": { "error": { "message": "retry", "options": { "scenario": "EXTERNAL_SERVICE" } } },
      "expected": { "code": "EXTERNAL_SERVICE_ERROR", "retryable": true }
    },
    {
      "name": "integration-context-override",
      "description": "ModuleError.create works with context override",
      "shape": "integration-context-override",
      "input": {
        "error": {
          "message": "Failed to connect",
          "options": { "context": { "attempt": 3, "host": "api.example.com" }, "scenario": "CONNECTION" }
        }
      },
      "expected": { "code": "CONNECTION_ERROR", "context": { "attempt": 3, "host": "api.example.com" }, "retryable": true }
    },
    {
      "name": "integration-cause-override",
      "description": "ModuleError.create works with cause override",
      "shape": "integration-cause-override",
      "input": {
        "error": {
          "causeMessage": "Socket timeout",
          "message": "Connection failed",
          "options": { "scenario": "CONNECTION" }
        }
      },
      "expected": { "causeMessage": "Socket timeout", "code": "CONNECTION_ERROR" }
    },
    {
      "name": "integration-retryable-override",
      "description": "ModuleError.create allows overriding retryable",
      "shape": "integration-retryable-override",
      "input": {
        "error": {
          "message": "Permanent connection failure",
          "options": { "retryable": false, "scenario": "CONNECTION" }
        }
      },
      "expected": { "code": "CONNECTION_ERROR", "retryable": false }
    },
    {
      "name": "integration-status-code-override",
      "description": "ModuleError.create allows overriding statusCode",
      "shape": "integration-status-code-override",
      "input": {
        "error": {
          "message": "Database locked",
          "options": { "scenario": "DATABASE", "statusCode": 409 }
        }
      },
      "expected": { "code": "DATABASE_ERROR", "statusCode": 409 }
    }
  ]
