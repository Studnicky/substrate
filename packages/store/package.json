{
  "name": "@studnicky/store",
  "version": "15.0.0",
  "description": "Observable state stores with interchangeable persistence adapters",
  "keywords": [
    "browser",
    "persistence",
    "state",
    "store"
  ],
  "homepage": "https://studnicky.github.io/substrate/packages/store",
  "bugs": {
    "url": "https://github.com/Studnicky/substrate/issues"
  },
  "license": "MIT",
  "author": "Andrew Studnicky <a.j.studnicky@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Studnicky/substrate.git",
    "directory": "packages/store"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./interfaces": {
      "types": "./dist/interfaces/index.d.ts",
      "import": "./dist/interfaces/index.js"
    },
    "./entities": {
      "types": "./dist/entities/index.d.ts",
      "import": "./dist/entities/index.js"
    },
    "./strata": {
      "types": "./dist/strata/index.d.ts",
      "import": "./dist/strata/index.js"
    },
    "./strata/browser": {
      "types": "./dist/strata/browser/index.d.ts",
      "import": "./dist/strata/browser/index.js"
    },
    "./strata/interfaces": {
      "types": "./dist/strata/interfaces/index.d.ts",
      "import": "./dist/strata/interfaces/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage test-reports tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo tsconfig.tests.tsbuildinfo",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "test": "tsx ../../scripts/test-suite.ts all --package ."
  },
  "dependencies": {
    "@studnicky/context": "workspace:*",
    "@studnicky/entity": "workspace:*",
    "@studnicky/json": "workspace:*",
    "@studnicky/mutex": "workspace:*",
    "@studnicky/types": "workspace:*"
  },
  "devDependencies": {
    "@studnicky/example-smoke-kit": "workspace:*",
    "fake-indexeddb": "^6.2.5"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  }
}
