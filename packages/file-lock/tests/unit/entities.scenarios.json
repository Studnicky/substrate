{
  "cases": [
    {
      "description": "File-lock entities accept canonical values",
      "expected": {
        "validationResults": [
          true,
          true
        ]
      },
      "input": {
        "validations": [
          { "entity": "FileLockOptionsEntity", "expected": true, "value": { "path": "/tmp/data.json", "timeoutMs": 100 } },
          { "entity": "FileLockPathStateEntity", "expected": true, "value": { "lockPath": "/tmp/data.json.lock.owner", "originalPath": "/tmp/data.json" } }
        ]
      },
      "shape": "valid-entities",
      "name": "valid-entities"
    },
    {
      "description": "File-lock path state rejects incomplete input",
      "expected": {
        "validationResults": [
          false
        ]
      },
      "input": {
        "validations": [
          { "entity": "FileLockPathStateEntity", "expected": false, "value": { "lockPath": "/tmp/data.json.lock.owner" } }
        ]
      },
      "shape": "reject-incomplete-path-state",
      "name": "reject-incomplete-path-state"
    },
    {
      "description": "FileLockOptionsEntity rejects an empty path",
      "expected": {
        "validationResults": [
          false
        ]
      },
      "input": {
        "validations": [
          { "entity": "FileLockOptionsEntity", "expected": false, "value": { "path": "" } }
        ]
      },
      "shape": "reject-empty-path",
      "name": "reject-empty-path"
    },
    {
      "description": "FileLockOptionsEntity rejects non-positive pollMs",
      "expected": {
        "validationResults": [
          false,
          false
        ]
      },
      "input": {
        "validations": [
          { "entity": "FileLockOptionsEntity", "expected": false, "value": { "path": "/tmp/data.json", "pollMs": 0 } },
          { "entity": "FileLockOptionsEntity", "expected": false, "value": { "path": "/tmp/data.json", "pollMs": -5 } }
        ]
      },
      "shape": "reject-non-positive-pollMs",
      "name": "reject-non-positive-pollMs"
    },
    {
      "description": "FileLockOptionsEntity rejects non-positive timeoutMs",
      "expected": {
        "validationResults": [
          false,
          false
        ]
      },
      "input": {
        "validations": [
          { "entity": "FileLockOptionsEntity", "expected": false, "value": { "path": "/tmp/data.json", "timeoutMs": 0 } },
          { "entity": "FileLockOptionsEntity", "expected": false, "value": { "path": "/tmp/data.json", "timeoutMs": -5 } }
        ]
      },
      "shape": "reject-non-positive-timeoutMs",
      "name": "reject-non-positive-timeoutMs"
    },
    {
      "description": "FileLockOptionsEntity rejects an unexpected extra property",
      "expected": {
        "validationResults": [
          false
        ]
      },
      "input": {
        "validations": [
          { "entity": "FileLockOptionsEntity", "expected": false, "value": { "path": "/tmp/data.json", "unexpectedProperty": true } }
        ]
      },
      "shape": "reject-unexpected-property",
      "name": "reject-unexpected-property"
    }
  ]
}
