{
  "cases": [
    {
      "name": "validates omitted and non-negative deadlines",
      "description": "validates omitted and non-negative deadlines",
      "shape": "entity-validates-deadlines",
      "input": {
        "values": [{}, { "deadlineMs": 0 }]
      },
      "expected": { "accepted": true }
    },
    {
      "name": "rejects negative deadlines",
      "description": "rejects negative deadlines",
      "shape": "entity-rejects-invalid-deadline",
      "input": {
        "values": [{ "deadlineMs": -1 }]
      },
      "expected": { "accepted": false }
    },
    {
      "name": "rejects deadlines with additional properties",
      "description": "rejects deadlines with additional properties",
      "shape": "entity-rejects-invalid-deadline",
      "input": {
        "values": [{ "deadlineMs": 5, "extra": true }]
      },
      "expected": { "accepted": false }
    },
    {
      "name": "rejects non-numeric deadlineMs",
      "description": "rejects non-numeric deadlineMs",
      "shape": "entity-rejects-invalid-deadline",
      "input": {
        "values": [{ "deadlineMs": "5" }]
      },
      "expected": { "accepted": false }
    },
    {
      "name": "builds callable FetchClient and Retry dependencies from plain config",
      "description": "builds callable FetchClient and Retry dependencies from plain config",
      "shape": "create-plain-config",
      "input": {
        "fetchInputUrl": "https://example.test/resource",
        "fetchMethod": "GET",
        "fetchResponseText": "configured",
        "requestExecutor": {
          "fetchClient": { "baseURL": "https://example.test" },
          "retry": { "maximumRetries": 5 }
        },
        "requestPath": "/resource"
      },
      "expected": {
        "requestMethod": "GET",
        "requestUrl": "https://example.test/resource",
        "responseText": "configured",
        "result": "configured"
      }
    },
    {
      "name": "executes through the caller-owned instances",
      "description": "executes through the caller-owned instances",
      "shape": "create-with-instances",
      "input": {
        "requestExecutor": {
          "deadlineMs": 1000,
          "fetchClient": { "baseURL": "https://example.test" },
          "retry": { "maximumRetries": 2 }
        },
        "retryFailOnceMessage": "retry once"
      },
      "expected": {
        "result": "retried",
        "retryTotalRetries": 1,
        "sameFetchClient": true
      }
    },
    {
      "name": "produces a working, callable instance with real default primitives",
      "description": "produces a working, callable instance with real default primitives",
      "shape": "defaults-real-primitives",
      "input": {
        "fetchResponseText": "ok",
        "fetchUrl": "https://example.test/"
      },
      "expected": {
        "responseStatus": 200,
        "responseText": "ok"
      }
    },
    {
      "name": "round-trips a value set/get inside fn through the composed Context instance",
      "description": "round-trips a value set/get inside fn through the composed Context instance",
      "shape": "context-roundtrip",
      "input": {
        "contextValue": "req-abc-123",
        "fetchResponseText": "ok",
        "requestExecutor": {
          "context": { "name": "context-test" },
          "fetchClient": { "baseURL": "https://example.test" },
          "retry": {}
        }
      },
      "expected": {
        "observedRequestId": "req-abc-123"
      }
    },
    {
      "name": "seeds contextInitial values reachable from fn",
      "description": "seeds contextInitial values reachable from fn",
      "shape": "context-seeded-values",
      "input": {
        "contextSeed": 42,
        "fetchResponseText": "ok",
        "requestExecutor": {
          "context": { "name": "context-seed-test" },
          "fetchClient": { "baseURL": "https://example.test" },
          "retry": {}
        }
      },
      "expected": {
        "observedSeed": 42
      }
    },
    {
      "name": "a merged caller signal + deadlineMs aborts the in-flight fetch",
      "description": "a merged caller signal + deadlineMs aborts the in-flight fetch",
      "shape": "cancellation-merged-signal",
      "input": {
        "abortAfterMs": 10,
        "fetchPath": "/delay?ms=200",
        "requestExecutor": {
          "deadlineMs": 5000,
          "fetchClient": { "baseURL": "https://example.test" },
          "retry": { "maximumRetries": 0 }
        }
      },
      "expected": {
        "aborted": true
      }
    },
    {
      "name": "composes the AbortSignal from Signal#compose (never-aborting sentinel when no options given)",
      "description": "composes the AbortSignal from Signal#compose (never-aborting sentinel when no options given)",
      "shape": "cancellation-default-signal",
      "input": {
        "fetchDelayMs": 10,
        "fetchPath": "/delay?ms=10",
        "requestExecutor": {
          "fetchClient": { "baseURL": "https://example.test" },
          "retry": {}
        },
        "responseText": "ok"
      },
      "expected": {
        "responseStatus": 200,
        "signalAborted": false
      }
    },
    {
      "name": "cancellation-deadline-only",
      "description": "composes a deadline-only AbortSignal when no caller signal is supplied",
      "shape": "cancellation-deadline-only",
      "input": {
        "fetchDelayMs": 10,
        "fetchPath": "/delay?ms=10",
        "requestExecutor": {
          "deadlineMs": 1000,
          "fetchClient": { "baseURL": "https://example.test" },
          "retry": {}
        },
        "responseText": "ok"
      },
      "expected": {
        "responseStatus": 200,
        "signalAborted": false
      }
    },
    {
      "name": "brackets one onExecuteStart/onExecuteComplete pair across all retry attempts",
      "description": "brackets one onExecuteStart/onExecuteComplete pair across all retry attempts",
      "shape": "hooks-bracket-retry-loop",
      "input": {
        "fetchFailures": 1,
        "fetchPath": "/flaky",
        "requestExecutor": {
          "fetchClient": { "baseURL": "https://example.test" },
          "retry": { "maximumRetries": 2 }
        }
      },
      "expected": {
        "hookNames": ["onExecuteStart", "onExecuteComplete"],
        "responseStatus": 200
      }
    },
    {
      "name": "fires onExecuteStart/onExecuteError when the executor callback throws",
      "description": "fires onExecuteStart/onExecuteError when the executor callback throws, and the original error still propagates",
      "shape": "hooks-bracket-error",
      "input": {
        "errorMessage": "boom",
        "requestExecutor": {
          "fetchClient": { "baseURL": "https://example.test" },
          "retry": {}
        }
      },
      "expected": {
        "errorMessage": "boom",
        "hookNames": ["onExecuteStart", "onExecuteError"]
      }
    },
    {
      "name": "a throwing onExecuteError override does not replace the propagated request error",
      "description": "a throwing onExecuteError override does not replace the propagated request error, and the hook failure is recorded via getHookErrors()",
      "shape": "hooks-error-not-swallowed",
      "input": {
        "errorMessage": "request failed",
        "hookFailureMessage": "onExecuteError override failed",
        "requestExecutor": {
          "fetchClient": { "baseURL": "https://example.test" },
          "retry": {}
        }
      },
      "expected": {
        "errorMessage": "request failed",
        "hookErrorCount": 1,
        "hookErrorName": "onExecuteError"
      }
    },
    {
      "name": "default RequestExecutor has no-op hooks and executes unaffected",
      "description": "default RequestExecutor (no subclass overrides) has no-op lifecycle hooks and executes unaffected",
      "shape": "hooks-noop-default",
      "input": {
        "fetchResponseText": "ok",
        "fetchUrl": "https://example.test/"
      },
      "expected": {
        "hookErrorCount": 0,
        "responseStatus": 200,
        "responseText": "ok"
      }
    },
    {
      "name": "fires subclass FetchClient and Retry hooks through the composed execute() call",
      "description": "fires subclass FetchClient and Retry hooks through the composed execute() call",
      "shape": "hooks-fire-through-executor",
      "input": {
        "fetchFailures": 2,
        "fetchPath": "/flaky",
        "requestExecutor": {
          "fetchClient": { "baseURL": "https://example.test" },
          "retry": { "maximumRetries": 3 }
        }
      },
      "expected": {
        "requestPaths": ["/flaky", "/flaky", "/flaky"],
        "responseStatuses": [500, 500, 200],
        "retryAttempts": [0, 1, 2],
        "scheduledRetries": [0, 1],
        "responseStatus": 200,
        "responseText": "ok"
      }
    }
  ]
}
