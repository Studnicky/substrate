    {
      "name": "async-rejecting-onPush-guarded",
      "description": "Unexpected async onPush overrides stay guarded across push and unshift",
      "shape": "async-rejecting-onPush-guarded",
      "input": {
        "asyncOperations": [
          {
            "method": "push",
            "value": 1
          },
          {
            "method": "unshift",
            "value": 0
          },
          {
            "method": "push",
            "value": 2
          },
          {
            "method": "unshift",
            "value": -1
          }
        ],
        "flushTurns": 2,
        "options": {
          "capacity": 2
        }
      },
      "expected": {
        "length": 2,
        "minHookErrors": 1,
        "rejectionCount": 0,
        "shiftValues": [
          -1,
          1
        ]
      }
