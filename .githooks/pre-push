#!/bin/bash
set -eu

if . "$(dirname "$0")/lib/runtime.sh" && hook_skip_in_ci; then
  exit 0
fi

echo "pre-push: running substrate checks"

git_root=$(git rev-parse --show-toplevel)
default_ref=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@origin/@')
default_ref=${default_ref:-origin/develop}

if ! git show-ref --verify --quiet "refs/remotes/${default_ref}"; then
  remote_branch=${default_ref#origin/}
  git fetch --quiet origin "+refs/heads/${remote_branch}:refs/remotes/origin/${remote_branch}" || true
fi

cd "$git_root"

push_info=$(cat)

. "$(dirname "$0")/lib/branch-check.sh"
. "$(dirname "$0")/lib/changes.sh"
. "$(dirname "$0")/lib/push-range.sh"
. "$(dirname "$0")/lib/rebase-check.sh"

branch=$(git rev-parse --abbrev-ref HEAD)
check_branch_name "$branch"

case "$branch" in
  main|develop)
    echo "pre-push: protected branch '$branch' cannot be pushed directly" >&2
    exit 1
    ;;
esac

push_range=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/heads/*)
      if [ "$local_sha" != "0000000000000000000000000000000000000000" ] && [ -z "$push_range" ]; then
        push_range=$(compute_push_range "$local_sha") || true
      fi
      case "$local_ref" in
        refs/heads/release/*|refs/heads/hotfix/*) base_ref=origin/main ;;
        *) base_ref="$default_ref" ;;
      esac
      if ! git show-ref --verify --quiet "refs/remotes/${base_ref}"; then
        remote_branch=${base_ref#origin/}
        git fetch --quiet origin "+refs/heads/${remote_branch}:refs/remotes/origin/${remote_branch}" || true
      fi
      if [ -n "$base_ref" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
        check_rebased_onto_base "${base_ref#origin/}" "$local_sha" "$local_ref"
      fi
      ;;
  esac
done <<EOF
$push_info
EOF

if [ -n "$push_range" ]; then
  classify_changes "$push_range"
else
  _set_all_changed
fi

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/substrate-pre-push.XXXXXX")
trap 'rm -rf "$tmpdir"' EXIT INT TERM

run_suite() {
  name="$1"
  shift
  log="$tmpdir/${name}.log"
  (
    "$@"
  ) >"$log" 2>&1 &
  printf '%s\n' "$!" > "$tmpdir/${name}.pid"
}

run_stage() {
  stage="$1"
  shift
  for item in "$@"; do
    name="${item%%:*}"
    command="${item#*:}"
    run_suite "$name" bash -c "$command"
  done
  wait_stage "$stage" "$@"
}

wait_stage() {
  stage="$1"
  shift
  failures=0
  for item in "$@"; do
    name="${item%%:*}"
    pid_file="$tmpdir/${name}.pid"
    [ -f "$pid_file" ] || continue
    pid=$(cat "$pid_file")
    if ! wait "$pid"; then
      failures=1
      echo "pre-push: ${stage}/${name} failed; log follows" >&2
      cat "$tmpdir/${name}.log" >&2
    fi
  done
  return "$failures"
}

policy_stage=()
if [ "$CHANGED_RELEASE" = true ] || [ "$CHANGED_SOURCE" = true ]; then
  policy_stage+=("release_gates:bash scripts/hook-suite.sh release-gates '$default_ref'")
fi

if [ "$CHANGED_CI" = true ]; then
  policy_stage+=("generated_artifacts:bash scripts/hook-suite.sh generated-artifacts")
fi

if [ "${#policy_stage[@]}" -gt 0 ]; then
  run_stage policy "${policy_stage[@]}"
fi

validation_stage=()
test_stage=()
if [ "$CHANGED_CI" = true ]; then
  validation_stage+=("typecheck:bash scripts/hook-suite.sh typecheck")
  validation_stage+=("lint:bash scripts/hook-suite.sh lint")
  validation_stage+=("build:bash scripts/hook-suite.sh build")
fi

if [ "$CHANGED_DOCS_WORKFLOW" = true ]; then
  validation_stage+=("docs_includes:bash scripts/hook-suite.sh docs-includes")
  validation_stage+=("docs_build:bash scripts/hook-suite.sh docs-build")
fi

if [ "$CHANGED_AUDIT" = true ]; then
  validation_stage+=("audit:bash scripts/hook-suite.sh audit")
fi

if [ "$CHANGED_SOURCE" = true ] || [ "$CHANGED_LOCKFILES" = true ] || [ "$CHANGED_CONFIG" = true ] || [ "$CHANGED_UNIT_TESTS" = true ]; then
  test_stage+=("test_unit:bash scripts/hook-suite.sh test-unit")
fi

if [ "$CHANGED_INTEGRATION_TESTS" = true ]; then
  test_stage+=("test_integration:bash scripts/hook-suite.sh test-integration")
fi

if [ "$CHANGED_SMOKE_TESTS" = true ]; then
  test_stage+=("test_smoke:bash scripts/hook-suite.sh test-smoke")
fi

if [ "$CHANGED_TESTS" = true ] && \
  [ "$CHANGED_UNIT_TESTS" = false ] && \
  [ "$CHANGED_INTEGRATION_TESTS" = false ] && \
  [ "$CHANGED_SMOKE_TESTS" = false ]; then
  test_stage+=("test_all:bash scripts/hook-suite.sh test-all")
fi

if [ -n "$push_range" ] && { [ "$CHANGED_SOURCE" = true ] || [ "$CHANGED_SECURITY_CONFIG" = true ]; }; then
  validation_stage+=("semgrep:bash scripts/hook-suite.sh semgrep '$push_range'")
fi

if [ "$CHANGED_ANALYSIS" = true ]; then
  echo "pre-push: blast radius"
  validation_stage+=("diagram:bash scripts/hook-suite.sh diagram '$default_ref'")
fi

if [ "${#validation_stage[@]}" -gt 0 ]; then
  run_stage validation "${validation_stage[@]}"
fi

if [ "${#test_stage[@]}" -gt 0 ]; then
  run_stage tests "${test_stage[@]}"
fi
