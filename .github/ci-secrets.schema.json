{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "description",
      "scope",
      "requiredBy"
    ],
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "scope": {
        "type": "string",
        "enum": [
          "repository",
          "environment"
        ]
      },
      "requiredBy": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workflow",
            "job"
          ],
          "properties": {
            "workflow": {
              "type": "string",
              "pattern": "^.+\\.ya?ml$"
            },
            "job": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
